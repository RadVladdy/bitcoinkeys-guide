/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' wss:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'; upgrade-insecure-requests

# NIP-05 discovery must stay cross-origin readable for Nostr clients.
/.well-known/nostr.json
  Access-Control-Allow-Origin: *

# PDFs ARE MUTABLE CONTENT AT A FIXED FILENAME, which is the one combination a
# long browser cache handles badly. The default here was max-age=14400 — four
# hours during which a reader who had already opened one kept seeing the old
# copy no matter what the CDN held, and no way for them to tell. It looked
# exactly like a deploy that had not worked.
#
# max-age=0 + must-revalidate does NOT mean "download it every time": the
# browser sends the ETag and gets a 304 with no body when nothing changed. It
# costs one round trip and it means an updated worksheet is the one you get.
#
# These are printed and followed while handling seed words. A reader working
# from a superseded procedure is the failure worth spending a round trip on.
# LISTED ONE BY ONE, not as /*.pdf — Cloudflare Pages did not match the suffix
# glob and silently kept serving the four-hour header, which is the same class
# of failure as the thing it is fixing: a rule that looks applied and is not.
#
# ⚠️ AND THE ONE-BY-ONE LISTING DOES NOT WORK EITHER — measured 2026-08-05
# against the live response, which is the only thing that settles it. The apex
# answers `public, max-age=14400, must-revalidate` for every one of these files.
# So Pages takes the DIRECTIVE we add and OVERRIDES the max-age we ask for, and
# `must-revalidate` only forbids serving a response that has already gone stale
# — it does nothing at all for the first four hours, which is the entire window
# this block was written to close.
#
# THE RULES BELOW ARE THEREFORE NOT LOAD-BEARING AND THIS FILE HAS NEVER SAID
# SO. `?v=<content hash>` on every link (src/data/pdf-version.js) is the whole
# mechanism: it makes a changed file a different URL, which no cache header can
# undo. This block is kept because a directive that does land costs nothing and
# helps once the four hours are up — but do not add a fifth attempt here, and do
# not read these lines as the reason a reader gets the current PDF.
# (The note in pdf-version.js said `_headers` is ignored outright; this one said
# listing files fixed it. Both were half right, on one subject, each internally
# consistent — and each was written from a different deploy. Corrected together.)
/dice-word-table.pdf
  Cache-Control: public, max-age=0, must-revalidate
/bip39-word-table.pdf
  Cache-Control: public, max-age=0, must-revalidate
/roll-12-word-seed.pdf
  Cache-Control: public, max-age=0, must-revalidate
/roll-24-word-seed.pdf
  Cache-Control: public, max-age=0, must-revalidate
/checklist-single-sig.pdf
  Cache-Control: public, max-age=0, must-revalidate
/checklist-passphrase.pdf
  Cache-Control: public, max-age=0, must-revalidate
/checklist-multisig.pdf
  Cache-Control: public, max-age=0, must-revalidate
/checklist-collaborative.pdf
  Cache-Control: public, max-age=0, must-revalidate
