---
import { navGroups } from '../data/nav.js';
import { levels } from '../data/curriculum.js';
const year = 2026;

// The cause of the old layout was structural, not cosmetic: it listed all 17 lessons plus 5 level
// headers in a column sized 1.7fr of `1.7fr 1fr 1fr 1fr`, beside three columns
// holding three links each. One column carried 30 items and three carried three, so
// Learn was crushed into sub-columns barely wide enough for two words ("Beyond the
// ladder — BIP-85 and Shamir" wrapped to four lines) while ~1,000px of the pledge
// column sat empty. Desktop 1,300px tall; mobile 2,000px with a stranded column.
//
// The footer was trying to be a second copy of the mega-menu. It doesn't need to be:
// the nav links all 17 lessons from EVERY page (verified before cutting), so nothing
// here is a last path to anything. It now lists the five LEVELS, anchored into the
// /start syllabus, which already carries an id per level.
//
// Five balanced columns of 3–6 items. Reference (glossary, further reading) gets its
// own column rather than hiding under Learn — those are the `ref: true` links in
// nav.js, where they still belong in the MENU. Same data, different job.
const learn = navGroups.find((g) => g.mega);
const others = navGroups.filter((g) => !g.mega);
const reference = (learn?.links || []).filter((l) => l.ref);
---
<footer class="foot">
  <div class="wrap foot-inner">
    <div class="pledge">
      <p class="pledge-line"><span class="accent-text">We hold no keys and sell no device.</span></p>
      <p class="sub">BitcoinKeys.guide is an independent, Bitcoin-only guide to holding your own coins. No affiliate hardware brand, no custody service, nothing to sell you — just the simplest setup that fits you, and how to build it.</p>
    </div>
    <nav class="foot-map" aria-label="Footer">
      <div class="foot-col">
        <p class="foot-col-title">{learn.title}</p>
        {learn.lead && <a href={learn.lead.href}>{learn.lead.pin}</a>}
        {levels.map((lv) => (
          <a href={`/start#${lv.id}`}><span class="foot-lvn mono">{lv.id}</span> {lv.title}</a>
        ))}
      </div>
      {others.map((g) => (
        <div class="foot-col">
          <p class="foot-col-title">{g.title}</p>
          {g.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      ))}
      {reference.length > 0 && (
        <div class="foot-col">
          <p class="foot-col-title">Reference</p>
          {reference.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      )}
    </nav>
  </div>
  <div class="wrap foot-base">
    <span>A RadVladdy project · © {year}</span>
    <nav class="foot-sisters" aria-label="Sister projects">
      <span class="sis-label">Sister projects</span>
      <a href="https://bitcoineconomy.ai" rel="noopener">bitcoineconomy.ai</a>
      <a href="https://timechain.wiki" rel="noopener">timechain.wiki</a>
    </nav>
    <span class="mono sub">Verify. Don't trust.</span>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--line-soft); background: var(--surface-2); margin-top: 2rem; }
  .foot-inner { display: block; padding: 2.6rem 1.4rem 1.6rem; }
  .pledge { max-width: 64ch; margin-bottom: 2.2rem; }
  .pledge-line { font-size: 1.05rem; font-weight: 700; margin: 0 0 0.5rem; }
  .pledge .sub { margin: 0; font-size: 0.92rem; }
  .foot-map { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.6rem 1.2rem; }
  .foot-col { display: flex; flex-direction: column; gap: 0.5rem; }
  .foot-col-title { margin: 0 0 0.15rem; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--faint); }
  .foot-lvn { color: var(--accent); font-size: 0.72rem; }
  /* padding-block + matching negative margin: a finger-sized hit area on phones
     without changing the column's visual rhythm. */
  .foot-col a { color: var(--muted); text-decoration: none; font-size: 0.9rem;
    padding-block: 0.35rem; margin-block: -0.35rem; }
  .foot-col a:hover { color: var(--accent); }
  .foot-base { display: flex; align-items: center; justify-content: space-between; gap: 1rem 1.4rem; flex-wrap: wrap;
    padding: 1.2rem 1.4rem 1.8rem; border-top: 1px solid var(--line-soft); color: var(--faint); font-size: 0.82rem; }
  .foot-sisters { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem 0.9rem; }
  .foot-sisters .sis-label { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--faint); }
  .foot-sisters a { color: var(--muted); text-decoration: none; display: inline-block;
    padding-block: 0.35rem; margin-block: -0.35rem; }
  .foot-sisters a:hover { color: var(--accent); }
  @media (max-width: 900px) { .foot-map { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .foot-map { grid-template-columns: 1fr 1fr; } }
</style>
