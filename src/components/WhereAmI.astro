---
// "Where am I on the ladder" — the self-locator + climb advisor.
//
// MOVED HERE 2026-07-28 (site restructure). This tool used to live on /learn/ladder,
// where it competed with the quiz as a second front door onto the same ladder.
// /learn/ladder is now purely educational, and this became the RE-CHECK tool for someone
// who already has a plan: it lives on /my-plan, downstream of the quiz, for the
// returning holder whose situation changed. The logic is unchanged — same five
// verdict paths, same default-to-"stay put" bias, same auto-save.
//
// Companion to the quiz: the quiz places a newcomer; this re-places someone who
// ALREADY has a setup. It locates their rung, shows what it covers + its weakness,
// then — true to the ladder's rule ("the simplest setup that adequately covers your
// threat model") — DEFAULTS TO "stay put," surfacing the next rung only when a real
// trigger exists. Deep content lives on each rung page; whereami.js holds the
// interaction logic plus the gaps ladder.js doesn't cover.
//
// 🚪 SHOWN ONLY TO A RETURNING READER. "Has your situation changed?" is a question
// about a gap of time, and asking it implies something might have — so it must not
// be put to someone who finished the finder ninety seconds ago. The gate is
// planWasRestored(): a plan that ARRIVED here, by file import or Nostr restore,
// came from another day or another device. A plan built in this browser did not.
//
// Rendered hidden and revealed by the client script, because the gate reads
// localStorage and this page is static. It stays in the DOM either way, so the
// status card's "re-check →" anchor still resolves — that link only appears once a
// ladder rung is saved, which only this tool can do.
---
<section id="whereami" class="whereami" hidden>
  <div class="prose">
    <h2>Has your situation changed?</h2>
    <p class="wa-lead">If it's been a while — or your holdings, your family, or your worries have shifted — re-place yourself. We'll show you what your setup covers, where it's weak, and <strong>honestly, whether you should climb at all.</strong> Most people are already on the right rung. This runs entirely in your browser; where you land is saved to your plan automatically — and nothing is ever sent anywhere.</p>
  </div>
  <div id="wa" aria-live="polite">
    <div id="wa-locate"></div>
    <div id="wa-result" hidden></div>
    <noscript>
      <p class="wa-ns">This tool needs JavaScript. You can place yourself by reading <a href="/learn/ladder">the ladder</a> — or <a href="/learn/ladder#rung-1">start at rung one</a> if you're new.</p>
    </noscript>
  </div>
</section>

<script>
  import { ladder, getRung, rungAnchor } from '../data/ladder.js';
  import { setups, extras, climbQuestions, assess } from '../data/whereami.js';
  import { saveLadderSlice, planWasRestored } from '../data/plan.js';

  const elLocate = document.getElementById('wa-locate');
  const elResult = document.getElementById('wa-result');

  let pickedSlug = null;
  let lastSaveOk = false;
  const answers = {};

  function esc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }

  // Content resolves from ladder.js where it exists, else from whereami extras.
  const content = (slug) => {
    const r = getRung(slug);
    const x = extras[slug] || {};
    return {
      name: r ? r.name : 'Not on the ladder yet',
      short: r ? r.short : 'Not yet',
      step: (setups.find((s) => s.slug === slug) || {}).step,
      tagline: (r && r.tagline) || x.tagline || '',
      protects: (r && r.solves) || x.protects || null,
      weakness: (r && r.introduces) || x.weakness || '',
      whenToClimb: (r && r.whenToClimb) || x.whenToClimb || '',
    };
  };

  // A compact rung strip, current rung highlighted.
  function strip(step) {
    const cells = ladder.map((r) => {
      const cls = r.step === step ? 'here' : r.step < step ? 'below' : 'above';
      return `<span class="wa-rung ${cls}"><span class="wa-n">${r.step}</span>${esc(r.short)}</span>`;
    }).join('<span class="wa-conn"></span>');
    const pre = step === 0 ? `<span class="wa-rung here pre"><span class="wa-n">•</span>Off-ladder</span><span class="wa-conn"></span>` : '';
    return `<div class="wa-strip">${pre}${cells}</div>`;
  }

  function renderLocate() {
    elResult.hidden = true;
    elLocate.hidden = false;
    const opts = setups.map((s) =>
      `<button class="wa-opt" data-slug="${esc(s.slug)}"><span>${esc(s.label)}</span></button>`
    ).join('');
    elLocate.innerHTML = `<div class="wa-card"><h3 class="wa-q">What does your setup look like today?</h3><div class="wa-opts">${opts}</div></div>`;
    elLocate.querySelectorAll('.wa-opt').forEach((b) => {
      b.addEventListener('click', () => {
        pickedSlug = b.getAttribute('data-slug');
        // Auto-save where you are, the moment you pick. saveLadderSlice returns
        // null when the browser blocked the write — then nothing was saved, and
        // neither the toast nor the band below may claim otherwise.
        lastSaveOk = Boolean(saveLadderSlice(pickedSlug));
        if (lastSaveOk) {
          toast('✓ Saved to your plan');
          // Tell the host page (my-plan's status card shows "On the ladder: …")
          // so it re-renders now rather than on the next reload.
          window.dispatchEvent(new CustomEvent('bkeys-ladder-change'));
        } else {
          toast('Couldn’t save — your browser is blocking storage');
        }
        renderResult();
      });
    });
  }

  function verdictHtml(slug) {
    const c = content(slug);
    const { verdict, triggers } = assess(slug, answers);

    if (verdict === 'start') {
      return `<div class="wa-vcard start">
        <p class="wa-vk mono">The move</p>
        <h3>Get on the ladder — start at rung 1.</h3>
        <p>Bitcoin you don’t hold the keys to isn’t really yours. The first and biggest step is single-sig: your own hardware wallet, your own seed backup. Everything else on this ladder is a refinement of that.</p>
        <div class="wa-links">
          <a class="btn-primary" href="/learn/ladder#rung-1">Read the rung-1 section →</a>
          <a class="btn-ghost" href="/checklist">Walk me through it →</a>
        </div></div>`;
    }
    if (verdict === 'stay') {
      return `<div class="wa-vcard stay">
        <p class="wa-vk mono">Verdict</p>
        <h3>Stay right where you are.</h3>
        <p><strong>${esc(c.name)}</strong> adequately covers what you’ve described. The single most common way people lose Bitcoin in self-custody is taking on complexity they don’t need — so staying put isn’t timidity, it’s the correct move. Come back and re-check when something real changes.</p>
        <div class="wa-links"><a class="btn-ghost" href="${rungAnchor(slug)}">Re-read this rung →</a></div></div>`;
    }
    // consider
    const trigList = triggers.map((t) => `<li>${esc(t)}</li>`).join('');
    return `<div class="wa-vcard consider">
      <p class="wa-vk mono">Worth a look</p>
      <h3>One reason to consider the next step.</h3>
      <p>Most of your setup is sound — but here’s what stood out:</p>
      <ul class="wa-trigs">${trigList}</ul>
      <div class="wa-climb"><span class="wa-vk mono">Where you’d go</span><p>${c.whenToClimb}</p></div>
      <p class="wa-hedge">This isn’t a push to climb. If none of the above is actually pressing for you, staying on <strong>${esc(c.name)}</strong> is still the right call — a higher rung you don’t fully control is its own risk.</p>
      <div class="wa-links"><a class="btn-ghost" href="${rungAnchor(slug)}">Re-read this rung →</a></div></div>`;
  }

  function renderResult() {
    for (const k in answers) delete answers[k];   // fresh diagnostics per pick
    elLocate.hidden = true;
    elResult.hidden = false;
    const c = content(pickedSlug);
    const qs = climbQuestions(pickedSlug);

    const whereCard = `<div class="wa-here">
      ${strip(c.step)}
      <div class="wa-here-body">
        <p class="wa-vk mono">You’re here</p>
        <h3>${esc(c.name)}</h3>
        ${c.tagline ? `<p class="wa-tag">${esc(c.tagline)}</p>` : ''}
        ${c.protects ? `<p class="wa-line"><span class="wa-good">Covers</span> ${esc(c.protects)}</p>` : ''}
        <p class="wa-line"><span class="wa-warn">Weak spot</span> ${esc(c.weakness)}</p>
      </div></div>`;

    // pre + rung 6 skip diagnostics → straight to verdict
    if (!qs.length) {
      elResult.innerHTML = `${whereCard}${verdictHtml(pickedSlug)}${saveBandHtml()}${restartHtml()}`;
      wireRestart();
      elResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return;
    }

    const qHtml = qs.map((q) => `
      <div class="wa-drow" data-qid="${esc(q.id)}">
        <p class="wa-dq">${esc(q.q)}</p>
        <div class="wa-yn">
          ${q.options.map((o) => `<button class="wa-yn-b" data-qid="${esc(q.id)}" data-val="${esc(o)}">${esc(o)}</button>`).join('')}
        </div>
      </div>`).join('');

    elResult.innerHTML = `${whereCard}
      <div class="wa-diag">
        <p class="wa-vk mono">Should you climb? Three honest questions.</p>
        ${qHtml}
        <button class="btn-primary wa-see" id="wa-see" disabled>See where I stand →</button>
      </div>
      <div id="wa-verdict"></div>
      ${restartHtml()}`;

    elResult.querySelectorAll('.wa-yn-b').forEach((btn) => {
      btn.addEventListener('click', () => {
        const qid = btn.getAttribute('data-qid');
        answers[qid] = btn.getAttribute('data-val');
        elResult.querySelectorAll(`.wa-yn-b[data-qid="${qid}"]`).forEach((b) => b.classList.toggle('sel', b === btn));
        const seeBtn = document.getElementById('wa-see');
        seeBtn.disabled = qs.some((q) => !(q.id in answers));
      });
    });
    document.getElementById('wa-see').addEventListener('click', () => {
      document.getElementById('wa-verdict').innerHTML = verdictHtml(pickedSlug) + saveBandHtml();
      document.getElementById('wa-verdict').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    wireRestart();
    elResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Where you are is auto-saved on pick (above) — this band confirms what actually
  // happened, including the case where the browser refused the write.
  const saveBandHtml = () => lastSaveOk
    ? `<div class="wa-save" id="wa-save">
        <span class="wa-saved">✓ Saved to your plan — you're on ${esc(content(pickedSlug).name)}.</span>
        <a class="wa-saved-link" href="/checklist">See your checklist →</a>
      </div>`
    : `<div class="wa-save" id="wa-save">
        <span class="wa-save-note">Couldn’t save to your plan — your browser is blocking storage. The verdict above still stands; it just won’t be here when you come back.</span>
      </div>`;

  function toast(msg) {
    const t = document.createElement('div');
    t.className = 'wa-toast'; t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 1800);
  }

  const restartHtml = () => `<button class="wa-restart" id="wa-restart">← Start over</button>`;
  function wireRestart() {
    const b = document.getElementById('wa-restart');
    if (b) b.addEventListener('click', () => { pickedSlug = null; renderLocate(); document.getElementById('whereami').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
  }

  // THE GATE. A plan that arrived here — imported from a file, restored from Nostr —
  // came from another day or another device, and "has your situation changed?" is a
  // fair question to ask its owner. A plan built in this browser is minutes old, and
  // it is not. See planWasRestored() in plan.js for why this is not an age test.
  //
  // Nothing below runs for anyone else: the tool is never built, so it costs a
  // hidden <section> and one localStorage read.
  const gate = document.getElementById('whereami');
  let built = false;
  function openGate() {
    if (built || !planWasRestored()) return;
    built = true;
    gate.hidden = false;
    renderLocate();
  }
  openGate();
  // An import or a Nostr restore ON THIS PAGE makes the reader a returning one
  // mid-visit, and the gate has already run by then. Without this the tool only
  // appeared on the next reload — the same class of bug as the status card's
  // ladder line, which is why that one already listens for its own event.
  window.addEventListener('bkeys-plan-restored', openGate);
</script>

<style>
  /* [hidden] is spelled out because an author `display:` silently overrides the UA
     rule — that is how an empty box shipped to every first-time visitor on two
     pages (2026-07-30). No `display` is set on .whereami today; this keeps it true. */
  .whereami[hidden] { display: none; }
  .whereami { margin-top: 2.2rem; }
  .wa-lead { color: var(--muted); max-width: 46rem; }
  .wa-ns { color: var(--muted); }
  .wa-toast { position: fixed; left: 50%; bottom: 1.6rem; transform: translateX(-50%) translateY(1rem);
    background: var(--surface-2); color: var(--text); border: 1px solid var(--safe); border-radius: 0.6rem;
    padding: 0.6rem 1.05rem; font-size: 0.9rem; box-shadow: var(--shadow); opacity: 0; z-index: 50;
    transition: opacity 0.25s, transform 0.25s; }
  .wa-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>

<style is:global>
  /* The tool's cards/questions are injected by client JS (no scoped attribute), so these are global, namespaced under #wa to avoid leaking. */
  #wa { margin-top: 1.4rem; max-width: 46rem; }
  #wa .wa-card { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-2); padding: 1.5rem; box-shadow: var(--shadow); }
  #wa .wa-q { margin: 0 0 1rem; font-size: 1.2rem; }
  #wa .wa-opts { display: grid; gap: 0.55rem; }
  #wa .wa-opt { text-align: left; width: 100%; font-family: var(--sans); font-size: 0.98rem; color: var(--text); cursor: pointer;
    background: var(--raise); border: 1px solid var(--line); border-radius: 0.6rem; padding: 0.85rem 1.05rem; transition: border-color 0.15s, background 0.15s; }
  #wa .wa-opt:hover { border-color: var(--accent); background: var(--accent-soft); }

  /* "You're here" card + rung strip */
  #wa .wa-here { border: 1px solid var(--accent); border-radius: var(--radius); background: var(--surface-2); padding: 1.4rem 1.5rem; box-shadow: var(--shadow); }
  #wa .wa-strip { display: flex; align-items: stretch; flex-wrap: wrap; gap: 0; margin-bottom: 1.2rem; }
  #wa .wa-rung { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.74rem; color: var(--faint);
    border: 1px solid var(--line); border-radius: 2rem; padding: 0.25rem 0.6rem; background: var(--raise); white-space: nowrap; }
  #wa .wa-rung .wa-n { font-family: var(--mono); font-weight: 700; opacity: 0.7; }
  #wa .wa-rung.below { color: var(--muted); border-color: color-mix(in srgb, var(--safe) 30%, var(--line)); }
  #wa .wa-rung.above { opacity: 0.5; }
  #wa .wa-rung.here { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); font-weight: 650; }
  #wa .wa-rung.here .wa-n { opacity: 0.85; }
  #wa .wa-conn { flex: 0 0 0.5rem; align-self: center; height: 1px; background: var(--line); }
  #wa .wa-here-body .wa-vk, #wa .wa-diag .wa-vk, #wa .wa-vcard .wa-vk { display: block; color: var(--faint); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.35rem; }
  #wa .wa-here-body h3 { margin: 0 0 0.4rem; font-size: 1.3rem; }
  #wa .wa-tag { color: var(--muted); font-size: 0.95rem; margin: 0 0 0.9rem; }
  #wa .wa-line { margin: 0.35rem 0; font-size: 0.92rem; color: var(--text); }
  #wa .wa-good, #wa .wa-warn { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.1rem 0.4rem; border-radius: 0.3rem; margin-right: 0.45rem; }
  #wa .wa-good { color: var(--safe); background: var(--safe-dim); }
  #wa .wa-warn { color: var(--warn); background: var(--warn-dim); }

  /* diagnostics */
  #wa .wa-diag { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1.4rem 1.5rem; margin-top: 1rem; }
  #wa .wa-drow { padding: 0.9rem 0; border-top: 1px solid var(--line-soft); }
  #wa .wa-drow:first-of-type { border-top: none; padding-top: 0.4rem; }
  #wa .wa-dq { margin: 0 0 0.6rem; font-size: 0.95rem; color: var(--text); }
  #wa .wa-yn { display: flex; gap: 0.5rem; }
  #wa .wa-yn-b { font-family: var(--sans); font-size: 0.9rem; color: var(--text); cursor: pointer; min-width: 4.5rem;
    background: var(--raise); border: 1px solid var(--line); border-radius: 0.5rem; padding: 0.5rem 1rem; transition: border-color 0.15s, background 0.15s, color 0.15s; }
  #wa .wa-yn-b:hover { border-color: var(--accent); }
  #wa .wa-yn-b.sel { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
  #wa .wa-see { margin-top: 1.1rem; }
  #wa .btn-primary { background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: 0.95rem; text-decoration: none; padding: 0.7rem 1.2rem; border-radius: 0.55rem; display: inline-block; border: none; cursor: pointer; font-family: var(--sans); }
  #wa .btn-primary:hover { opacity: 0.9; }
  #wa .btn-primary[disabled] { opacity: 0.4; cursor: not-allowed; }
  #wa .btn-ghost { background: none; border: 1px solid var(--line); color: var(--muted); font-family: var(--sans); font-size: 0.9rem; cursor: pointer; padding: 0.68rem 1.1rem; border-radius: 0.55rem; text-decoration: none; display: inline-block; }
  #wa .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* verdict cards */
  #wa .wa-vcard { border-radius: var(--radius); padding: 1.5rem; margin-top: 1rem; border: 1px solid var(--line); background: var(--surface-2); box-shadow: var(--shadow); }
  #wa .wa-vcard h3 { margin: 0 0 0.7rem; font-size: 1.35rem; line-height: 1.2; }
  #wa .wa-vcard p { margin: 0 0 0.8rem; color: var(--text); }
  #wa .wa-vcard.stay { border-color: var(--safe); border-left: 4px solid var(--safe); }
  #wa .wa-vcard.stay .wa-vk { color: var(--safe); }
  #wa .wa-vcard.consider { border-color: var(--warn); border-left: 4px solid var(--warn); }
  #wa .wa-vcard.consider .wa-vk { color: var(--warn); }
  #wa .wa-vcard.start { border-color: var(--accent); border-left: 4px solid var(--accent); }
  #wa .wa-vcard.start .wa-vk { color: var(--accent); }
  #wa .wa-vcard.top { border-color: var(--accent); border-left: 4px solid var(--accent); }
  #wa .wa-vcard.top .wa-vk { color: var(--accent); }
  #wa .wa-trigs { margin: 0 0 1rem; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  #wa .wa-trigs li { color: var(--text); font-size: 0.94rem; }
  #wa .wa-climb { border-top: 1px solid var(--line-soft); padding-top: 0.9rem; margin-bottom: 0.9rem; }
  #wa .wa-climb p { margin: 0; color: var(--muted); font-size: 0.94rem; }
  #wa .wa-climb a, #wa .wa-vcard.top p a { color: var(--accent); text-decoration: none; }
  #wa .wa-climb a:hover { text-decoration: underline; }
  #wa .wa-hedge { font-size: 0.9rem; color: var(--muted); }
  #wa .wa-links { display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: center; margin-top: 0.4rem; }
  #wa .wa-save { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; margin-top: 1rem; }
  #wa .wa-save-b { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-dim); font-family: var(--sans); font-weight: 600; font-size: 0.9rem; cursor: pointer; padding: 0.6rem 1rem; border-radius: 0.55rem; }
  #wa .wa-save-b:hover { border-color: var(--accent); }
  #wa .wa-save-note { color: var(--faint); font-size: 0.8rem; }
  #wa .wa-save-note a, #wa .wa-saved-link { color: var(--accent); text-decoration: none; }
  #wa .wa-save-note a:hover, #wa .wa-saved-link:hover { text-decoration: underline; }
  #wa .wa-saved { color: var(--safe); font-weight: 600; font-size: 0.92rem; }
  #wa .wa-restart { display: block; margin: 1.2rem 0 0; background: none; border: none; color: var(--muted); font-size: 0.88rem; cursor: pointer; padding: 0; font-family: var(--sans); }
  #wa .wa-restart:hover { color: var(--accent); }
</style>
