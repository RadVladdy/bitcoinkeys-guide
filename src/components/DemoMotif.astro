---
// A tiny line-art glyph per deep-dive demo, so a card SHOWS its mechanic rather
// than only naming it — a card should demonstrate what the demo does.
//
// Rules these follow, all of them load-bearing on this site:
//   · Inline SVG only — no external asset, no request, nothing to block or leak.
//   · Coloured with the site's own tokens (--accent / --safe / --line / --faint),
//     never hard-coded hex, so both themes work with no per-theme override. The
//     device photos on /wallets need an invert() filter precisely because they are
//     raster line-art; these don't, because they are drawn in the theme's colours.
//   · aria-hidden: the card's title and description carry the meaning. A glyph
//     that needs alt text is a glyph that failed.
//   · Purely decorative — no data is plotted and no number is encoded, so nothing
//     here can drift from a data file.
//
// `motif` is a key on the demo in deepdives.js, not the slug, so a demo can be
// renamed or re-homed without stranding its artwork.
const { motif } = Astro.props;
---
<span class="motif" aria-hidden="true">
  {motif === 'seed' && (
    /* 128 random bits → twelve words → an address. The three stages of the demo. */
    <svg viewBox="0 0 148 52" role="presentation">
      <g class="bits">
        {[0, 1, 2, 3].map((r) => [0, 1, 2, 3].map((c) => (
          <rect x={4 + c * 8} y={10 + r * 8} width="5.5" height="5.5" rx="1"
            class:list={[(r * 4 + c) % 3 === 0 ? 'on' : 'off']} />
        )))}
      </g>
      <path class="arrow" d="M42 26 h10 m-3.5 -3.5 l3.5 3.5 l-3.5 3.5" />
      <g class="words">
        {[0, 1, 2].map((i) => <rect x="58" y={10 + i * 11} width="30" height="7.5" rx="2.2" />)}
      </g>
      <path class="arrow" d="M94 26 h10 m-3.5 -3.5 l3.5 3.5 l-3.5 3.5" />
      <rect class="addr" x="110" y="18" width="34" height="16" rx="8" />
      <circle class="addr-dot" cx="127" cy="26" r="3.2" />
    </svg>
  )}

  {motif === 'multisig' && (
    /* Three keys, any two spend. Two lit, one dark — the threshold, drawn. */
    <svg viewBox="0 0 148 52" role="presentation">
      {[0, 1, 2].map((i) => (
        <g class:list={['key', i < 2 ? 'lit' : 'dim']} transform={`translate(${16 + i * 44} 12)`}>
          <circle cx="9" cy="9" r="7.5" />
          <path d="M9 16.5 v10 m0 -6 h5 m-5 4 h3.5" />
        </g>
      ))}
      <path class="brace" d="M14 42 v3 h74 v-3" />
      <text class="cap" x="51" y="51" text-anchor="middle">2 of 3</text>
    </svg>
  )}

  {motif === 'dice' && (
    /* A die, rolled by hand, hashed into entropy you generated yourself. */
    <svg viewBox="0 0 148 52" role="presentation">
      <rect class="die" x="10" y="12" width="28" height="28" rx="6" />
      {[[18, 20], [30, 20], [18, 32], [30, 32], [24, 26]].map(([cx, cy]) => (
        <circle class="pip" cx={cx} cy={cy} r="2.4" />
      ))}
      <path class="arrow" d="M46 26 h12 m-4 -4 l4 4 l-4 4" />
      <g class="hash">
        {[14, 26, 9, 31, 18, 24, 12, 28].map((h, i) => (
          <rect x={66 + i * 10} y={38 - h} width="6" height={h} rx="1.6" />
        ))}
      </g>
    </svg>
  )}

  {motif === 'key-space' && (
    /* One key in 2^256. A field of possibilities, exactly one of them yours. */
    <svg viewBox="0 0 148 52" role="presentation">
      <g class="field">
        {Array.from({ length: 5 }, (_, r) => Array.from({ length: 17 }, (_, c) => (
          <circle cx={8 + c * 8.2} cy={10 + r * 8} r="1.7"
            class:list={[r === 2 && c === 11 ? 'one' : 'many']} />
        )))}
      </g>
      <circle class="ring" cx={8 + 11 * 8.2} cy={10 + 2 * 8} r="6" />
    </svg>
  )}
</span>

<style>
  .motif { display: block; }
  .motif svg { display: block; width: 100%; height: auto; }

  /* Shared line language — thin strokes, round caps, the site's own tokens. */
  .motif :global(path), .motif :global(circle), .motif :global(rect) {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arrow { stroke: var(--faint); stroke-width: 1.4; fill: none; }
  .cap { fill: var(--faint); font-family: var(--mono); font-size: 8px; letter-spacing: 0.06em; }

  /* seed */
  .bits rect { stroke: none; }
  .bits .on { fill: var(--accent); }
  .bits .off { fill: var(--line); }
  .words rect { fill: none; stroke: var(--line); stroke-width: 1.3; }
  .words rect:first-child { stroke: var(--accent); }
  .addr { fill: none; stroke: var(--safe); stroke-width: 1.4; }
  .addr-dot { fill: var(--safe); stroke: none; }

  /* multisig */
  .key circle, .key path { fill: none; stroke-width: 1.6; }
  .key.lit circle, .key.lit path { stroke: var(--accent); }
  .key.dim circle, .key.dim path { stroke: var(--faint); opacity: 0.7; }
  .brace { fill: none; stroke: var(--accent); stroke-width: 1.3; }

  /* dice */
  .die { fill: none; stroke: var(--accent); stroke-width: 1.6; }
  .pip { fill: var(--accent); stroke: none; }
  .hash rect { fill: var(--line); stroke: none; }
  .hash rect:nth-child(2n) { fill: var(--accent); opacity: 0.55; }

  /* key-space */
  .field .many { fill: var(--faint); opacity: 0.45; stroke: none; }
  .field .one { fill: var(--accent); stroke: none; }
  .ring { fill: none; stroke: var(--accent); stroke-width: 1.2; opacity: 0.75; }

  /* The glyph is decoration; if someone has asked for less motion or is printing,
     it still reads as flat line-art. Nothing here animates, by design — a card
     that moves competes with the demo it is advertising. */
</style>
