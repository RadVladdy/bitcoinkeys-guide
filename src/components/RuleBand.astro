---
// The rule (or rules) a lesson exists to teach, shown at the top of that lesson.
//
// This is the visible half of the 2026-07-29 restructure: every lesson from 101
// onward opens by naming the numbered rule it exists to teach.
//
// The band is a REMINDER, not a destination. Two things were removed:
//
//   1. THE BACK-LINK. The band used to be an <a> to /learn/rules#rule-N. That was
//      built as the counterweight to the old /principles page, which pushed readers
//      FORWARD out of the sequence — so pulling them back felt like the fix. But a
//      reminder is not a destination: the reader met the rules as lesson 1 and does
//      not need to be sent back to re-read one they are about to spend a whole
//      lesson on. The band is inert: it displays the rule, and nothing more.
//      (`<RuleRef>` in prose still links — that is a CITATION mid-argument, where a
//      reader genuinely might want to check the source. Different job.)
//
//   2. THE FOOTER. "This is rule 08 of the twelve. This lesson is that rule in full."
//      restated, in a full sentence, what the eyebrow and the number already said.
//      The eyebrow now carries it: RULE 08, then the rule. Nothing else.
//
// The `rb-n` class stays — the spine's rules-chain check finds placed rules by it.
//
// Lessons that own no rule (the rules page itself, plus the concept lessons —
// bitcoin-keys, beyond-the-ladder, generate-your-seed) render nothing rather
// than inventing a number.
// `href` is accepted explicitly so dynamic routes can pass their own path rather
// than relying on Astro.url inside a [slug] page; static pages can just omit it.
import { rulesFor } from '../data/rules.js';
const { href } = Astro.props;
const mine = rulesFor(href ?? Astro.url.pathname);
---
{mine.length > 0 && (
  <aside class="ruleband" aria-label={mine.length > 1 ? 'The rules this lesson teaches' : 'The rule this lesson teaches'}>
    {mine.map((r) => (
      <div class="rb-row">
        <p class="rb-k mono">
          Rule <span class="rb-n">{String(r.n).padStart(2, '0')}</span>
          {r.isPartTwo && <span class="rb-part"> · part two</span>}
        </p>
        <p class="rb-t">{r.rule}</p>
      </div>
    ))}
  </aside>
)}

<style>
  .ruleband { border: 1px solid var(--line); border-left: 3px solid var(--accent);
    border-radius: var(--radius); background: var(--surface); padding: 1.05rem 1.3rem;
    margin: 0 0 1.8rem; display: flex; flex-direction: column; gap: 1rem; }
  .rb-row { display: block; }
  .rb-k { margin: 0 0 0.3rem; color: var(--accent); font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; }
  .rb-n { font-weight: 800; }
  .rb-part { color: var(--faint); font-weight: 600; }
  /* The rule is the loudest thing in the band — it outranks the surrounding body
     copy rather than matching it — sized to read as a statement.
     Kept in step with the rules page's own list (.r-body h2) so the same sentence
     is the same size wherever the guide states a rule. */
  .rb-t { margin: 0; color: var(--text); font-weight: 650; font-size: 1.18rem; line-height: 1.38; }

  @media (max-width: 640px) {
    .rb-t { font-size: 1.08rem; }
  }
</style>
