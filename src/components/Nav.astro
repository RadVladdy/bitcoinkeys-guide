---
import { navGroups } from '../data/nav.js';
import { levels } from '../data/curriculum.js';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => path === href || path.startsWith(href + '/');
// A mega group is "active" when the current page is any of its lessons, its
// lead-in, or one of its reference pages — the curriculum is its real contents.
const megaLinks = [...levels.flatMap((lv) => lv.lessons.map((l) => l.href)), '/start', '/learn'];
const groupActive = (g) =>
  g.links.some((l) => isActive(l.href)) || (g.mega && megaLinks.some((h) => isActive(h)));
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="BitcoinKeys.guide home">
      <img class="mark mark-light" src="/brand/mark-light.png?v=2" alt="" aria-hidden="true" />
      <img class="mark mark-dark" src="/brand/mark-dark.png?v=2" alt="" aria-hidden="true" />
      <span>BitcoinKeys<span class="accent-text">.guide</span></span>
    </a>
    <!-- Desktop: the four sections are the top-level menu; each opens a dropdown -->
    <nav class="sections" aria-label="Primary">
      {navGroups.map((g) => (
        <div class:list={['section', { 'has-mega': g.mega }]}>
          <button class="section-btn" type="button" aria-expanded="false" class:list={['section-btn', { on: groupActive(g) }]}>
            {g.title}
            <svg class="chev" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          {g.mega ? (
            <div class="mega-panel">
              <div class="wrap mega-inner">
                <div class="lv-grid">
                  {levels.map((lv) => (
                    <div class:list={['lv', { opt: lv.optional }]}>
                      <p class="lv-h"><span class="lv-n">{lv.id}</span><span class="lv-t">{lv.title}</span></p>
                      {lv.lessons.map((l) => (
                        <a href={l.href} class:list={['lv-link', { active: isActive(l.href) }]}>
                          {l.label}
                          {l.note && <span class="lv-note">{l.note}</span>}
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
                <div class="mega-foot">
                  {g.lead && (
                    <a href={g.lead.href} class="mf-lead">
                      <span class="pin">{g.lead.pin}</span>{g.lead.label}
                    </a>
                  )}
                  <span class="mf-ref">
                    <span class="mf-lbl">Reference</span>
                    {g.links.map((l) => (
                      <a href={l.href} class:list={[{ active: isActive(l.href) }]}>{l.label}</a>
                    ))}
                  </span>
                </div>
              </div>
            </div>
          ) : (
            <div class="section-panel">
              {g.links.map((l, i) => (
                <Fragment>
                  {l.ref && !g.links[i - 1]?.ref && <span class="section-div">Reference</span>}
                  <a href={l.href} class:list={['section-link', { active: isActive(l.href) }]}>{l.label}</a>
                </Fragment>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
    <div class="nav-right">
      <div class="nostr-auth" id="nostr-auth">
        <button id="nostr-login" class="nostr-login" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Sign in"></button>
        <div id="nostr-menu" class="nostr-menu" role="menu" hidden></div>
      </div>
      <button id="theme-toggle" class="toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button id="menu-btn" class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
        <svg class="i-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="i-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
  <!-- Mobile only: the hamburger opens the same groups as a stacked list -->
  <nav class="site-menu" id="site-menu" aria-label="All pages">
    {navGroups.map((g) => (
      <div class="mm-group">
        <p class="mm-title">{g.title}</p>
        {/* A mega group has no flat link list — its body is the curriculum, which
            becomes level headings here. Same lessons, same order, one scroll. */}
        {g.mega && (
          <Fragment>
            {g.lead && <a href={g.lead.href} class:list={['mm-link', { active: isActive(g.lead.href) }]}>{g.lead.pin} — {g.lead.label}</a>}
            {levels.map((lv) => (
              <Fragment>
                <p class:list={['mm-lv', { opt: lv.optional }]}>
                  <span class="n">{lv.id}</span><span class="t">{lv.title}{lv.optional ? ' · optional' : ''}</span>
                </p>
                {lv.lessons.map((l) => (
                  <a href={l.href} class:list={['mm-link', { active: isActive(l.href) }]}>{l.label}</a>
                ))}
              </Fragment>
            ))}
          </Fragment>
        )}
        {g.links.map((l, i) => (
          <Fragment>
            {l.ref && !g.links[i - 1]?.ref && <p class="mm-div">Reference</p>}
            <a href={l.href} class:list={['mm-link', { active: isActive(l.href) }]}>{l.label}</a>
          </Fragment>
        ))}
      </div>
    ))}
  </nav>
</header>

<!-- Top-right sign-in control. Always visible: a "sign in" affordance when logged
     out, the user's avatar when logged in. Click → a small menu (sign-in options /
     open-my-plan + sign-out). Reads the browser-only session (nostr-session.js); the
     real profile photo needs img-src https: in the CSP (public/_headers). -->
<script>
  import { getSession, clearSession, NOSTR_CHANGE_EVENT } from '../data/nostr-session.js';
  const btn = document.getElementById('nostr-login');
  const menu = document.getElementById('nostr-menu');
  const wrap = document.getElementById('nostr-auth');
  if (btn && menu && wrap) {
    const esc = (s) => { const d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; };
    const shortNpub = (n) => n ? n.slice(0, 10) + '…' + n.slice(-4) : '';
    const personSvg = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20.5a8 8 0 0 1 16 0"/></svg>';

    function paintButton() {
      const s = getSession();
      if (!s) {
        btn.classList.remove('on');
        btn.title = 'Sign in to save your plan';
        btn.setAttribute('aria-label', 'Sign in');
        btn.innerHTML = personSvg;
        return;
      }
      const label = s.name || shortNpub(s.npub) || 'your key';
      btn.classList.add('on');
      btn.title = 'Signed in as ' + label;
      btn.setAttribute('aria-label', 'Account — signed in as ' + label);
      const initial = (s.name || (s.npub || 'N').replace(/^npub1/, '') || 'N').slice(0, 1).toUpperCase();
      btn.innerHTML = '<span class="nl-fallback">' + esc(initial) + '</span>';
      if (s.picture) {
        const img = document.createElement('img');
        img.alt = ''; img.referrerPolicy = 'no-referrer';
        img.addEventListener('load', () => { btn.innerHTML = ''; btn.appendChild(img); });
        img.src = s.picture;
      }
    }

    function paintMenu() {
      const s = getSession();
      if (!s) {
        menu.innerHTML =
          '<p class="nm-head">Save &amp; sync your plan</p>' +
          '<a class="nm-item" href="/my-plan#connect-nostr" role="menuitem"><span class="nm-ic">🔑</span> Sign in with Nostr</a>' +
          '<p class="nm-note">More sign-in options coming — Pubky.</p>' +
          '<p class="nm-foot">Your plan stays in your browser. Signing in only lets you sync it, encrypted to your own keys — we never see it.</p>';
      } else {
        menu.innerHTML =
          '<p class="nm-id"><span class="nm-npub mono">' + esc(s.name || shortNpub(s.npub)) + '</span>' +
          '<span class="nm-kind mono">signed in via ' + esc(s.kind || 'key') + '</span></p>' +
          '<a class="nm-item" href="/my-plan" role="menuitem"><span class="nm-ic">📋</span> Open my plan</a>' +
          '<button class="nm-item nm-signout" id="nm-signout" type="button" role="menuitem"><span class="nm-ic">↩</span> Sign out</button>';
        const so = document.getElementById('nm-signout');
        if (so) so.addEventListener('click', () => { clearSession(); closeMenu(); });
      }
    }

    function openMenu() { paintMenu(); menu.hidden = false; btn.setAttribute('aria-expanded', 'true'); }
    function closeMenu() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }

    btn.addEventListener('click', (e) => { e.stopPropagation(); menu.hidden ? openMenu() : closeMenu(); });
    document.addEventListener('click', (e) => { if (!wrap.contains(e.target)) closeMenu(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

    const refresh = () => { paintButton(); if (!menu.hidden) paintMenu(); };
    paintButton();
    window.addEventListener(NOSTR_CHANGE_EVENT, refresh);
    window.addEventListener('storage', refresh);   // cross-tab sync
  }
</script>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        if (!cur) cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('bkg-theme', next); } catch (e) {}
      });
    }
    var menuBtn = document.getElementById('menu-btn');
    var menu = document.getElementById('site-menu');
    if (menuBtn && menu) {
      var setOpen = function (open) {
        menu.classList.toggle('open', open);
        menuBtn.setAttribute('aria-expanded', String(open));
      };
      menuBtn.addEventListener('click', function () { setOpen(!menu.classList.contains('open')); });
      menu.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
    }
    // Desktop section dropdowns: click-to-toggle (hover is handled in CSS)
    document.querySelectorAll('.section').forEach(function (sec) {
      var b = sec.querySelector('.section-btn');
      if (!b) return;
      b.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = sec.classList.toggle('open');
        b.setAttribute('aria-expanded', String(open));
        document.querySelectorAll('.section.open').forEach(function (o) { if (o !== sec) { o.classList.remove('open'); var ob = o.querySelector('.section-btn'); if (ob) ob.setAttribute('aria-expanded', 'false'); } });
      });
    });
    document.addEventListener('click', function () {
      document.querySelectorAll('.section.open').forEach(function (o) { o.classList.remove('open'); var ob = o.querySelector('.section-btn'); if (ob) ob.setAttribute('aria-expanded', 'false'); });
    });
  })();
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(140%) blur(10px); border-bottom: 1px solid var(--line-soft); }
  .nav-inner { position: relative; display: flex; align-items: center; gap: 1rem; height: 3.6rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 750; letter-spacing: -0.02em;
    color: var(--text); text-decoration: none; font-size: 1.02rem; }
  .brand .mark { flex: 0 0 auto; height: 26px; width: auto; display: block; }
  .brand .mark-light { display: none; }
  @media (prefers-color-scheme: light) { .brand .mark-light { display: block; } .brand .mark-dark { display: none; } }
  :root[data-theme="dark"] .brand .mark-light { display: none; }
  :root[data-theme="dark"] .brand .mark-dark { display: block; }
  :root[data-theme="light"] .brand .mark-light { display: block; }
  :root[data-theme="light"] .brand .mark-dark { display: none; }

  /* Desktop section menu */
  .sections { display: flex; align-items: center; gap: 0.15rem; margin-left: auto; }
  .section { position: relative; }
  /* A full-bleed panel resolves against .nav (sticky = a containing block), so this
     one must NOT be positioned itself, or it would clamp the panel to button width. */
  .section.has-mega { position: static; }
  .section-btn { display: inline-flex; align-items: center; gap: 0.28rem; cursor: pointer;
    background: none; border: 0; font-family: var(--sans); font-size: 0.92rem; font-weight: 550; color: var(--muted);
    padding: 0.45rem 0.7rem; border-radius: 0.5rem; }
  .section-btn:hover { color: var(--text); background: var(--surface); }
  .section-btn.on { color: var(--accent); }
  .section-btn .chev { opacity: 0.7; transition: transform 0.15s ease; }
  .section:hover .section-btn .chev, .section.open .section-btn .chev { transform: rotate(180deg); }
  .section-panel { position: absolute; top: 100%; left: 0; min-width: 12.5rem; z-index: 30;
    display: none; flex-direction: column; padding: 0.4rem;
    background: var(--bg); border: 1px solid var(--line); border-radius: 0.6rem; box-shadow: var(--shadow); }
  .section:hover .section-panel, .section:focus-within .section-panel, .section.open .section-panel { display: flex; }
  .section-link { display: block; padding: 0.5rem 0.7rem; border-radius: 0.45rem; text-decoration: none;
    color: var(--text); font-size: 0.9rem; white-space: nowrap; }
  .section-link:hover { background: var(--surface); color: var(--accent); }
  .section-link.active { color: var(--accent); }
  /* Splits a dropdown's teaching chapters from its lookup pages (nav.js `ref: true`). */
  .section-div { display: block; margin: 0.4rem 0.7rem 0.15rem; padding-top: 0.4rem;
    border-top: 1px solid var(--line-soft); font-family: var(--mono); font-size: 0.64rem;
    letter-spacing: 0.13em; text-transform: uppercase; color: var(--faint); }

  /* ── The Learn mega-panel: the curriculum, five levels wide ──────────────
     Full-bleed rather than anchored to the button, because it holds every lesson
     on the site — a 12rem dropdown can't. */
  .mega-panel { position: absolute; top: 100%; left: 0; right: 0; z-index: 30; display: none;
    background: var(--bg); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); }
  .section:hover .mega-panel, .section:focus-within .mega-panel, .section.open .mega-panel { display: block; }
  .mega-inner { padding: 1.5rem 1.4rem 1.1rem; }
  .lv-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.4rem 1.3rem; }
  .lv { display: flex; flex-direction: column; gap: 0.05rem; min-width: 0; }
  .lv-h { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.5rem;
    padding-bottom: 0.55rem; border-bottom: 1px solid var(--line); }
  /* A level marker is a FILLED CHIP everywhere else on the site (/start's
     syl-badge, /learn's lvl-n) — the menu was the odd one out. It also fixes an
     inverted hierarchy: the heading used to be smaller AND lighter than the
     lessons inside it, so the container read as less important than its contents. */
  .lv-n { font-family: var(--mono); font-size: 0.76rem; font-weight: 700;
    color: var(--accent-ink); background: var(--accent); border-radius: 0.32rem;
    padding: 0.15rem 0.45rem; letter-spacing: 0.02em; }
  /* 201 is a different KIND of material — optional. The token carries that. */
  .lv.opt .lv-n { background: var(--safe); }
  .lv-t { font-size: 0.9rem; font-weight: 800; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--text); }
  .lv-link { display: block; padding: 0.34rem 0.45rem; margin-left: -0.45rem; border-radius: 0.4rem;
    text-decoration: none; color: var(--text); font-size: 0.84rem; line-height: 1.35; font-weight: 500; }
  .lv-link:hover { background: var(--accent-soft); color: var(--accent); }
  .lv-link.active { color: var(--accent); }
  .lv-note { display: block; color: var(--faint); font-size: 0.72rem; }
  .mega-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.4rem;
    margin-top: 1.2rem; padding-top: 0.9rem; border-top: 1px solid var(--line-soft); }
  .mf-lead { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;
    color: var(--text); font-size: 0.87rem; font-weight: 600; }
  .mf-lead .pin { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--accent-ink); background: var(--accent);
    border-radius: 999px; padding: 0.16rem 0.5rem; }
  .mf-lead:hover { color: var(--accent); }
  .mf-ref { margin-left: auto; display: flex; align-items: center; gap: 0.9rem; font-size: 0.8rem; }
  .mf-lbl { font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--faint); }
  .mf-ref a { color: var(--muted); text-decoration: none; }
  .mf-ref a:hover, .mf-ref a.active { color: var(--accent); }

  /* Five columns need real width; step down before they get cramped. */
  @media (max-width: 1150px) { .lv-grid { grid-template-columns: repeat(3, 1fr); } }

  .nav-right { display: flex; align-items: center; gap: 0.4rem; flex: 0 0 auto; }
  /* The sign-in control's dynamic bits (avatar img, menu contents) are injected by JS,
     so their styles must be global — see the is:global block below. */
  .toggle { display: inline-grid; place-items: center; width: 2.1rem; height: 2.1rem;
    border: 1px solid var(--line); background: var(--surface); border-radius: 0.5rem; color: var(--muted); cursor: pointer; }
  .toggle:hover { color: var(--accent); border-color: var(--accent); }
  .toggle .moon { display: none; }
  :root[data-theme="dark"] .toggle .sun, :root:not([data-theme="light"]) .toggle .sun { display: none; }
  :root[data-theme="dark"] .toggle .moon, :root:not([data-theme="light"]) .toggle .moon { display: block; }
  :root[data-theme="light"] .toggle .sun { display: block; }
  :root[data-theme="light"] .toggle .moon { display: none; }
  @media (prefers-color-scheme: light) { :root:not([data-theme]) .toggle .sun { display: block; } :root:not([data-theme]) .toggle .moon { display: none; } }

  /* Hamburger + stacked menu — MOBILE ONLY */
  .menu-btn { display: none; place-items: center; width: 2.4rem; height: 2.4rem;
    border: 1px solid var(--line); background: var(--surface); border-radius: 0.5rem; color: var(--text); cursor: pointer; }
  .menu-btn:hover { border-color: var(--accent); color: var(--accent); }
  .menu-btn .i-close { display: none; }
  #menu-btn[aria-expanded="true"] .i-open { display: none; }
  #menu-btn[aria-expanded="true"] .i-close { display: block; }
  .site-menu { display: none; }

  @media (max-width: 820px) {
    .sections { display: none; }
    .menu-btn { display: inline-grid; }
    .site-menu { position: absolute; top: calc(100% + 1px); left: 0; right: 0; z-index: 30;
      background: var(--bg); border: 1px solid var(--line); border-top: none; border-radius: 0 0 0.7rem 0.7rem;
      box-shadow: var(--shadow); padding: 0.6rem 0.5rem 0.8rem; max-height: calc(100vh - 4rem); overflow-y: auto; }
    .site-menu.open { display: block; }
    .mm-group { padding: 0.35rem 0; }
    .mm-group + .mm-group { border-top: 1px solid var(--line-soft); }
    .mm-title { margin: 0.35rem 0.6rem 0.2rem; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--faint); }
    .mm-div { margin: 0.5rem 0.9rem 0.15rem; padding-top: 0.5rem; border-top: 1px solid var(--line-soft);
      font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.13em; text-transform: uppercase; color: var(--faint); }
    /* Level headings inside the hamburger — the mega-panel's structure, stacked.
       These carry more weight than on desktop: with no columns to separate the
       levels, the heading is the ONLY thing marking where one section ends and
       the next begins, so it gets a rule above it and real breathing room. */
    .mm-lv { display: flex; align-items: center; gap: 0.55rem;
      margin: 1.15rem 0.5rem 0.45rem; padding: 0.55rem 0.65rem; border-radius: 0.5rem;
      background: var(--accent-soft); border-left: 3px solid var(--accent); }
    .mm-lv.opt { background: var(--safe-dim); border-left-color: var(--safe); }
    .mm-lv .n { font-family: var(--mono); font-size: 0.86rem; font-weight: 700;
      color: var(--accent-ink); background: var(--accent); border-radius: 0.4rem;
      padding: 0.2rem 0.55rem; letter-spacing: 0.02em; }
    .mm-lv.opt .n { background: var(--safe); }
    .mm-lv .t { font-size: 1.02rem; font-weight: 800; letter-spacing: 0.07em;
      text-transform: uppercase; color: var(--text); }
    .mm-link { display: block; padding: 0.7rem 0.9rem; border-radius: 0.5rem; text-decoration: none;
      color: var(--text); font-size: 0.96rem; font-weight: 500; }
    .mm-link:hover, .mm-link:active { background: var(--surface); }
    .mm-link.active { color: var(--accent); }
    .brand { font-size: 0.98rem; }
  }
</style>

<!-- The sign-in button's avatar + the dropdown menu are built in JS (no Astro scope
     attribute), so these must be global. Namespaced under .nostr-* to avoid leaking. -->
<style is:global>
  .nostr-auth { position: relative; display: inline-flex; flex: 0 0 auto; }
  .nostr-login { display: inline-grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    overflow: hidden; border: 1px solid var(--line); background: var(--raise); color: var(--muted);
    cursor: pointer; flex: 0 0 auto; padding: 0; transition: box-shadow 0.15s, border-color 0.15s, color 0.15s; }
  .nostr-login:hover { border-color: var(--accent); color: var(--accent); }
  .nostr-login.on { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
  .nostr-login.on:hover { box-shadow: 0 0 0 2px var(--accent-soft); }
  .nostr-login img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .nostr-login .nl-fallback { font-family: var(--sans); font-weight: 700; font-size: 0.95rem; line-height: 1; }
