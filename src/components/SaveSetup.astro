---
// A "Save this setup to my plan" control for a ladder rung page (browsing a setup).
// Writes the ONE planned setup (replacing any existing one, with a confirm). The band
// is filled by client JS so its state reflects what's already saved in this browser.
const { rung, label, tier = '', source = 'ladder' } = Astro.props;
---
<div class="save-setup" data-rung={rung} data-label={label} data-tier={tier} data-source={source} aria-live="polite"></div>

<script>
  import { savePlannedSetup, plannedSetupRung, plannedSetupLabel } from '../data/plan.js';

  function paint(band) {
    const rung = band.dataset.rung;
    if (plannedSetupRung() === rung && rung) {
      band.innerHTML = `<span class="save-setup-done">✓ This is your saved plan.</span> <a class="save-setup-link" href="/my-plan">View or download it →</a>`;
      return;
    }
    band.innerHTML = `<button class="js-save-setup save-setup-btn" type="button">＋ Save this setup to my plan</button>
      <span class="save-setup-note">One setup at a time — saving replaces your current one. Kept only in your browser. <a href="/my-plan">Your plan →</a></span>`;
    band.querySelector('.js-save-setup').addEventListener('click', () => {
      const label = band.dataset.label, tier = band.dataset.tier, source = band.dataset.source;
      const curRung = plannedSetupRung(), curLabel = plannedSetupLabel();
      if (curLabel && curRung && curRung !== rung) {
        if (!confirm(`Replace your current planned setup — ${curLabel} — with ${label}?`)) return;
      }
      savePlannedSetup({ rung, label, tier, source });
      paint(band);
    });
  }

  document.querySelectorAll('.save-setup').forEach(paint);
</script>

<style is:global>
  .save-setup { border: 1px solid var(--accent-dim); border-radius: 0.7rem; background: var(--accent-soft);
    padding: 0.9rem 1.1rem; margin: 1.8rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; min-height: 1.5rem; }
  .save-setup-btn { background: var(--accent); color: var(--accent-ink); border: none; font-family: var(--sans);
    font-weight: 600; font-size: 0.92rem; cursor: pointer; padding: 0.6rem 1.1rem; border-radius: 0.55rem; }
  .save-setup-btn:hover { opacity: 0.9; }
  .save-setup-note { color: var(--muted); font-size: 0.82rem; }
  .save-setup-note a, .save-setup-link { color: var(--accent); text-decoration: none; }
  .save-setup-note a:hover, .save-setup-link:hover { text-decoration: underline; }
  .save-setup-done { color: var(--safe); font-weight: 600; font-size: 0.92rem; }
</style>
