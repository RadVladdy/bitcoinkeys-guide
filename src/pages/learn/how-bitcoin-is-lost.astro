---
import Base from '../../layouts/Base.astro';
import LessonNav from '../../components/LessonNav.astro';
import LessonEyebrow from '../../components/LessonEyebrow.astro';
import { numberWord } from '../../data/numbers.js';
import RuleBand from '../../components/RuleBand.astro';
import LessonClose from '../../components/LessonClose.astro';
import LessonCheck from '../../components/LessonCheck.astro';
import LessonCrumb from '../../components/LessonCrumb.astro';
import { levelById, lessonFor } from '../../data/curriculum.js';
import { finderPromise } from '../../data/quiz.js';

// "103 · Private key creation" as PLAIN TEXT, derived. The `covered` lines below
// deliberately name where a defence is taught without linking to it (invariant 9 —
// the course is linear and this is lesson 3 of 17), and until 2026-08-03 they typed the level
// title as well as the number. A level title is an inventory claim about the site:
// 102 was retitled and four sentences in this one file would have gone on naming
// the old one, silently and unlinkably.
const lvl = (id) => { const l = levelById(id); return `${l.id} · ${l.title}`; };
const lessonLabel = (href) => lessonFor(href).label;

// The five ways Bitcoin is lost, in plain English, each with the defence.
//
// DE-FORWARD-LINKED 2026-07-30. Every bucket used to end in a row of links to
// "the page in this guide that defends against it" — and this is lesson 3 of 17,
// so eight of those nine links pointed at material the reader had not reached.
// That is exactly what the old /principles page was doing at position 5, and it
// is what invariant #9 exists to prevent: on this site links point backwards.
//
// The defence lines were never the problem — they're the reason the page works.
// So they stay, and `covered` now NAMES the level and lesson in plain text, the
// same device /learn/rules uses. Findable in the menu, nobody yanked out of
// sequence.
//
// LINK ROWS REMOVED ENTIRELY 2026-07-30 (later). The de-forward-linking above cut
// only the FORWARD links and kept three backward ones — passing invariant #9 by the
// letter while missing its point. The result was a page running both devices at
// once: a `covered` sentence naming lessons in plain text, then a link row naming
// DIFFERENT ones. Bucket 2 offered "What a key really is," which its covered line
// never mentions. Bucket 4 said "the very next lesson is this one in full" and then
// offered "The twelve rules" and "Start here" — pulling the reader back to lesson 1
// and out to the syllabus, at position 3 of 17, immediately after being told the
// answer was one lesson away. Backward, and still exactly wrong. `covered` is the
// device this page uses; there is no `links` field any more, so it cannot regrow.
const buckets = [
  {
    n: 1,
    title: 'You lose access to it yourself',
    gist: 'The single most common way. No thief involved — the coins are still there on the blockchain, but you can no longer prove they’re yours. This is where most lost Bitcoin has gone.',
    ways: [
      { h: 'You never made a backup — or made only one.', d: 'Your recovery words live in one place, and that place is fragile. A house fire, a flood, a hard drive that dies, ink that fades, or a “safe spot” that gets thrown out during a move or a renovation — and the money is gone with it.' },
      { h: '“I’ll just remember it.”', d: 'People memorise a passphrase or invent a clever secret scheme instead of writing it down. Years later the memory has drifted, and nothing they try unlocks the wallet. A secret you can’t reproduce under stress is not a backup.' },
      { h: 'You never tested the backup.', d: 'A word gets mis-copied when writing it down. You don’t find out until the day you actually need it — and by then it’s too late. A backup you haven’t restored from is a hope, not a backup.' },
      { h: 'You die without leaving a plan.', d: 'Your family finds a metal plate or a hardware wallet and has no idea what it is or how to use it — so they bin it. The most common version: a hidden passphrase nobody knew about, so heirs restore the words, see an empty wallet, and assume there was nothing there.' },
    ],
    defense: 'Back up your words on metal, keep a second copy somewhere else, test the restore before you fund it, and leave a plan your family can follow.',
    covered: `Three lessons take this apart: <strong>Backing up a seed phrase</strong> and <strong>Testing a backup</strong> in ${lvl('103')}, then <strong>Why Bitcoin doesn’t inherit like money</strong> in ${lvl('104')}.`,
  },
  {
    n: 2,
    title: 'Someone takes it remotely',
    gist: 'A stranger, over the internet, who never touches you or your home. The good news: this almost always requires you to be tricked into helping — so a few simple habits shut most of it down.',
    ways: [
      { h: 'Phishing and fake “support.”', d: 'By far the number-one real-world attack. You get an urgent email or text — “suspicious activity,” “verify your account” — that looks exactly like your exchange or wallet company. It sends you to a fake site that steals your words. The rule that beats it: no real company ever contacts you asking for your recovery words. Ever.' },
      { h: 'Address-swapping malware.', d: 'A virus on your computer silently swaps the payment address you copied for the attacker’s, so your Bitcoin flies off to a stranger. The defence is simple: always check the address on the hardware wallet’s own little screen — that screen can’t be faked by your computer.' },
      { h: 'Fake wallet apps.', d: 'A phoney app pretending to be a real wallet, sitting in an app store, waiting for you to type your recovery words in to “restore” — and then it steals them. Only ever download wallet software from the maker’s official website.' },
      { h: 'The seed you typed or photographed.', d: 'The moment your recovery words touch an internet-connected device — a photo that auto-uploads to the cloud, words typed into a phone — they can leak, sometimes years later when that cloud account is breached. Keep the words off anything digital, full stop.' },
    ],
    defense: 'Never type or photograph your recovery words. Verify every address on the hardware wallet’s screen. Assume any “support” message that wants your words is a scam.',
    covered: `The scams themselves get a whole lesson — <strong>Phishing and everyday safety</strong>, in ${lvl('104')}. The address check is <strong>Sending Bitcoin safely</strong>, in ${lvl('103')}.`,
  },
  {
    n: 3,
    title: 'Someone takes it physically',
    gist: 'A person in the real world — a burglar, or someone who threatens you in person. Rare, but rising fast, and it works differently than people expect: attackers don’t break the math, they go around it.',
    ways: [
      { h: 'A found backup.', d: 'A burglar doesn’t need to “hack” anything if they find your recovery words in a drawer, or your hardware wallet and its passphrase sitting on the same shelf.' },
      { h: 'The “$5 wrench.”', d: 'The blunt truth: cryptography can’t protect you from someone willing to threaten you until you hand it over. If they know you hold Bitcoin and can reach you, the strong encryption doesn’t matter.' },
      { h: 'Being picked as a target.', d: 'These attacks are almost never random. It usually starts with a data leak — an exchange gets breached and your name and home address end up on a list — which gets cross-referenced with anything you’ve posted publicly about holding Bitcoin. That’s the pipeline: leak → list → your door.' },
    ],
    defense: 'The best physical protection isn’t a gadget, it’s a habit: <strong>talk about Bitcoin as loudly as you like — never about <em>your</em> Bitcoin.</strong> Don’t attach your own name to the fact that you hold and self-custody it, and never attach a number. That includes the people you trust, because they have people they trust too.<br><br>Beyond the habit, the defence is structural: keep backups out of obvious places, and arrange your keys so that no single location — and no single confrontation — holds enough to hand over everything. The setups that make that real, and the backup warning that comes with them, are taught in the lessons named below.',
    covered: `The habits that keep you off the list are <strong>Privacy / OpSec</strong>, in ${lvl('104')}. The decoy setup itself is a rung on the ladder, in ${lvl('102')}.`,
  },
  {
    n: 4,
    title: 'You trusted someone else to hold it',
    gist: 'You left your Bitcoin on an exchange or with a company, and that company failed, froze your account, or was hacked. If you don’t hold the keys, you don’t really hold the coins — you hold an IOU.',
    ways: [
      { h: 'The company goes bankrupt or runs off with it.', d: 'This is not hypothetical — it’s Bitcoin’s most repeated disaster. Mt. Gox lost about 850,000 coins in 2014. FTX vaporised roughly $8 billion of customer money in 2022. The list of collapsed exchanges is long, and it keeps getting longer.' },
      { h: 'Your account gets frozen.', d: 'Even a healthy exchange can lock your withdrawals — during a hack, a legal order, or a “review” — and there’s nothing you can do but wait, sometimes forever.' },
    ],
    defense: 'Move your Bitcoin off the exchange and into your own custody after you buy — that single step is what this whole guide is about. Choosing a buying service you don’t have to live on, and the habit of withdrawing early, are part of the same lesson.',
    covered: 'The very next lesson — <strong>Not your keys, not your coins</strong> — is this one in full.',
  },
  {
    n: 5,
    title: 'You make a simple send mistake',
    gist: 'A fumble during a transaction. Bitcoin payments can’t be reversed once they go through, so a slip here is permanent — but a couple of habits make it very hard to get wrong.',
    ways: [
      { h: 'You send to the wrong address.', d: 'Good news: modern Bitcoin addresses (the ones starting with “bc1”) have a built-in error check that catches almost any typo before it can send. The real risk is malware swapping the address — which is why you verify it on the hardware wallet’s screen — and not doing a test run first.' },
      { h: 'You send more than you meant to.', d: 'Rushing, tired, or being pressured is when the expensive mistakes happen. There’s no undo button. For anything substantial, slow down — a wallet operation done in a panic is where people lose the most.' },
      { h: 'You send it over the “wrong network.”', d: 'Some exchanges and apps let you send “Bitcoin” out as a look-alike copy on another blockchain, or ask you to pick a “network” before you withdraw. Choose the wrong one and your coins land somewhere your normal wallet can’t see. The fix is simple: only ever send real, native Bitcoin, and at any network menu choose “Bitcoin.”' },
    ],
    defense: 'Verify the address on the hardware wallet’s screen, send a tiny test amount first, confirm it arrives, then send the rest — and never do it in a hurry. When withdrawing, make sure you’re sending real Bitcoin on the Bitcoin network.',
    covered: `All of it lands in one lesson: <strong>Sending Bitcoin safely</strong>, in ${lvl('103')}.`,
  },
];
---
<Base
  title="How people actually lose Bitcoin · BitcoinKeys.guide"
  description={`The plain-English map of how Bitcoin is really lost — mostly mistakes, not hackers. Learn the ${numberWord(buckets.length)} ways it happens so you can see each one coming, with the exact page in this guide that defends against each.`}
  verified="2026-08-04"
>
  <LessonCrumb href="/learn/how-bitcoin-is-lost" />
  <section class="risk-intro">
   <div class="prose intro-main">
    <LessonEyebrow />
    <h1>How people actually lose <span class="accent">Bitcoin</span></h1>
    <p class="lead">
      Before you decide how to protect your Bitcoin, it helps to know what you’re protecting it
      <em>from</em>. Here’s the honest surprise: most Bitcoin that’s been lost was never stolen by a
      hacker. It was forgotten, misplaced, or fumbled by its own owner.
    </p>
    <RuleBand />
    <div class="callout safe strip">
      <span class="label">The short version</span>
      <p style="margin:0">
        Almost none of the Bitcoin that’s ever been lost was taken by breaking anyone’s security. Over
        <strong>80% of what gets called “theft” is really a scam or a simple slip</strong> — and it’s avoidable. Learn the handful
        of ways it happens below and you sidestep nearly all of it.
      </p>
    </div>
    <p>
      You may have heard that somewhere between <strong>11% and 23% of all Bitcoin is lost forever</strong>.
      The figure is real — but it traces back to Bitcoin’s earliest years: coins worth pennies, held by
      people who had no idea they’d ever matter, lost to reformatted drives and forgotten passwords. It’s
      a one-time artifact of that era, <em>not</em> a “one in six of today’s coins are doomed” risk hanging
      over you now. The single biggest thing separating you from those early losses is simple: <strong>you
      already know what you’re holding.</strong> So read the list below not as what’s <em>likely</em> to
      happen to you, but as the short, knowable set of things to design around.
    </p>
   </div>
   <aside class="rail" aria-label="Key facts">
     <div class="stat">
       <div class="stat-n num">80%</div>
       <div class="stat-c">of Bitcoin “theft” is really a scam or a simple mistake — not a hacker.</div>
     </div>
     <div class="stat">
       <div class="stat-n num">11–23%</div>
       <div class="stat-c">of all Bitcoin is lost — but almost all of it in the earliest years, by people who didn’t know to protect it.</div>
     </div>
     <div class="stat">
       <div class="stat-n num">2</div>
       <div class="stat-c">ways to lose it: you lose the keys, or someone else gets them. Every defence trades one for the other.</div>
     </div>
     <p class="stat-src">The percentages are Chainalysis-family estimates — readings of the public ledger, not precise counts.</p>
   </aside>
  </section>

  <section class="prose">
    <div class="callout">
      <span class="label">One idea that ties it all together</span>
      <p>
        There are really only two ways to lose Bitcoin: <strong>you can’t get to it</strong> (you lost
        the keys), or <strong>someone else can</strong> (someone got the keys). The tricky part —
        and the reason there’s no single “just do this” answer — is that
        <strong>almost every defence against one of those makes the other worse.</strong>
      </p>
      <p style="margin-bottom:0">
        Add a secret passphrase to stop a thief, and you’ve added a new way to lock <em>yourself</em>
        out. Spread your backup across three cities to survive a fire, and you’ve made it harder for
        <em>you</em> to put it back together. That trade-off is why the next level builds your setup
        as a <strong>ladder</strong> — you climb only as far as your real risks require, and no further.
      </p>
    </div>
  </section>

  <section>
    <ol class="risks">
      {buckets.map((b) => (
        <li class="risk">
          <div class="risk-head">
            <span class="rn num">{String(b.n).padStart(2, '0')}</span>
            <div>
              <h2>{b.title}</h2>
              <p class="gist">{b.gist}</p>
            </div>
          </div>
          <ul class="ways">
            {b.ways.map((w) => (
              <li><strong>{w.h}</strong> {w.d}</li>
            ))}
          </ul>
          <div class="defense">
            <span class="dlabel">How this guide defends it</span>
            <p set:html={b.defense}></p>
            {b.covered && <p class="dcovered" set:html={b.covered}></p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="prose">
    <div class="callout safe">
      <span class="label">The one habit that helps against almost everything</span>
      <p style="margin-bottom:0">
        Most defences trade one risk for another — but <strong>testing your recovery</strong> is the
        rare win-win. Wipe your wallet and restore it from your written words with a tiny amount, before
        you trust it with savings. You catch a broken backup while it’s still harmless, and you’ll never
        have to improvise a recovery in a panic. <strong>{lessonLabel('/learn/test-your-backup')}</strong>, in {lvl('103')},
        walks the whole rehearsal.
      </p>
    </div>
    {/* CLOSES ON THE LESSON'S OWN POINT, AND SENDS NOBODY ANYWHERE.
        This was a headed section pitching the setup finder with a button. It
        read as the next thing to do, three lessons into a course whose whole
        premise is that understanding comes before configuring — and the reader
        who took it left the sequence at lesson 3 of 17. The finder is reachable
        from the nav on every page and from /start; it does not need a door here.
        The teaching point is worth keeping and is kept, in one sentence: the
        ladder answers "which of these are mine", and it is named in PLAIN TEXT
        the way /learn/rules names its lessons, so it stays findable without
        pulling anyone forward (invariant #9). */}
    <p class="closer">
      <strong>And you don’t need to defend against all {numberWord(buckets.length)} equally.</strong> Which of them are
      really yours depends on how much is at stake, and on how and where you hold it — which is what
      {' '}{lvl('102')} works out.
    </p>

  </section>

  <LessonCheck href="/learn/how-bitcoin-is-lost" />

  <section class="prose">
    <LessonClose
      learned={`the ${numberWord(buckets.length)} ways Bitcoin is actually lost, and which defence answers each one`}
      action={`When you want that weighed against your own situation rather than the average holder's, the setup finder walks ${finderPromise} — starting from the same base rates this lesson just taught — and names the setup that covers what is actually yours.`}
      locate="/find-your-setup"
    />
  </section>

  <LessonNav />
</Base>

<style>
  /* the lesson's closing line — no heading, no outbound link */
  .closer { margin-top: 1.6rem; }
  /* intro: two columns — copy on the left, key-fact rail on the right */
  .risk-intro { display: grid; grid-template-columns: minmax(0, 1fr) 15.5rem; gap: 2.8rem; align-items: start; }
  .intro-main .strip { margin-top: 1.5rem; }
  .rail { display: flex; flex-direction: column; gap: 0.9rem; }
  .stat { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1.05rem 1.2rem; }
  .stat-n { font-family: var(--mono); font-weight: 800; color: var(--accent); font-size: 2.3rem; line-height: 1; letter-spacing: -0.02em; }
  .stat-c { margin-top: 0.5rem; font-size: 0.88rem; line-height: 1.45; color: var(--muted); }
  .stat-src { margin: 0; font-size: 0.78rem; line-height: 1.45; color: var(--faint); }
  @media (max-width: 860px) {
    .risk-intro { grid-template-columns: 1fr; gap: 1.6rem; }
    .rail { flex-direction: row; flex-wrap: wrap; }
    .stat { flex: 1 1 12rem; }
    .stat-src { flex: 1 1 100%; }
  }

  .risks { list-style: none; margin: 1.6rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1.1rem; }
  .risk { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.4rem 1.5rem; }
  .risk-head { display: grid; grid-template-columns: 3rem 1fr; gap: 1.1rem; align-items: start; }
  .rn { font-family: var(--mono); font-size: 1.5rem; font-weight: 800; color: var(--accent); line-height: 1; }
  .risk h2 { margin: 0.1rem 0 0.4rem; font-size: 1.2rem; }
  .gist { margin: 0; color: var(--muted); }
  .ways { margin: 1.1rem 0 0; padding: 0 0 0 0; list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }
  .ways li { color: var(--text); font-size: 0.96rem; line-height: 1.55; padding-left: 1.1rem; position: relative; }
  .ways li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--accent); }
  .ways strong { color: var(--text); }
  .defense { margin-top: 1.2rem; border-top: 1px solid var(--line-soft); padding-top: 1rem; }
  .dlabel { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .defense p { margin: 0.4rem 0 0.7rem; color: var(--muted); font-size: 0.95rem; }
  /* Where the course teaches this, named in plain text — no forward links (invariant #9). */
  .dcovered { font-size: 0.88rem !important; color: var(--faint) !important; border-left: 2px solid var(--line);
    padding-left: 0.75rem; margin: 0.7rem 0 0 !important; }
  .dcovered strong { color: var(--muted); font-weight: 600; }
  .btn { display: inline-flex; align-items: center; background: var(--accent); color: var(--accent-ink); font-weight: 700;
    font-family: var(--mono); font-size: 0.95rem; padding: 0.7rem 1.1rem; border-radius: 0.6rem; text-decoration: none; }
  .btn.ghost { background: transparent; color: var(--text); border: 1px solid var(--line); }
</style>
