---
import Base from '../../layouts/Base.astro';
import LessonNav from '../../components/LessonNav.astro';
import Diagram from '../../components/Diagram.astro';
import { lessons } from '../../data/lessons.js';
import RuleBand from '../../components/RuleBand.astro';
import { lessonFor } from '../../data/curriculum.js';

export function getStaticPaths() {
  return lessons.map((h, i) => ({
    params: { slug: h.slug },
    props: { h },
  }));
}

const { h } = Astro.props;
const toneClass = { warn: 'warn', safe: 'safe', danger: 'danger' };
// accent a keyword/phrase in the title (orange), leaving the rest plain
const accentize = (title, phrase) => {
  if (!phrase) return title;
  const i = title.indexOf(phrase);
  if (i < 0) return title;
  return title.slice(0, i) + `<span class="accent">${phrase}</span>` + title.slice(i + phrase.length);
};
// The eyebrow says where you are in the COURSE ("103 · The build · lesson 3 of 3")
// rather than what format the page is ("How-to"). Grouping by format is the habit
// this whole restructure removed; the eyebrow was the last place still doing it.
const pos = lessonFor(`/learn/${h.slug}`);
---
<Base
  title={`${h.title} · BitcoinKeys.guide`}
  description={h.lead}
  verified={h.verified ?? '2026-07-15'}
>
  <nav class="crumb"><a href="/learn">The course</a> <span aria-hidden="true">/</span> <span>{h.short ?? h.slug}</span></nav>

  <section class="prose">
    <p class="eyebrow">
      {pos ? `${pos.levelId} · ${pos.levelTitle} · lesson ${pos.indexInLevel + 1} of ${pos.lessonsInLevel}` : 'The course'}
    </p>
    <h1 set:html={accentize(h.title, h.accent)}></h1>
    <p class="lead">{h.lead}</p>
    <RuleBand href={`/learn/${h.slug}`} />
    {h.intro && <><hr class="lead-sep" /><p set:html={h.intro}></p></>}
  </section>

  <section class="prose">
    {h.diagram && <Diagram name={h.diagram} />}

    {h.sections.map((s) => (
      <>
        <h2>{s.h}</h2>
        <div set:html={s.body}></div>
      </>
    ))}

    {h.keyCallout && (
      <div class:list={['callout', toneClass[h.keyCallout.tone] ?? '']}>
        <span class="label">{h.keyCallout.label}</span>
        <p set:html={h.keyCallout.body}></p>
      </div>
    )}
  </section>

  {h.checklist && h.checklist.length > 0 && (
    <section>
      <div class="checklist">
        <span class="cl-title">The short checklist</span>
        <ul>
          {h.checklist.map((item) => <li set:html={item}></li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- Prev/next now comes from <LessonNav />, which walks the whole course
       (curriculum.js) rather than just the how-to list. -->

  <LessonNav />
</Base>

<style>
  .lead-sep { border: 0; border-top: 1px solid var(--line-soft); max-width: 46ch; margin: 1.4rem 0 1.5rem; }
  .crumb { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); margin-bottom: 1.2rem; display: flex; gap: 0.5rem; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; }
  .prose :global(li) { margin: 0.4rem 0; }
  .prose :global(li::marker) { color: var(--accent); }

  .checklist { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1.3rem 1.5rem; }
  .cl-title { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 0.7rem; }
  .checklist ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .checklist li { position: relative; padding-left: 1.9rem; color: var(--text); }
  .checklist li::before { content: "✓"; position: absolute; left: 0; top: 0; color: var(--safe); font-weight: 700; font-family: var(--mono); }

</style>
