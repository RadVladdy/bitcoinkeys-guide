---
import Base from '../../layouts/Base.astro';
import LessonNav from '../../components/LessonNav.astro';
import Diagram from '../../components/Diagram.astro';
import { lessons } from '../../data/lessons.js';
import RuleBand from '../../components/RuleBand.astro';
import LessonEyebrow from '../../components/LessonEyebrow.astro';
import LessonCheck from '../../components/LessonCheck.astro';
import LessonToc from '../../components/LessonToc.astro';
import LessonClose from '../../components/LessonClose.astro';
import LessonCrumb from '../../components/LessonCrumb.astro';
// Page order below is load-bearing: lesson body, then the lesson's own short
// checklist, then the knowledge check, then prev/next. The check sits after the material it tests and before the exit.
// LessonCheck self-locates by rule and renders nothing where a rule has no check;
// LessonNav walks curriculum.js, so neither is hardcoded per lesson.

export function getStaticPaths() {
  return lessons.map((h, i) => ({
    params: { slug: h.slug },
    props: { h },
  }));
}

const { h } = Astro.props;
// Every lesson must carry its own "last verified" date — a silent fallback here
// once let stale stamps ship, so a missing date now fails the build instead.
if (!h.verified) throw new Error(`Lesson "${h.slug}" has no verified date in lessons.js — add one before building.`);
// Section headings get stable slug ids so the desktop "On this page" rail can
// anchor to them (same slug idiom as the glossary). Nothing else targets these ids.
const sid = (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const toc = h.sections.map((s) => ({ id: sid(s.h), label: s.h }));
const toneClass = { warn: 'warn', safe: 'safe', danger: 'danger' };
// accent a keyword/phrase in the title (orange), leaving the rest plain
const accentize = (title, phrase) => {
  if (!phrase) return title;
  const i = title.indexOf(phrase);
  if (i < 0) return title;
  return title.slice(0, i) + `<span class="accent">${phrase}</span>` + title.slice(i + phrase.length);
};
// The eyebrow says where you are in the COURSE ("103 · The build · lesson 3 of 3")
// rather than what format the page is ("How-to"). Grouping by format is the habit
// this whole restructure removed; the eyebrow was the last place still doing it.
// It lives in LessonEyebrow now so the hand-written lesson pages (seven, as of
// 2026-08-04) share the one format string instead of typing their own position.
---
<Base
  title={`${h.title} · BitcoinKeys.guide`}
  description={h.lead}
  verified={h.verified}
>
  <LessonCrumb href={`/learn/${h.slug}`} />

  <div class="lgrid">
  <div class="lmain">
  <section class="prose">
    <LessonEyebrow />
    <h1 set:html={accentize(h.title, h.accent)}></h1>
    <p class="lead">{h.lead}</p>
    <RuleBand href={`/learn/${h.slug}`} />
    {h.intro && <><hr class="lead-sep" /><p set:html={h.intro}></p></>}
  </section>

  <section class="prose">
    {h.diagram && <Diagram name={h.diagram} />}

    {h.sections.map((s) => (
      <>
        <h2 id={sid(s.h)}>{s.h}</h2>
        <div set:html={s.body}></div>
      </>
    ))}

    {h.keyCallout && (
      <div class:list={['callout', toneClass[h.keyCallout.tone] ?? '']}>
        <span class="label">{h.keyCallout.label}</span>
        <p set:html={h.keyCallout.body}></p>
      </div>
    )}
  </section>

  {h.checklist && h.checklist.length > 0 && (
    <section>
      <div class="checklist">
        <span class="cl-title">The short checklist</span>
        <ul>
          {h.checklist.map((item) => <li set:html={item}></li>)}
        </ul>
      </div>
    </section>
  )}

  <LessonCheck href={`/learn/${h.slug}`} />

  {/* Optional per-lesson closer. Present only where the lesson HAS a
      take-action counterpart — a hollow "here's where the doing lives" on a
      lesson with nothing to do is noise, and seventeen of them would train the
      reader to skip the one that matters. The curriculum links to no
      take-action page, so this describes the location instead. */}
  {h.close && <section class="prose"><LessonClose {...h.close} /></section>}

  <LessonNav />
  </div>

  <LessonToc items={toc} />
  </div>
</Base>

<style>
  .lead-sep { border: 0; border-top: 1px solid var(--line-soft); max-width: 46ch; margin: 1.4rem 0 1.5rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; }
  .prose :global(li) { margin: 0.4rem 0; }
  .prose :global(li::marker) { color: var(--accent); }

  .checklist { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1.3rem 1.5rem; }
  .cl-title { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 0.7rem; }
  .checklist ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .checklist li { position: relative; padding-left: 1.9rem; color: var(--text); }
  .checklist li::before { content: "✓"; position: absolute; left: 0; top: 0; color: var(--safe); font-weight: 700; font-family: var(--mono); }

  /* The rail and its two-column grid live in LessonToc.astro — one definition,
     four pages. */
</style>
