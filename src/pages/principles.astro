---
import Base from '../layouts/Base.astro';

const principles = [
  { t: 'Not your keys, not your coins', d: 'Bitcoin on an exchange is really just a promise from the company to pay you back — not the actual coins. It’s only truly yours when you hold the keys.', href: '/start' },
  { t: 'The seed phrase is the wallet', d: 'The device is replaceable — lose or break it and you restore from your words. The words are the money.', href: '/how-to/choose-a-wallet' },
  { t: 'The simplest setup that covers you wins', d: 'Not the most impressive, not the one a vendor sells. The simplest one that defends against the risks you can name.', href: '/ladder' },
  { t: 'More complexity isn’t more security', d: 'Complexity is the single biggest cause of lost Bitcoin. Climb the ladder only for a real reason.', href: '/ladder' },
  { t: 'A backup you haven’t tested is a hope', d: 'Wipe and restore with a tiny amount before you trust it with savings. Prove it, don’t assume it.', href: '/how-to/recovery-rehearsal' },
  { t: 'Never let your seed touch anything digital', d: 'No photo, no cloud, no typing it into a phone or computer — not even for a minute.', href: '/how-to/back-up-your-seed' },
  { t: 'Verify the address on the device’s own screen', d: 'Your computer can be fooled by malware. The hardware wallet shows the truth. Check it every time.', href: '/how-to/send-bitcoin-safely' },
  { t: 'Don’t talk about your Bitcoin', d: 'The best physical protection is not being known as a holder. Share the idea, not your holdings.', href: '/how-to/physical-security' },
  { t: 'Plan for the day you’re gone', d: 'Most lost Bitcoin isn’t stolen — it’s left behind with no instructions. Leave a plan your family can follow.', href: '/how-to/inheritance' },
  { t: 'Verify, don’t trust', d: 'When you’re ready, run your own <a href="/glossary#full-node">node</a> (your own copy of Bitcoin’s rulebook) so you check the rules yourself instead of trusting someone’s server.', href: '/how-to/run-a-node' },
];
---
<Base
  title="The core principles of self-custody · BitcoinKeys.guide"
  description="Ten plain-English principles that hold up everything else about holding your own Bitcoin. The short version you can keep in your head."
  verified="2026-07-15"
>
  <section class="prose">
    <p class="eyebrow">Core principles</p>
    <h1>Ten rules that hold up everything else</h1>
    <p class="lead">If you remember nothing else from this guide, remember these. Each links to the page that goes deeper.</p>
  </section>

  <section>
    <ol class="principles">
      {principles.map((p, i) => (
        <li class="principle">
          <span class="pn num">{String(i + 1).padStart(2, '0')}</span>
          <div class="pbody">
            <a href={p.href}><h3>{p.t}</h3></a>
            <p set:html={p.d}></p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="prose">
    <div class="callout safe">
      <span class="label">And the one that contains them all</span>
      <p><strong>Verify. Don’t trust.</strong> Everything here is one expression of that idea — check your backup, check the address, check the rules, and don’t take anyone’s word for what’s yours.</p>
    </div>
  </section>
</Base>

<style>
  .principles { list-style: none; margin: 1.4rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; counter-reset: none; }
  .principle { display: grid; grid-template-columns: 3rem 1fr; gap: 1.1rem; align-items: start;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.3rem; }
  .pn { font-family: var(--mono); font-size: 1.4rem; font-weight: 800; color: var(--accent); line-height: 1; }
  .pbody a { text-decoration: none; }
  .pbody h3 { margin: 0.1rem 0 0.3rem; color: var(--text); }
  .pbody a:hover h3 { color: var(--accent); }
  .pbody p { margin: 0; color: var(--muted); font-size: 0.95rem; }
</style>
