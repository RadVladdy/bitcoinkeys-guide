---
// V2 OF THE BIP-39 WORD TABLE — an experiment, and TABLE ONLY.
//
// No method sheet, no worksheet, no instructions: this page is the reference
// pages and nothing else, so the layout can be judged on its own. The shipped
// artifact at /dice-word-table keeps all three parts.
//
// WHAT IS DIFFERENT. The shipped table blocks on the first THREE throws and
// prints the whole key on every line — `23142H globe` — so three of those five
// characters repeat the heading directly above them, 2,048 times.
//
// V2 nests one level higher:
//   · the outer BOX is the first two throws          ("23")
//   · inside it, the four three-digit prefixes sit side by side  (231 232 233 234)
//   · each entry prints only what is left            ("42H globe")
//
// Finding a word becomes: find the two-digit box, then the three-digit column,
// then the last two throws and the flip — which is the order the dice actually
// come out in, one lookup step per pair of throws rather than one big key.
//
// MEASURED, not guessed: 4 printed pages at 6.6pt — the same page count AND the
// same type size as the shipped table, with the repetition gone. 7pt costs a
// fifth page, so 6.6pt is the ceiling here exactly as it is there. Boxes fall
// 4/5/5/2 across the pages; `break-inside: avoid` keeps every box whole, which
// is the property worth paying for in a lookup table.
//
// NOINDEX: this is a second copy of the same 2,048 rows. It should not compete
// with the real artifact in search, and it is not linked from the nav.
//
// SAME DATA, RE-GROUPED, NEVER REGENERATED. v2Boxes is built from `rows`, which
// is already asserted bijective onto the wordlist, and the regrouping asserts it
// still covers every entry exactly once. This page cannot hold a word the
// shipped table does not.
import Base from '../layouts/Base.astro';
import {
  v2Boxes, v2BoxCount, v2ColsPerBox, v2ItemsPerCol,
  tableRowCount, DICE_PER_WORD, PREFIX_THROWS, V2_BOX_THROWS,
} from '../data/dice-table.js';
import { diceVerified } from '../data/dice.js';
---
<Base
  title="BIP-39 word table v2 (layout experiment) · BitcoinKeys.guide"
  description="A second layout for the dice-to-word table: nested by the first two throws, with each entry printing only what the headings do not already say."
  verified={diceVerified}
  noindex
>
  <section class="prose v2-intro">
    <p class="eyebrow">Layout experiment · not the shipped artifact</p>
    <h1>BIP-39 word table <span class="accent">v2</span></h1>
    <p class="lead">
      The same {tableRowCount.toLocaleString()} words as <a href="/dice-word-table">the shipped table</a>,
      grouped differently. Boxed by your first {V2_BOX_THROWS} throws; inside each box, the four
      {' '}{PREFIX_THROWS}-throw columns; and each line prints only the last
      {' '}{DICE_PER_WORD - PREFIX_THROWS} throws and the flip, because the headings above it already say
      the rest.
    </p>
    <p class="lead v2-sub">
      {v2BoxCount} boxes · {v2ColsPerBox} columns each · {v2ItemsPerCol} lines per column.
      <strong> Nothing here is an instruction</strong> — the method and the worksheet stay on
      {' '}<a href="/dice-word-table">the shipped artifact</a>.
    </p>
    {/* THE PDF, NOT window.print(). Printing the page depends on the reader's
        own browser margins, headers and background-graphics setting — three
        things we do not control and one of which silently drops every tint.
        The PDF is the artifact; the page is how you read it on a screen. */}
    <p class="v2-print">
      <a class="btn" href="/bip39-word-table.pdf" download>The table on its own — PDF, 4 pages</a>
      <a class="btn ghost" href="/roll-12-word-seed.pdf" download>12-word seed — everything, 6 pages</a>
      <a class="btn ghost" href="/roll-24-word-seed.pdf" download>24-word seed — everything, 6 pages</a>
    </p>
  </section>

  {/* THE PRINT TITLE. The artifact went out with no name on it: six sheets of
      numbers and words and nothing saying what they were or where they came
      from. A print-out gets passed around and separated from its download, so
      it has to introduce itself and name the site — the same reason the shipped
      method sheet does. Print-only: on screen the h1 above already says it. */}
  <header class="v2-title">
    <h2 class="v2-title-h">BIP-39 word table
      <span class="v2-title-s">{tableRowCount.toLocaleString()} words · {DICE_PER_WORD} throws and a coin flip</span>
      <span class="v2-title-u">bitcoinkeys.guide/roll-your-own-seed</span></h2>
  </header>

  {v2Boxes.map((b) => (
    <section class="v2-box">
      <h2 class="v2-box-h">{b.box}</h2>
      <div class="v2-cols">
        {b.cols.map((c) => (
          <div class="v2-col">
            <h3 class="v2-col-h">{c.prefix}</h3>
            <ul class="v2-rows">
              {c.items.map((it) => (
                <li><span class="v2-k mono">{it.rest}</span>{it.word}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}
</Base>

<style is:global>
  .v2-title { display: none; }
  .v2-sub { font-size: 0.92rem; color: var(--muted); }
  .v2-print { margin: 1.2rem 0 2rem; }

  /* SCREEN. Readable rather than dense — the print rules below are where the
     layout is actually being judged. */
  .v2-box { border: 1px solid var(--line); border-radius: var(--radius); padding: 0.9rem 1rem;
    margin: 0 0 0.9rem; background: var(--surface); break-inside: avoid; }
  .v2-box-h { font-size: 1.1rem; margin: 0 0 0.5rem; color: var(--accent); font-family: var(--mono); }
  .v2-cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; }
  .v2-col-h { font-size: 0.85rem; margin: 0 0 0.2rem; font-family: var(--mono); color: var(--text); }
  .v2-rows { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 0.7rem;
    font-size: 0.78rem; line-height: 1.35; }
  .v2-rows li { color: var(--muted); }
  .v2-k { color: var(--faint); margin-right: 0.3rem; }

  @media (min-width: 900px) {
    .v2-cols { grid-template-columns: repeat(4, 1fr); }
  }

  @media print {
    /* WHITE PAPER. The site's cream sits behind everything on screen, and on a
       print-out it is a full-bleed tint on every sheet — ink spent on nothing,
       and it greys down 6.6pt text that needs all the contrast it can get. */
    :root, body, main { background: #fff !important; }
    /* AND NO TOP PADDING. The layout gives <main> breathing room that makes
       sense under a sticky nav and is 23pt of blank paper once the nav is
       hidden — measured: the title sat at y=51.9 on a page whose content began
       at 28.8. That 23pt was the difference between four boxes on page one and
       three. The BOTTOM padding matters just as much and is easier to miss: it
       follows the last box, so it only ever costs the FINAL page — page four
       held three boxes while pages one to three held four, and box 44 went to a
       sheet of its own. */
    main { padding: 0 !important; margin: 0 !important; }
    .v2-title { margin-top: 0 !important; }
    .v2-box:last-of-type { margin-bottom: 0 !important; }

    .v2-intro { display: none; }
    /* NO :global() WRAPPER HERE. This block is already `is:global`, and Astro
       leaves `:global(...)` in the output as a selector no browser matches — so
       the nav, the footer and the dated advisory banner all printed, ate the top
       of page one, and cost a whole extra sheet. The shipped table needs the
       wrapper because its block is scoped; this one must not have it. */
    .adv-banner, header.nav, footer.foot { display: none !important; }
    /* A WHOLE PAGE FOR THIRTY CHARACTERS. The layout's "last verified" line fell
       past the end of the last box and took a fifth sheet to say one date — and
       on THIS artifact the date is meaningless anyway: the BIP-39 wordlist is
       frozen by the standard, so a printed copy can never go stale. Saying it
       could is worse than saying nothing. */
    .verified { display: none !important; }

    /* TWO LINES AND NO MORE. The title is worth a page-one header but not worth
       a box: at three lines it pushed box 14 onto page two and cascaded into a
       fifth sheet holding one box. Paid for out of the first page's top margin
       (@page :first below) rather than out of the table. */
    /* ONE LINE. MEASURED. Box pitch is 175.5pt and four of them need to start by
       y=64.5 on a 792pt page, so the header may occupy 35.7pt and no more. Three
       lines cost 39pt and two cost 59 once the URL wrapped — either way one box
       falls to page two and drags a fifth sheet along holding a single box. */
    .v2-title { display: block; text-align: center; margin: 0 0 .3rem; }
    .v2-title-h { font-size: 11.5pt; margin: 0; color: #000; font-weight: 700; line-height: 1.15; }
    .v2-title-s { font-size: 8pt; font-weight: 400; color: #444; }
    .v2-title-s::before { content: " — "; color: #888; }
    .v2-title-u { font-size: 7.6pt; font-weight: 400; color: #666; font-family: var(--mono); }
    .v2-title-u::before { content: " · "; color: #888; }

    /* THREE TONES, LIGHTEST TO DARKEST, OUTSIDE IN: white page → light box →
       slightly darker card. The nesting is the whole point of this layout, so
       it should be visible without reading a single character.
       BOTH TINTS ARE DELIBERATELY PALE. At 6.6pt the text needs the contrast
       more than the panels need the presence, and a heavy fill behind 2,048
       small words prints muddy on anything but a good laser. */
    .v2-box { break-inside: avoid; background: #f7f7f7; border: .5pt solid #dcdcdc;
      border-radius: 3.5pt; padding: .34rem .38rem .4rem; margin: 0 0 .34rem; }
    /* The two-throw number, top left, sized to be found from across a desk —
       this is the thing you scan for first. */
    .v2-box-h { font-size: 11pt; margin: 0 0 .22rem; color: #000; font-weight: 700;
      letter-spacing: .04em; line-height: 1; }

    .v2-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: .34rem; }

    /* EACH THREE-THROW GROUP IS ITS OWN CARD, not just a heading over a list.
       Four cards side by side inside the box: you land on the box, then on one
       card, and the card boundary is what stops the eye sliding into the
       neighbouring column mid-lookup. */
    .v2-col { background: #e6e6e6; border: .5pt solid #c9c9c9; border-radius: 3pt;
      padding: .22rem .26rem .24rem; break-inside: avoid; }
    .v2-col-h { font-size: 7.4pt; margin: 0 0 .14rem; color: #000; font-weight: 700;
      letter-spacing: .03em; text-align: center; border-bottom: .5pt solid #b8b8b8;
      padding-bottom: .08rem; }

    .v2-rows { columns: 2; column-gap: .3rem; font-size: 6.8pt; line-height: 1.18; }
    .v2-rows li { color: #000; }
    /* The key stays grey so the WORD is what the eye lands on — the key is what
       you match, the word is what you write down. */
    .v2-k { color: #555; margin-right: .18rem; }

    /* MEASURED, not chosen. Box pitch is 176.2pt and the title is worth 39pt,
       so page one needed ~12pt more than the old 11mm margins gave it — one box
       short, and one box short costs a whole extra sheet holding a single box.
       9mm returns 11.3pt across the top and bottom.
       @page :first { margin-top } WAS TRIED FIRST AND IS IGNORED by headless
       Chrome — page one's content still began at the same y as page two's. Do
       not reach for it again; the margin has to come off every page. */
    @page { margin: 9mm 9mm; }
  }
</style>
