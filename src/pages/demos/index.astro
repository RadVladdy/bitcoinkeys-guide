---
import Base from '../../layouts/Base.astro';
import { demos } from '../../data/demos.js';
---
<Base
  title="Interactive demos — see how Bitcoin actually works · BitcoinKeys.guide"
  description="Hands-on demonstrations of the machinery under Bitcoin self-custody — seed generation, passphrases, BIP-85. Every one uses a throwaway seed generated in your browser. Never your real seed."
  verified="2026-08-04"
>
  <section class="prose">
    <p class="eyebrow">Tools &amp; demos</p>
    <h1>Interactive <span class="accent">demos</span></h1>
    <p class="lead">
      You don't need any of this to hold Bitcoin safely. But if you've read
      <a href="/learn/bitcoin-keys">how it all works</a> and want to <em>see</em> the machinery — not just read about it —
      here are {demos.length} demonstrations of what is really happening under the hood. Nothing is saved and
      nothing is scored: every one runs in your browser, on a seed it invents and forgets.
    </p>
    <div class="callout danger" role="note">
      <span class="label">🛑 Demonstrations only — never your real seed</span>
      <p style="margin:0">Every tool here <strong>generates a throwaway seed in your browser</strong> and forgets it when you leave.
        <strong>None of them will ever let you type your own seed words</strong> — that's the point. A site that asks for your seed is a site trying to rob you.</p>
    </div>
  </section>

  <section>
    <div class="cards">
      {demos.map((d) => (
        <a class="dcard" href={d.href}>
          <h3>{d.title}</h3>
          <p>{d.desc}</p>
          <span class="darrow">Open the demo →</span>
        </a>
      ))}
    </div>
    <p class="more mono">Each one runs entirely in your browser. More may follow.</p>
  </section>

  {/* No CTA row. There used to be one ("← How it all works" / "The ladder →"),
      a leftover from when the demos were course level 201 — a door into lesson 6
      from a tools page. Demos are a tool: readers arrive from a lesson or the
      menu and go back the way they came. */}

</Base>

<style>
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.6rem 0 0.8rem; }
  @media (max-width: 640px) { .cards { grid-template-columns: 1fr; } }
  .dcard { display: flex; flex-direction: column; gap: 0.4rem; text-decoration: none; color: var(--text);
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 1.3rem 1.4rem;
    transition: border-color .14s ease, transform .14s ease; }
  .dcard:hover { border-color: var(--accent); transform: translateY(-2px); }
  .dcard h3 { margin: 0.3rem 0 0; font-size: 1.1rem; }
  .dcard p { margin: 0; font-size: 0.92rem; color: var(--muted); line-height: 1.55; }
  .dcard .darrow { margin-top: 0.3rem; color: var(--accent); font-family: var(--mono); font-size: 0.85rem; }
  .more { color: var(--faint); font-size: 0.82rem; margin: 0.4rem 0 0; }
</style>
