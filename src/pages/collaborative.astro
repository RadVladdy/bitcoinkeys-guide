---
import Base from '../layouts/Base.astro';
import RuleRef from '../components/RuleRef.astro';
// TWO SECTIONS, NOT ONE LIST (2026-08-01). `savingsCustodians` is rung 4 of the
// ladder — a service holding the third key of a long-term vault. Bitkey is a
// collaborative-custody product too, and a good one, but it answers a different
// question: money you are spending, in a sealed single-vendor stack. Listed flat
// among the others it read as a candidate for "who should hold the third key of
// my savings", which it is not. Both lists are derived, and custodians.js throws
// if a service declares neither kind.
import {
  savingsCustodians, spendingCustodians, custodianBadges, custodianCompare, custodiansVerified,
} from '../data/custodians.js';

const mark = { yes: '✓', partial: '~', no: '✗' };
const markCls = { yes: 'y', partial: 'p', no: 'n' };
---
<Base
  title="Bitcoin collaborative custody, compared · BitcoinKeys.guide"
  description="An honest, independent comparison of Bitcoin collaborative custody services — Unchained, Nunchuk, Swan Vault, AnchorWatch, Bitkey, The Bitcoin Adviser. You keep 2 of 3 keys; a service holds one for recovery help. Includes how collaborative custody differs from multi-institution custody. No affiliate links. Compare by KYC, open-source recovery, insurance, and fees."
  verified={custodiansVerified}
>
  <section class="prose">
    <p class="eyebrow">Choose a partner</p>
    <h1>Bitcoin collaborative custody, compared <span class="accent">honestly</span></h1>
    <p class="lead">In collaborative custody you still hold <strong>two of three keys</strong> — a Bitcoin service holds the third as a safety net for recovery and inheritance. They <strong>can never move your coins alone.</strong> What you outsource is complexity, not custody. Because we take no affiliate money, this page can compare them plainly.</p>
    <div class="callout">
      <span class="label">The one test that matters most</span>
      <p>Before anything else, ask: <strong>if this company vanished tomorrow, could you still recover your Bitcoin on your own?</strong> With a reputable partner the answer is yes — your two keys plus the <a href="/glossary#wallet-descriptor">wallet descriptor</a> rebuild the wallet in open tools like Sparrow or Bitcoin Core. That "open-source recovery" badge is the difference between a helper and a dependency.</p>
    </div>
  </section>


  <div class="wtabs" id="ctabs" role="tablist" aria-label="Views" hidden>
    <button class="wtab active" id="tab-tiles" role="tab" aria-selected="true" type="button">Browse services</button>
    <button class="wtab" id="tab-ctable" role="tab" aria-selected="false" type="button">Comparison table</button>
  </div>

  <section id="ctiles">
    <p class="reach-legend"><strong>Badges</strong> — a fact about the service, not a ranking:
      <span class="tbadge y"><span class="tbm">✓</span> meets it</span>
      <span class="tbadge p"><span class="tbm">~</span> partly / caveat</span>
      <span class="tbadge n"><span class="tbm">✗</span> no</span>
    </p>
    <div class="cards">
      {savingsCustodians.map((c) => (
        <article class="wcard">
          <div class="wc-top">
            <div class="wc-main">
              <header>
                <div class="wc-title"><h3><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name} ↗</a></h3></div>
              </header>
              <p class="cmodel mono">{c.model}</p>
              <p class="best"><strong>Good fit:</strong> {c.bestFor}</p>
            </div>
          </div>
          <div class="tbadges">
            {custodianBadges.map((b) => {
              const r = c[b.key];
              const tip = (c.notes && c.notes[b.key]) || b.tip;
              return <span class:list={['tbadge', markCls[r]]} title={tip}><span class="tbm">{mark[r]}</span> {b.label}</span>;
            })}
            {c.insured === 'yes'
              ? <span class="tbadge ins" title={(c.notes && c.notes.insured) || 'Holdings are insured.'}><span class="tbm">⛨</span> Insured</span>
              : <span class="tbadge muted"><span class="tbm">—</span> Uninsured</span>}
          </div>
          <p class="watch"><strong>Watch out:</strong> {c.watch}</p>
          <div class="cmeta">
            <span class="cmeta-row"><span class="ck mono">Fee</span> {c.fee}</span>
            <span class="cmeta-row"><span class="ck mono">Minimum</span> {c.minimum}</span>
            <span class="cmeta-row"><span class="ck mono">Where</span> {c.jurisdiction}</span>
            <span class="cmeta-row"><span class="ck mono">Devices</span> {c.devices}</span>
          </div>
          <div class="wc-plan" data-slug={c.slug} hidden></div>
        </article>
      ))}
    </div>
  </section>

  <section id="ctable" hidden>
    <h2 class="prose">The full comparison</h2>
    <p class="scroll-hint">Swipe sideways to see every column →</p>
    <div class="scroll compare">
      <table>
        <thead>
          <tr><th>Service</th>{custodianCompare.map((c) => <th class="ctr">{c.label}</th>)}</tr>
        </thead>
        <tbody>
          {savingsCustodians.map((c) => (
            <tr>
              <td class="dev"><span class="dname">{c.name}</span></td>
              {custodianCompare.map((col) => (
                <td class="ctr">
                  {col.type === 'text'
                    ? <span class="num">{c[col.key]}</span>
                    : <span class:list={['mark', markCls[c[col.key]]]}>{mark[c[col.key]]}</span>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="legend mono"><span class="r-yes">✓</span> yes · <span class="r-partial">~</span> partial / caveat · <span class="r-no">✗</span> no</p>
  </section>

  {spendingCustodians.length > 0 && (
    <section class="prose sp-sec">
      <h2>A different kind: collaborative custody built for spending</h2>
      <p>
        Everything above is collaborative custody for <strong>savings</strong> — the fourth rung of
        <a href="/learn/ladder#rung-4"> the ladder</a>, where you assemble a vault, hold two keys yourself, and a
        service holds the third. {spendingCustodians.length === 1 ? 'The service below is' : 'The services below are'}
        genuinely collaborative custody too — a real 2-of-3, with a real third party — but built around
        <strong> money you are spending</strong> rather than money you are locking away for a decade.
      </p>
      <p>
        That is not a lesser thing, and it is not a warning. It is a different question, and mixing the two
        would make it look like a candidate for a job it is not applying for. We rate the hardware the same way
        on <a href="/wallets">the wallet comparison</a> — <a href="/standard#built-for-spending">built for
        spending</a> — and the two ratings are the same judgement, so the site refuses to build if they ever
        disagree.
      </p>
      {spendingCustodians.map((c) => (
        <div class="sp-card">
          <h3><a href={c.url} target="_blank" rel="noopener noreferrer">{c.name} ↗</a></h3>
          <p class="cmodel mono">{c.model}</p>
          <p><strong>Good fit:</strong> {c.bestFor}</p>
          <p class="sp-watch"><strong>Worth knowing:</strong> {c.watch}</p>
          <p class="sp-meta mono">{c.fee} · {c.devices}</p>
        </div>
      ))}
      <p class="sp-foot">
        Holding long-term savings? Use the comparison above instead — a sealed single-vendor stack is a
        different bet from a vault you assemble and could rebuild yourself.
      </p>
    </section>
  )}

  <section class="prose">
    <h2 id="vs-multi-institution">Collaborative custody vs multi-institution custody</h2>
    <p>
      These sound alike and they are not the same arrangement. The difference is one question:
      <strong>whose hands are the keys in?</strong>
    </p>
    <p>
      In <strong>collaborative custody</strong> — everything compared above — <strong>you hold two of the three
      keys.</strong> You can move your Bitcoin without asking anyone. The service holds one key, can never move
      your coins with it, and if the company disappears your two keys plus the
      <a href="/glossary#wallet-descriptor">wallet descriptor</a> rebuild the wallet in open tools.
    </p>
    <p>
      In <strong>multi-institution custody</strong>, the keys are distributed across several independent
      companies and <strong>you hold none of them.</strong> You authorise a transaction; institutions sign it.
      AnchorWatch — compared above for its <em>Flagship</em> vaults, where you do hold your own keys — also sells
      a Multi-Institution Custody vault: a 2-of-3 split across AnchorWatch, BitGo and CoinCorner, with no
      hardware wallet for you to set up or look after.
    </p>
    <p>
      <strong>What that genuinely buys is real, and it is worth naming plainly:</strong> no single company can
      move your coins, so the failure that takes down an ordinary custodian — one firm collapsing, freezing
      withdrawals or being compromised — does not take your Bitcoin with it. Three independent institutions
      failing together is a much smaller risk than one failing alone. There is also no seed phrase you can lose,
      no device to keep safe, and nothing to hand your heirs but instructions.
    </p>
    <p>
      <strong>What it costs is the thing this site exists to teach.</strong> Spreading counterparty risk across
      three companies is not the same as not having any — <RuleRef key="not-your-keys" /> still
      applies, because you cannot sign. Every path to your Bitcoin runs through someone else's willingness and
      ability to act, which is the dependency collaborative custody is arranged to remove.
      <RuleRef key="independent-things" label="The independence rule" /> asks for two <em>independent</em> things, and three regulated
      custodians sharing an industry, a jurisdiction and a legal climate are less independent than they look on
      a diagram.
    </p>
    <p class="sub">
      Which is to say: multi-institution custody is a considered answer to a real problem, and it is a different
      answer from the one on this page. If what you want is fewer things to manage, it delivers that. If what
      you want is to be able to move your own Bitcoin without permission, it does not — and no amount of
      institutional quality changes that, because it isn't a quality question.
    </p>

    <div class="callout safe">
      <span class="label">Collaborative isn’t the only way up</span>
      <p>Running your own <a href="/learn/ladder#rung-3">multisig (rung 3)</a> keeps every key in your hands — no company, no KYC, maximum privacy. Collaborative custody trades a little of that sovereignty for far less to manage and built-in recovery. Neither is “more correct” — it’s a real trade-off. Not sure which fits? <a href="/find-your-setup">Find your setup →</a></p>
    </div>

    <p class="sub">Verify, don’t trust — including us. Fees and KYC policies change; we re-check them on a schedule and log every change in the <a href="/changelog">what’s-changed log</a>. Always confirm the current terms on the provider’s own site before committing.</p>
  </section>
</Base>

<script>
  // View tabs (progressive enhancement).
  const ctabs = document.getElementById('ctabs');
  const tabTiles = document.getElementById('tab-tiles');
  const tabTable = document.getElementById('tab-ctable');
  const panelTiles = document.getElementById('ctiles');
  const panelTable = document.getElementById('ctable');
  if (ctabs && panelTiles && panelTable) {
    const show = (tiles) => {
      panelTiles.hidden = !tiles; panelTable.hidden = tiles;
      tabTiles.classList.toggle('active', tiles); tabTable.classList.toggle('active', !tiles);
      tabTiles.setAttribute('aria-selected', String(tiles)); tabTable.setAttribute('aria-selected', String(!tiles));
    };
    ctabs.hidden = false;
    tabTiles.addEventListener('click', () => show(true));
    tabTable.addEventListener('click', () => show(false));
    show(true);
  }
</script>

<script>
  // Per-tile plan control: pick this service as your plan's collaborative custodian.
  import { setCustodian, getCustodian, hasPlannedSetup } from '../data/plan.js';

  function ctoast(msg, kind) {
    const t = document.createElement('div');
    t.className = `w-toast ${kind || ''}`; t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 2600);
  }

  function paintCustodianControls() {
    const chosen = getCustodian();
    document.querySelectorAll('.wc-plan').forEach((el) => {
      const slug = el.dataset.slug;
      const isChosen = chosen === slug;
      el.hidden = false;
      el.innerHTML = `<button class="wcp-btn wcp-cust ${isChosen ? 'on' : ''}" type="button">${isChosen ? '★ Your custodian' : '☆ Make this my custodian'}</button>`;
      el.querySelector('.wcp-cust').addEventListener('click', () => {
        setCustodian(slug);
        const nowChosen = getCustodian() === slug;
        ctoast(nowChosen ? 'Set as your plan’s custodian' : 'Removed from your plan', 'ok');
        if (nowChosen && !hasPlannedSetup()) ctoast('Tip: find your setup to build the rest of your plan', '');
        paintCustodianControls();
      });
    });
  }
  paintCustodianControls();
</script>

<style>
  /* The spending section is deliberately NOT a wcard — it must not read as a
     sixth entry in the comparison it sits below. Different container, no badge
     grid, no comparison row. */
  .sp-sec { margin-top: 2.4rem; }
  .sp-card { border: 1px solid var(--line); border-left: 3px solid var(--warn, #b7791f); border-radius: var(--radius);
    padding: 1.1rem 1.3rem; margin: 1.2rem 0; background: var(--surface-2, var(--raise)); }
  .sp-card h3 { margin: 0 0 .3rem; font-size: 1.08rem; }
  .sp-card p { margin: 0 0 .55rem; }
  .sp-watch { color: var(--muted); font-size: .92rem; }
  .sp-meta { color: var(--faint); font-size: .78rem; margin: 0 !important; }
  .sp-foot { color: var(--muted); font-size: .9rem; }
  /* View tabs */
  .wtabs { display: inline-flex; gap: 0.25rem; margin: 0 0 1.6rem; padding: 0.25rem; border: 1px solid var(--line); border-radius: 0.6rem; background: var(--surface); }
  .wtab { font-family: var(--sans); font-size: 0.92rem; color: var(--muted); cursor: pointer; background: none; border: 0; border-radius: 0.45rem; padding: 0.5rem 1.05rem; transition: background 0.15s, color 0.15s; }
  .wtab:hover { color: var(--accent); }
  .wtab.active { background: var(--accent); color: var(--accent-ink); font-weight: 600; }
  #ctiles[hidden], #ctable[hidden] { display: none; }

  /* Tiles */
  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.4rem; }
  @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
  .wcard { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.2rem 1.3rem; background: var(--surface); }
  .wc-top { display: flex; gap: 1.1rem; align-items: flex-start; margin-bottom: 0.6rem; }
  .wc-main { flex: 1 1 auto; min-width: 0; }
  .wcard header { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; margin-bottom: 0.4rem; }
  .wcard h3 { margin: 0; font-size: 1.05rem; }
  .wcard h3 a { color: var(--text); text-decoration: none; }
  .wcard h3 a:hover { color: var(--accent); }
  .wcard .price { color: var(--accent); font-size: 0.85rem; font-family: var(--mono); text-align: right; flex: 0 0 auto; }
  .wcard p { margin: 0 0 0.5rem; font-size: 0.92rem; color: var(--muted); }
  .wcard .best strong { color: var(--safe); }
  .wcard .watch strong { color: var(--warn); }

  /* Trust badges */
  .tbadges { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 0.75rem; }
  .tbadge { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; font-family: var(--mono);
    border: 1px solid var(--line); border-radius: 0.4rem; padding: 0.18rem 0.5rem; cursor: help; }
  .tbadge .tbm { font-weight: 700; }
  .tbadge.y { color: var(--safe); border-color: color-mix(in srgb, var(--safe) 40%, var(--line)); background: var(--safe-dim); }
  .tbadge.p { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, var(--line)); background: var(--warn-dim); }
  .tbadge.n { color: var(--faint); border-color: var(--line); background: transparent; text-decoration: line-through; text-decoration-color: var(--danger); }

  /* Comparison table */
  .scroll { overflow-x: auto; }
  .compare table { min-width: 44rem; border-collapse: collapse; width: 100%; }
  .compare th, .compare td { border-bottom: 1px solid var(--line-soft); padding: 0.6rem 0.7rem; font-size: 0.86rem; text-align: left; vertical-align: top; }
  .compare th { color: var(--faint); font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; }
  /* .scroll-hint lives in global.css — every wide table shares it. */
  .ctr { text-align: center; }
  .dev { min-width: 9rem; }
  .dname { display: block; font-weight: 650; color: var(--text); }
  .mark { display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; font-weight: 700; font-family: var(--mono); }
  .r-yes { color: var(--safe); } .mark.r-yes { background: var(--safe-dim); }
  .r-partial { color: var(--warn); } .mark.r-partial { background: var(--warn-dim); }
  .r-no { color: var(--danger); } .mark.r-no { background: var(--danger-dim); }
  .legend { font-size: 0.8rem; margin-top: 0.9rem; display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; }
  .legend .r-yes, .legend .r-partial, .legend .r-no { font-weight: 700; }

  .cmodel { color: var(--accent); font-size: 0.82rem; margin: 0.2rem 0 0.6rem; line-height: 1.4; }
  .cmeta { display: grid; gap: 0.35rem; margin: 0.8rem 0 0; padding-top: 0.75rem; border-top: 1px solid var(--line-soft); }
  .cmeta-row { font-size: 0.85rem; color: var(--muted); }
  .cmeta .ck { display: inline-block; min-width: 4.5rem; color: var(--faint); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .tbadge.ins { color: var(--safe); border-color: color-mix(in srgb, var(--safe) 45%, var(--line)); background: var(--safe-dim); }
  .tbadge.muted { color: var(--faint); border-color: var(--line); background: transparent; }
  .reach-legend { font-size: 0.85rem; color: var(--muted); display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin: 1.2rem 0 0.4rem; }
</style>

<style is:global>
  /* Plan control injected by JS → global styles (shared w/ wallets' .wcp-btn / .w-toast). */
  #ctiles .wc-plan { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; padding-top: 0.8rem; border-top: 1px solid var(--line-soft); }
  .wcp-cust { font-family: var(--sans); font-size: 0.82rem; cursor: pointer; background: var(--raise);
    border: 1px solid var(--line); border-radius: 2rem; padding: 0.4rem 0.85rem; color: var(--text);
    transition: border-color 0.15s, background 0.15s, color 0.15s; }
  .wcp-cust:hover { border-color: var(--accent); }
  .wcp-cust.on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); font-weight: 600; }

  .w-toast { position: fixed; left: 50%; bottom: 1.6rem; transform: translateX(-50%) translateY(1rem);
    background: var(--surface-2); color: var(--text); border: 1px solid var(--line); border-radius: 0.6rem;
    padding: 0.7rem 1.1rem; font-size: 0.9rem; box-shadow: var(--shadow); opacity: 0; z-index: 50;
    transition: opacity 0.25s, transform 0.25s; max-width: min(92vw, 26rem); text-align: center; }
  .w-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  .w-toast.ok { border-color: var(--safe); }
  .w-toast.err { border-color: var(--warn); }


  /* An author `display:` beats the UA rule for [hidden], so a class that sets one
     renders an EMPTY BOX while the attribute says hidden. #plan-nudge did exactly
     that on /wallets and /collaborative — a stray green pill every first-time
     visitor saw, since the nudge only un-hides once you have a plan. The same trap
     was already guarded for #chooser/#cmp-table in this file; it just was not
     applied to the rest. */
  .wc-plan[hidden], .wtabs[hidden] { display: none !important; }
</style>
