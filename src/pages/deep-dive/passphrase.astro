---
import Base from '../../layouts/Base.astro';
import '../../styles/demo.css';
---
<Base
  title="The passphrase (25th word) — watch the wallet change · BitcoinKeys.guide"
  description="A safe demonstration of how a BIP-39 passphrase — the optional '25th word' — turns one seed into a completely different wallet. Throwaway seed, generated in your browser. No seed input, on purpose."
>
  <section class="prose">
    <p class="eyebrow">Deeper dive · a demonstration</p>
    <h1>The passphrase: one seed, <span class="accent">many wallets</span></h1>
    <p class="lead">
      A <a href="/glossary#passphrase-25th-word">passphrase</a> — the optional "25th word" — is the most
      misunderstood feature in Bitcoin. This shows you exactly what it does: take one seed, add a passphrase,
      and you land in an <em>entirely different wallet</em>. Change the passphrase, change the wallet.
    </p>

    <div class="callout danger" role="note">
      <span class="label">🛑 A demonstration — never your real seed</span>
      <p style="margin:0">The seed below is <strong>randomly generated in your browser</strong> and thrown away when you leave.
        <strong>Never type your real seed words anywhere.</strong> There's no seed input here on purpose.</p>
    </div>
  </section>

  <section>
    <div class="demo" id="pp">
      <div id="intro" class="intro">
        <p class="intro-lead">Generate a throwaway seed, then try a passphrase on it.</p>
        <button id="go" class="btn-go" type="button">🎲 Generate a throwaway seed</button>
        <p class="intro-note mono">Runs entirely in your browser · nothing is sent, saved, or logged.</p>
      </div>
      <div id="result" hidden>
        <p class="lbl mono">Your throwaway 12-word seed</p>
        <div class="words" id="words"></div>
        <p class="demo-cap" style="text-align:center;margin-bottom:0.8rem">Now add a passphrase and watch the address change:</p>
        <div class="chips" id="chips"></div>
        <div class="flow" style="margin-top:1.1rem">
          <div class="fbox"><span class="fh">seed + passphrase</span><span class="fv" id="pass"></span></div>
          <span class="farrow">↓ opens…</span>
          <div class="fbox addr"><span class="fh">a completely different wallet — first address</span><span class="fv addrv" id="addr"></span></div>
        </div>
        <div class="callout warn" style="margin-top:1.2rem">
          <span class="label">Why this matters</span>
          <p style="margin:0"><strong>“No passphrase” is the decoy</strong> — anyone who finds your 12 words sees only that wallet.
            <strong>The passphrase is what opens the hidden one</strong>, which is why it has to be backed up as carefully as the
            seed and stored somewhere the seed isn't. There is no reset button: forget the passphrase and that wallet is gone
            forever, so keeping it only in your head is the one way this setup reliably fails.</p>
        </div>
        <button class="btn-regen" id="regen" type="button">↻ Roll a different seed</button>
      </div>
    </div>
  </section>

  <section class="prose">
    <p class="cta-row">
      <a class="btn" href="/learn/ladder#rung-2">← The passphrase rung</a>
      <a class="btn ghost" href="/deep-dive/seed">Watch a seed get born →</a>
      <a class="btn ghost" href="/deep-dive">All deeper dives →</a>
    </p>
  </section>
</Base>

<script>
  let libs = null;
  async function loadLibs() {
    if (libs) return libs;
    const [bip39, bip32, btc] = await Promise.all([import('@scure/bip39'), import('@scure/bip32'), import('@scure/btc-signer')]);
    const en = await import('@scure/bip39/wordlists/english.js');
    libs = { generateMnemonic: bip39.generateMnemonic, mnemonicToSeedSync: bip39.mnemonicToSeedSync, wordlist: en.wordlist, HDKey: bip32.HDKey, p2wpkh: btc.p2wpkh };
    return libs;
  }
  const $ = (id) => document.getElementById(id);
  const esc = (s) => { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
  const PHRASES = ['', 'pizza', 'correct horse', 'moon 2024'];
  let mnemonic = '', selected = '';

  function addressFor(pass) {
    const { mnemonicToSeedSync, HDKey, p2wpkh } = libs;
    const seed = mnemonicToSeedSync(mnemonic, pass);
    return p2wpkh(HDKey.fromMasterSeed(seed).derive("m/84'/0'/0'/0/0").publicKey).address;
  }
  function paint() {
    $('pass').innerHTML = selected === '' ? '<span class="cs">(no passphrase — the decoy)</span>' : `<span class="cs">+ “${esc(selected)}”</span>`;
    $('addr').textContent = addressFor(selected);
    document.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.p === selected)));
  }
  async function generate() {
    const { generateMnemonic, wordlist } = await loadLibs();
    mnemonic = generateMnemonic(wordlist, 128);
    selected = '';
    $('words').innerHTML = mnemonic.split(' ').map((w, i) => `<span class="word"><span class="wi">${i + 1}</span>${esc(w)}</span>`).join('');
    $('chips').innerHTML = PHRASES.map((p) => `<button class="chip" type="button" data-p="${esc(p)}">${p === '' ? 'no passphrase' : '+ “' + esc(p) + '”'}</button>`).join('');
    document.querySelectorAll('.chip').forEach((c) => c.addEventListener('click', () => { selected = c.dataset.p; paint(); }));
    $('intro').hidden = true; $('result').hidden = false;
    paint();
  }
  $('go').addEventListener('click', () => { $('go').disabled = true; generate().catch((e) => { $('go').disabled = false; console.error(e); }); });
  $('regen').addEventListener('click', () => generate());
</script>

<style>
  .lbl { color: var(--faint); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; text-align: center; margin: 0 0 0.6rem; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.2rem; }
  .btn { display: inline-flex; align-items: center; background: var(--accent); color: var(--accent-ink); font-weight: 700;
    font-family: var(--mono); font-size: 0.9rem; padding: 0.65rem 1rem; border-radius: 0.6rem; text-decoration: none; }
  .btn.ghost { background: transparent; color: var(--text); border: 1px solid var(--line); }
  .btn.ghost:hover { border-color: var(--accent); color: var(--accent); }
</style>
