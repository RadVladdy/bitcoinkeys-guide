---
import Base from '../../layouts/Base.astro';
import '../../styles/demo.css';

// The written explanation lived here for about an hour on 2026-07-30, when the ladder
// merge had nowhere else to put it. It now has somewhere: /learn/beyond-the-ladder, a
// 102 lesson covering BIP-85 and Shamir together. The lesson explains, the demo shows — so
// this page is the demo plus its caveat, and it links back to the lesson.
---
<Base
  title="Split a secret into shares — the Shamir math behind SLIP-39 · BitcoinKeys.guide"
  description="An interactive demonstration of Shamir's Secret Sharing: split a throwaway secret into five shares where any three rebuild it and any two reveal nothing. The real math behind SLIP-39 seed backups, running in your browser."
  verified="2026-07-30"
>
  <section class="prose">
    <p class="eyebrow">Deeper dive · a demonstration</p>
    <h1>Split a secret into <span class="accent">shares</span></h1>
    <p class="lead">
      What if you could cut a backup into five pieces, hand them to five people, and know that <strong>any three</strong> together
      can rebuild it — but <strong>any two</strong> reveal literally nothing? That's <strong>Shamir's Secret Sharing</strong>,
      the math behind <strong>SLIP-39</strong> seed backups. Split a throwaway secret below and try it.
    </p>
    <div class="callout danger" role="note">
      <span class="label">🛑 A demonstration — never your real seed</span>
      <p style="margin:0">The secret below is <strong>randomly generated in your browser</strong> and thrown away when you leave.
        <strong>Never split or enter your real seed on any website.</strong> Real SLIP-39 backups are created offline on your signing device.</p>
    </div>
  </section>

  <section>
    <div class="demo" id="sh-demo">
      <div id="intro" class="intro">
        <p class="intro-lead">Generate a throwaway secret and split it into a 3-of-5 backup.</p>
        <button id="go" class="btn-go" type="button">🎲 Generate &amp; split a secret</button>
        <p class="intro-note mono">Runs entirely in your browser · nothing is sent, saved, or logged.</p>
      </div>

      <div id="result" hidden>
        <div class="fbox" style="max-width:none">
          <span class="fh">the original secret (128 bits — imagine this is your seed)</span>
          <span class="fv mono secret" id="secret"></span>
        </div>

        <p class="demo-cap" style="text-align:center;margin:1.2rem 0 0.6rem">
          It's split into <strong>5 shares</strong>. Tap the ones you <em>hold</em> — you need any <strong>3</strong> to rebuild it:
        </p>
        <div class="shares" id="shares"></div>

        <div class="recon" id="recon"></div>

        <div class="callout" style="margin-top:1.3rem">
          <span class="label">Why this beats a single backup</span>
          <p style="margin:0">No single share is a target — steal one, or two, and you get <strong>nothing</strong> (not "most of it" —
            <em>nothing</em>). Yet you can <strong>lose two shares entirely</strong> and still recover. Spread them across locations or
            trusted people and no one place is a single point of failure, for loss <em>or</em> theft.</p>
        </div>
        <button class="btn-regen" id="regen" type="button">↻ New secret</button>
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="callout">
      <span class="label">The honest caveat</span>
      <p style="margin:0">Splitting adds moving parts: more pieces to track, and a wrong threshold can lock <em>you</em> out. Most people are
        better served by a simple, well-guarded seed or <a href="/learn/ladder#rung-3">multisig</a> first. Shamir/SLIP-39 shines when you
        specifically want a <em>backup</em> spread across places without any one being enough.</p>
    </div>
    <p class="cta-row">
      <a class="btn" href="/learn/beyond-the-ladder">← Read the lesson on Shamir</a>
      <a class="btn ghost" href="/deep-dive/multisig">Multisig vs. this →</a>
      <a class="btn ghost" href="/deep-dive">All deeper dives →</a>
    </p>
  </section>
</Base>

<script>
  // --- GF(256) arithmetic (Rijndael field 0x11b, generator 0x03) ---
  const EXP = new Uint8Array(512), LOG = new Uint8Array(256);
  (function () {
    let x = 1;
    for (let i = 0; i < 255; i++) {
      EXP[i] = x;
      LOG[x] = i;
      // x = x * 3 in GF(256): 3*x = x ^ (x<<1)
      let t = x ^ ((x << 1) & 0xff);
      if (x & 0x80) t ^= 0x1b;
      x = t & 0xff;
    }
    for (let i = 255; i < 512; i++) EXP[i] = EXP[i - 255];
  })();
  const mul = (a, b) => (a === 0 || b === 0) ? 0 : EXP[LOG[a] + LOG[b]];
  const div = (a, b) => (a === 0) ? 0 : EXP[(LOG[a] - LOG[b] + 255) % 255];

  // Split one byte-secret into n shares, threshold t. Returns [{x, y[]}].
  function split(secret, n, t) {
    const shares = [];
    for (let x = 1; x <= n; x++) shares.push({ x, y: new Uint8Array(secret.length) });
    for (let b = 0; b < secret.length; b++) {
      const coeffs = new Uint8Array(t);
      coeffs[0] = secret[b];
      const rnd = crypto.getRandomValues(new Uint8Array(t - 1));
      for (let i = 1; i < t; i++) coeffs[i] = rnd[i - 1];
      for (const s of shares) {
        let acc = 0, xp = 1;
        for (let i = 0; i < t; i++) { acc ^= mul(coeffs[i], xp); xp = mul(xp, s.x); }
        s.y[b] = acc;
      }
    }
    return shares;
  }
  // Reconstruct the secret (value at x=0) from >=t shares via Lagrange interpolation.
  function reconstruct(shares, len) {
    const out = new Uint8Array(len);
    for (let b = 0; b < len; b++) {
      let acc = 0;
      for (let j = 0; j < shares.length; j++) {
        let num = 1, den = 1;
        for (let m = 0; m < shares.length; m++) {
          if (m === j) continue;
          num = mul(num, shares[m].x);            // (0 - x_m) = x_m in GF(2^8)
          den = mul(den, shares[j].x ^ shares[m].x); // (x_j - x_m) = x_j XOR x_m
        }
        acc ^= mul(shares[j].y[b], div(num, den));
      }
      out[b] = acc;
    }
    return out;
  }

  const $ = (id) => document.getElementById(id);
  const hex = (u8) => [...u8].map((b) => b.toString(16).padStart(2, '0')).join('');
  const N = 5, T = 3;
  let secret = null, shares = [], held = [];

  function paintShares() {
    $('shares').innerHTML = shares.map((s, i) => `<button class="share${held[i] ? ' held' : ''}" type="button" data-i="${i}">
      <span class="sh-ico">${held[i] ? '📄' : '▫'}</span>
      <span class="sh-name">Share ${i + 1}</span>
      <span class="sh-val mono">${hex(s.y).match(/.{1,2}/g).slice(0, 6).join(' ')}…</span>
      <span class="sh-state">${held[i] ? '✓ you hold this' : 'tap if you have it'}</span></button>`).join('');
    $('shares').querySelectorAll('.share').forEach((c) => c.addEventListener('click', () => {
      const i = +c.dataset.i; held[i] = !held[i]; paintShares(); recon();
    }));
  }
  function recon() {
    const sel = shares.filter((_, i) => held[i]);
    const el = $('recon');
    if (sel.length < T) {
      el.className = 'recon no';
      el.innerHTML = `<span class="r-count mono">${sel.length} of ${T} shares</span>
        <span class="r-msg">✗ Not enough — this reveals <strong>nothing</strong> about the secret</span>
        <span class="r-val mono masked">•• •• •• •• •• •• •• •• •• •• •• •• •• •• •• ••</span>`;
      return;
    }
    const got = reconstruct(sel, secret.length);
    const ok = hex(got) === hex(secret);
    el.className = 'recon ok';
    el.innerHTML = `<span class="r-count mono">${sel.length} of ${N} shares combined</span>
      <span class="r-msg">✓ Rebuilt the secret${ok ? '' : ' (mismatch!)'}</span>
      <span class="r-val mono">${hex(got)}</span>`;
  }
  function generate() {
    secret = crypto.getRandomValues(new Uint8Array(16));
    shares = split(secret, N, T);
    held = [true, true, true, false, false];
    $('secret').textContent = hex(secret);
    paintShares(); recon();
    $('intro').hidden = true; $('result').hidden = false;
  }
  $('go').addEventListener('click', () => { try { generate(); } catch (e) { console.error(e); } });
  $('regen').addEventListener('click', () => generate());
</script>

<style>
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.2rem; }
  .btn { display: inline-flex; align-items: center; background: var(--accent); color: var(--accent-ink); font-weight: 700;
    font-family: var(--mono); font-size: 0.9rem; padding: 0.65rem 1rem; border-radius: 0.6rem; text-decoration: none; }
  .btn.ghost { background: transparent; color: var(--text); border: 1px solid var(--line); }
  .btn.ghost:hover { border-color: var(--accent); color: var(--accent); }
</style>

<style is:global>
  #sh-demo .secret { color: var(--accent); font-size: 0.9rem; word-break: break-all; }
  #shares { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.6rem; }
  @media (max-width: 640px) { #shares { grid-template-columns: repeat(2, 1fr); } }
  #shares .share { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; cursor: pointer;
    background: var(--surface-2); border: 1px solid var(--line); border-radius: 0.7rem; padding: 0.8rem 0.5rem; text-align: center; }
  #shares .share:hover { border-color: var(--accent); }
  #shares .share.held { border-color: var(--safe); background: color-mix(in srgb, var(--safe) 9%, var(--surface-2)); }
  #shares .sh-ico { font-size: 1.3rem; }
  #shares .sh-name { font-weight: 650; font-size: 0.9rem; }
  #shares .sh-val { color: var(--faint); font-size: 0.62rem; }
  #shares .sh-state { font-size: 0.7rem; color: var(--muted); }
  #shares .share.held .sh-state { color: var(--safe); font-weight: 600; }
  .recon { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; margin-top: 1.2rem; padding: 1rem;
    border-radius: 0.6rem; border: 1px solid var(--line); text-align: center; }
  .recon.ok { border-color: var(--safe); background: var(--safe-dim); }
  .recon.no { border-color: var(--warn); background: var(--warn-dim); }
  .recon .r-count { color: var(--faint); font-size: 0.78rem; }
  .recon .r-msg { font-weight: 700; font-size: 1.02rem; }
  .recon.ok .r-msg { color: var(--safe); }
  .recon.no .r-msg { color: var(--warn); }
  .recon .r-val { font-size: 0.82rem; word-break: break-all; margin-top: 0.2rem; }
  .recon .r-val.masked { color: var(--faint); letter-spacing: 0.1em; }
  .recon.ok .r-val { color: var(--safe); }
</style>
