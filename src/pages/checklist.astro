---
import Base from '../layouts/Base.astro';
import { checklistGroups, checklistCount, ruleForItem } from '../data/checklist.js';
import { finderPromiseCap } from '../data/finder-questions.js';
import { ruleCountWord } from '../data/rules.js';

// GENERATED CHECKLIST (2026-07-28). Every item is server-rendered, so the page
// works with no JavaScript and search engines see the whole list. When a saved plan
// exists, the client HIDES the items that don't apply, names the visitor's own
// devices, and highlights ONE next action — it never injects markup that wasn't
// already here. That keeps a single source of truth for the content.
//
// THREE MUTUALLY EXCLUSIVE HEADERS sit above the list, switched by that client script:
//   #cl-nudge   — nothing saved: the one door to a personalized list.
//   #cl-partial — a setup chosen but the plan unfinished: says what is still missing.
//   #cl-yours   — plan saved AND complete: the personalized header.
// Recorded here rather than beside each one, because an HTML comment in template
// position is output and ships to every reader.
// A step's link is usually to the lesson behind it, but not always. Derive the
// wording from the target so a label can never promise the wrong kind of page —
// the hardcoded "Read the lesson" was doing exactly that on FIVE steps: two point
// at /collaborative, one at /wallets, one at an interactive demo, and the metal
// step at /metal-backups. Only the first of those is a lesson.
const linkLabel = (href) =>
  href.startsWith('/learn/') ? 'Read the lesson →'
  : href.startsWith('/demos/') ? 'Try the demo →'
  : 'See the guide →';

const groups = checklistGroups;
const total = checklistCount;
---
<Base
  title="Your self-custody checklist · BitcoinKeys.guide"
  description="A plain-English Bitcoin self-custody checklist that adapts to your setup: what to do first, what to do next, and what to review every year. Find your setup and it becomes yours — device-neutral, nothing to sell you."
  verified="2026-07-31"
>
  <section class="prose">
    <p class="eyebrow">Checklist</p>
    <h1 id="cl-h1">The self-custody <span class="accent">checklist</span></h1>
    <p class="lead" id="cl-lead">Everything that matters, in the order that matters. Tick items as you go; your progress saves to your own plan automatically.</p>

    <div class="callout" id="cl-nudge">
      <span class="label">Make this yours</span>
      <p>This is the full list — everything that could matter to anyone. <strong><a href="/find-your-setup">Find your setup</a> and this page becomes your checklist:</strong> only the steps your setup actually needs, in your order, with your own hardware named and one clear next action. {finderPromiseCap}, and we never ask how much Bitcoin you hold.</p>
    </div>

    <div class="callout warn" id="cl-partial" hidden>
      <span class="label" id="cl-partial-k">Your plan isn’t finished yet</span>
      <p id="cl-partial-p"></p>
    </div>

    <div class="yours" id="cl-yours" hidden>
      <p class="y-k mono">Your checklist</p>
      <h2 class="y-h" id="cl-yours-h"></h2>
      <p class="y-sub" id="cl-yours-sub"></p>
      <div class="y-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" id="cl-bar-wrap"><span class="y-fill" id="cl-bar"></span></div>
      <p class="y-count mono" id="cl-yours-count"></p>
    </div>

    <p class="sub">Each item links to the lesson behind it — or, where the step is a purchase, to the page that compares your options. This is the map; the course is the detail. Where a step <em>is</em> one of <a href="/learn/rules">the {ruleCountWord} rules</a>, it says which — so you can see the course and this list are the same advice, once as reading and once as doing. Your ticks are kept <strong>in your browser</strong> and go nowhere unless you deliberately save your plan somewhere else — <strong>we never see them either way</strong>. Clear them any time on <a href="/my-plan">your plan</a>.</p>
  </section>

  {groups.map((g) => (
    <section class="cgroup" data-phase={g.key}>
      {/* Native details/summary so a long page can be folded phase by phase — open
          by default (the page is a list to work down, not an accordion), no JS
          state. markNext() re-opens any phase holding the "Next up" item. */}
      <details class="cg-fold" open>
        <summary class="grouphead">
          <span class="gtag">{g.tag}</span>
          <h2>{g.title}</h2>
          <svg class="g-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <p class="sub g-intro">{g.intro}</p>
        <ul class="clist">
        {g.items.map((it) => (
          <li
            class="citem"
            data-id={it.id}
            data-only={it.only ? it.only.join(' ') : null}
            data-needs={it.needs ?? null}
            data-done={it.done ? 'true' : null}
            data-device-slot={it.deviceSlot ? 'true' : null}
          >
            <button class="box" type="button" role="checkbox" aria-checked="false" aria-label={it.t}>
              <svg class="tick" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
            <div class="ctext">
              {/* The emphasis chip + why line ship hidden on EVERY item and are
                  filled/unhidden by the client only when the saved plan's risk
                  assessment flags the step's concern — same single-source rule
                  as the rest of this page: the client never injects markup. */}
              <span class="ct-title">{it.t}<span class="ct-dev" hidden></span><span class="ct-flag mono" hidden>matters extra for you</span></span>
              <span class="ct-desc">{it.d}</span>
              <span class="ct-why" hidden></span>
              <span class="ct-links">
                {it.href && <a href={it.href} class="ct-link">{linkLabel(it.href)}</a>}
                {ruleForItem(it) && (
                  <a class="ct-rule mono" href={`/learn/rules#rule-${ruleForItem(it).n}`}>
                    Rule {String(ruleForItem(it).n).padStart(2, '0')} · {ruleForItem(it).short}
                  </a>
                )}
              </span>
            </div>
            <span class="ct-next mono" hidden>Next up</span>
          </li>
        ))}
        </ul>
      </details>
    </section>
  ))}

  <section>
    <div class="savebar" id="savebar">
      <div class="sb-count"><span id="sb-n">0</span> of <span id="sb-total">{total}</span> done <span class="sb-auto mono" id="sb-auto" hidden>· ✓ saved to your plan</span></div>
      <div class="sb-actions">
        <a class="sb-link" href="/my-plan">View your plan →</a>
      </div>
    </div>
    <p class="sb-status mono" id="sb-status" hidden></p>
  </section>

  <section class="prose">
    <div class="callout safe">
      <span class="label">The whole thing in one breath</span>
      <p>Get it off the exchange onto a device you control · back the seed up on metal in two places · <strong>test the backup before you trust it</strong> · don’t talk about your Bitcoin · and leave a plan your family can follow. Do those five and you’re ahead of almost everyone.</p>
    </div>
  </section>
</Base>

<script>
  import { loadLocal, saveChecklistSlice } from '../data/plan.js';
  import { itemApplies, concernEmphasis } from '../data/checklist.js';
  import { scoreWord, scoreFromPrompts, shimScores } from '../data/finder.js';
  import { getRung } from '../data/ladder.js';
  import { ownedName, assessDevices, keysForSetup } from '../data/wallets.js';
  import { diceAdviceFor } from '../data/dice.js';

  const checked = {};
  const items = Array.from(document.querySelectorAll('.citem'));
  const elN = document.getElementById('sb-n');
  const elTotal = document.getElementById('sb-total');
  const elAuto = document.getElementById('sb-auto');

  const plan = loadLocal();

  // ── Read the plan into the small context the filter needs ──────────────────
  // Target setup comes from the quiz; if there's no quiz result we fall back to
  // wherever the ladder self-locator placed them. 'pre' means "not on the ladder
  // yet", which is a starting point, not a destination — treat it as no target.
  function planContext(p) {
    if (!p) return null;
    const quizRung = p.quiz && p.quiz.rung;
    const ladderRung = p.ladder && p.ladder.rung;
    const rung = quizRung || ladderRung || null;
    if (!rung || rung === 'pre') return null;
    const recovery = (p.quiz && p.quiz.answers && p.quiz.answers.recovery) || null;
    return {
      rung,
      heirs: recovery === 'partner' || recovery === 'heirs',
      custodian: Boolean(p.custodian) || rung === 'collaborative',
      label: (p.quiz && p.quiz.primaryLabel) || null,
      devices: (p.quiz && Array.isArray(p.quiz.plannedDevices) ? p.quiz.plannedDevices : []),
      owned: Array.isArray(p.owned) ? p.owned : [],
    };
  }
  // Is the saved plan actually finished? Mirrors planGaps() on /my-plan — a plan
  // missing a hardware wallet, or a collaborative plan missing its custodian, is a
  // plan in progress. An unfinished plan does NOT personalize this page: the full
  // list is shown, honestly labelled, with a pointer back to the step that finishes
  // it. Trimming and calling it "your checklist" would be claiming a tailoring that
  // has not happened.
  function planGap(p) {
    if (!p || !p.quiz || !p.quiz.rung) return null;
    // The custodian gap is checked FIRST on a collaborative plan: the service comes
    // before the hardware (it decides which devices you can even use), and the quiz
    // says so in as many words. Mirrors planGaps() on /my-plan.
    if (p.quiz.rung === 'collaborative' && !p.custodian) {
      return { what: 'a collaborative custodian', href: '/collaborative', cta: 'Compare custodians' };
    }
    const need = keysForSetup({ rungSlug: p.quiz.rung, label: p.quiz.primaryLabel, tier: p.quiz.primaryTier });
    const assigned = (Array.isArray(p.quiz.plannedDevices) ? p.quiz.plannedDevices : []).filter(Boolean);
    const missing = Math.max(0, need - assigned.length);
    if (missing > 0) {
      return {
        what: missing === 1 ? 'a hardware wallet' : `${missing} more hardware wallets`,
        href: '/wallets', cta: 'Compare wallets',
      };
    }
    return null;
  }
  const gap = planGap(plan);
  const ctx = gap ? null : planContext(plan);

  // ── Risk-assessment emphasis: which concerns run elevated/high for this plan ─
  // The saved answers can carry the picture three ways, newest first: explicit
  // scores (the review screen's word is the user's word — hand adjustments and
  // all), checked prompts (derive exactly as the finder does), or a legacy
  // ranked worries[] (shimmed, exactly as /find-your-setup shims it on load).
  // None of the three → no emphasis, and the generic list is untouched.
  function riskWords(p) {
    const a = p && p.quiz && p.quiz.answers;
    if (!a || typeof a !== 'object') return null;
    const stakes = a.stakes || 'meaningful';
    let scores = null;
    if (a.scores && typeof a.scores === 'object') scores = a.scores;
    else if (Array.isArray(a.checkedPrompts)) {
      scores = scoreFromPrompts(a.checkedPrompts, stakes, Array.isArray(a.skippedSections) ? a.skippedSections : []);
    } else if (Array.isArray(a.worry) && a.worry.length) {
      scores = shimScores(a);
    }
    if (!scores) return null;
    const words = {};
    for (const c of Object.keys(concernEmphasis)) {
      if (typeof scores[c] === 'number') words[c] = scoreWord(scores[c], c, stakes);
    }
    return words;
  }

  // Tag the mapped steps of every elevated/high concern. EMPHASIS ONLY — the
  // chip and why-line were server-rendered hidden on every item; this fills and
  // reveals them, and never moves, adds, or removes a step (the order is
  // safety-critical). Hidden steps (not part of this setup) are skipped.
  function emphasize() {
    const words = riskWords(plan);
    if (!words) return;
    items.forEach((li) => {
      if (li.hidden) return;
      const id = li.getAttribute('data-id');
      for (const [concern, em] of Object.entries(concernEmphasis)) {
        const w = words[concern];
        if ((w === 'elevated' || w === 'high') && em.steps.includes(id)) {
          const flag = li.querySelector('.ct-flag');
          const why = li.querySelector('.ct-why');
          if (flag) flag.hidden = false;
          if (why) { why.textContent = em.why.replace('{word}', w); why.hidden = false; }
          break;
        }
      }
    });
  }

  // ── Personalize: hide what doesn't apply, name the visitor's own hardware ───
  function personalize() {
    if (gap) {
      // Not personalized, and says so. The nudge to take the finder would be wrong
      // here — they already did; what's missing is further along.
      const nudgeEl = document.getElementById('cl-nudge');
      const partial = document.getElementById('cl-partial');
      const pp = document.getElementById('cl-partial-p');
      if (nudgeEl) nudgeEl.hidden = true;
      if (partial && pp) {
        pp.innerHTML = `You’ve chosen a setup, but it still needs <strong>${gap.what}</strong> — so this is the <strong>full list</strong>, `
          + `not yet trimmed to you. Finish your plan and this page becomes your checklist: only the steps your setup needs, in order, `
          + `with your own hardware named throughout. `
          + `<a href="${gap.href}">${gap.cta} →</a> <a href="/my-plan">or open your plan</a>`;
        partial.hidden = false;
      }
      // The list can't be trimmed yet, but the risk picture is already known —
      // and emphasis never depends on which hardware they end up with. Someone
      // mid-plan is exactly who needs to see which steps their answers lean on.
      emphasize();
      return;
    }
    if (!ctx) return;

    // Attributes → the same item shape itemApplies() expects, so page and data
    // layer agree on who sees what.
    items.forEach((li) => {
      const only = li.getAttribute('data-only');
      // EVERY FIELD itemApplies() READS HAS TO BE HERE. This shape is rebuilt from
      // DOM attributes, so a new field in the data layer is invisible to it until
      // it is added in two places — the attribute on the <li> and this line. Miss
      // one and the page silently stops applying that rule while /my-plan, which
      // reads the real items, still does.
      const item = {
        only: only ? only.split(' ') : undefined,
        needs: li.getAttribute('data-needs') || undefined,
        done: li.getAttribute('data-done') === 'true',
        deviceSlot: li.getAttribute('data-device-slot') === 'true',
      };
      const applies = itemApplies(item, ctx);
      li.hidden = !applies;
      if (!applies) delete checked[li.getAttribute('data-id')];
    });

    // ── The device step, judged against what you actually own ────────────────
    // Three outcomes, because "go and get one" is wrong in two of them:
    //   · you own something that clears the bar  → the step is DONE, hide it
    //   · you own only flagged/unrated hardware  → it becomes "consider upgrading",
    //     with the reason, and if that device is your CHOSEN plan device it drops to
    //     the end as advisory rather than blocking a build you have already decided
    //   · you own nothing                        → unchanged, go and get one
    const planned = ctx.devices.filter(Boolean);
    const devSlugs = (planned.length ? planned : ctx.owned).filter(Boolean);
    // THE SEED-GENERATION STEP, aimed at hardware this reader actually has.
    // A generic link to a page listing four options is close to useless when
    // three of them are impossible on their device — and the honest dead end
    // ("yours will not let you") is the case nothing else on the internet
    // tells them. Copy only; the step never moves and never disappears.
    const seedStep = items.find((li) => li.getAttribute('data-id') === 'generate-seed');
    if (seedStep && devSlugs.length) {
      const advice = diceAdviceFor(devSlugs.map((sl) => ownedName(sl)).filter(Boolean));
      if (advice) {
        const desc = seedStep.querySelector('.ct-desc');
        const link = seedStep.querySelector('.ct-link');
        if (desc) {
          const p = document.createElement('p');
          p.className = 'ct-dice';
          p.textContent = advice.line;
          desc.insertAdjacentElement('afterend', p);
        }
        // Repoint the step's own link rather than adding a second one: two
        // links on one step is the reader choosing between them blind.
        if (link && advice.key !== 'none') {
          link.setAttribute('href', advice.href);
          link.textContent = 'Your dice procedure →';
        }
      }
    }

    const deviceStep = items.find((li) => li.getAttribute('data-device-slot') === 'true');
    if (deviceStep && devSlugs.length) {
      const judged = assessDevices(devSlugs);
      const clearing = judged.filter((d) => d.verdict === 'cold');
      const flagged = judged.filter((d) => d.verdict === 'spending' || d.verdict === 'disqualified');
      const unrated = judged.filter((d) => d.verdict === 'unrated');
      const title = deviceStep.querySelector('.ct-title');
      const desc = deviceStep.querySelector('.ct-desc');
      const span = deviceStep.querySelector('.ct-dev');

      if (clearing.length) {
        // Already handled — you have a device we'd trust. itemApplies() has hidden
        // it in the loop above (deviceSlotSettled), which is also what makes
        // /my-plan's step count agree with this list. Nothing to do here.
      } else if (flagged.length || unrated.length) {
        const d = flagged[0] || unrated[0];
        // NOT "get a real hardware wallet". They chose this; say why we'd revisit it.
        // And an UNRATED device gets a different ask entirely — we have not judged it,
        // so "consider upgrading" would be a verdict we never reached.
        title.childNodes[0].nodeValue = flagged.length
          ? 'Consider upgrading your hardware wallet'
          : 'Check your hardware wallet against our standard';
        desc.textContent = `You have a ${d.name}. ${d.why} `
          + (flagged.length
            ? 'Nothing here forces your hand — but for money you mean to leave alone for years, we would move to a device from our cold-storage tier.'
            : 'Compare it against the standard yourself and decide.');
        if (span) { span.hidden = true; }
        // Chosen deliberately → advisory, at the end, not a step blocking the build.
        if (planned.length) {
          deviceStep.classList.add('advisory');
          const group = deviceStep.closest('.cgroup');
          const lastGroup = document.querySelector('.cgroup[data-phase="yearly"]') || group;
          lastGroup.querySelector('.clist, ul').appendChild(deviceStep);
        }
      }
    } else if (deviceStep && !devSlugs.length) {
      const span = deviceStep.querySelector('.ct-dev');
      if (span) span.hidden = true;
    }
    if (deviceStep && devSlugs.length) {
      const names = devSlugs.map((s) => ownedName(s)).filter(Boolean);
      const span = deviceStep.querySelector('.ct-dev');
      if (span && !span.hidden && names.length) { span.textContent = ' — you have ' + listOf(names); span.hidden = false; }
    }

    // Hide any phase whose every item is now hidden.
    document.querySelectorAll('.cgroup').forEach((sec) => {
      const any = Array.from(sec.querySelectorAll('.citem')).some((li) => !li.hidden);
      sec.hidden = !any;
    });

    // Swap the generic intro for the personalized header. The name derives from the
    // RUNG, not the stored label — pre-7/30 plans stored a step-up's ACTION as the
    // label, so headers read "Getting you to Add a passphrase (the \"25th word\")".
    // Same guard /my-plan applies: the stored label is trusted only when it names a
    // setup rather than an action.
    const rung = getRung(ctx.rung);
    const stored = (ctx.label || '').trim();
    const storedIsSetup = stored && !/^(add|step up|spread|graduate|start)\b/i.test(stored);
    const setupName = (rung && rung.name) || (storedIsSetup ? stored : '') || ctx.rung;
    const nudge = document.getElementById('cl-nudge');
    const yours = document.getElementById('cl-yours');
    if (nudge) nudge.hidden = true;
    if (yours) yours.hidden = false;
    const h1 = document.getElementById('cl-h1');
    if (h1) h1.innerHTML = 'Your self-custody <span class="accent">checklist</span>';
    const lead = document.getElementById('cl-lead');
    if (lead) lead.textContent = 'Built from your plan — these are the steps your setup actually needs, in the order to do them. Tick as you go; everything saves to your plan automatically.';
    const yh = document.getElementById('cl-yours-h');
    if (yh) yh.textContent = 'Getting you to ' + setupName;
    const ys = document.getElementById('cl-yours-sub');
    if (ys) ys.textContent = visible().length + ' steps, tailored to your setup. We’ve hidden everything that doesn’t apply to you — nothing here is filler.';

    // Last, on the trimmed list: chip the steps your own risk picture leans on.
    emphasize();
  }

  function listOf(names) {
    if (names.length === 1) return names[0];
    if (names.length === 2) return names[0] + ' and ' + names[1];
    return names.slice(0, -1).join(', ') + ', and ' + names[names.length - 1];
  }

  const visible = () => items.filter((li) => !li.hidden);
  function count() { return visible().filter((li) => checked[li.getAttribute('data-id')]).length; }

  // ── "Next up" — exactly one open action at a time, top-down ────────────────
  function markNext() {
    items.forEach((li) => {
      li.classList.remove('next');
      const tag = li.querySelector('.ct-next');
      if (tag) tag.hidden = true;
    });
    const next = visible().find((li) => !li.classList.contains('done'));
    if (!next) return;
    next.classList.add('next');
    const tag = next.querySelector('.ct-next');
    if (tag) tag.hidden = false;
    // A collapsed phase must never hide the one action we're pointing at.
    const fold = next.closest('details');
    if (fold && !fold.open) fold.open = true;
  }

  function refresh() {
    const n = count();
    const tot = visible().length;
    if (elN) elN.textContent = String(n);
    if (elTotal) elTotal.textContent = String(tot);
    const bar = document.getElementById('cl-bar');
    const wrap = document.getElementById('cl-bar-wrap');
    const pct = tot ? Math.round((n / tot) * 100) : 0;
    if (bar) bar.style.width = pct + '%';
    if (wrap) wrap.setAttribute('aria-valuenow', String(pct));
    const c = document.getElementById('cl-yours-count');
    if (c) c.textContent = n === tot && tot > 0 ? '✓ All ' + tot + ' done — that’s the whole thing.' : n + ' of ' + tot + ' done';
    markNext();
  }

  function toast(msg, kind) {
    const t = document.createElement('div');
    t.className = 'cl-toast' + (kind ? ' ' + kind : ''); t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 1800);
  }

  function apply(li, on) {
    const id = li.getAttribute('data-id');
    const box = li.querySelector('.box');
    if (on) { checked[id] = true; } else { delete checked[id]; }
    li.classList.toggle('done', !!on);
    if (box) box.setAttribute('aria-checked', on ? 'true' : 'false');
  }

  // Order matters: filter first, THEN restore ticks, so counts and "next up" are
  // computed against the visitor's own list rather than the generic one.
  personalize();

  const saved = (plan && plan.checklist) || {};
  items.forEach((li) => { if (saved[li.getAttribute('data-id')] && !li.hidden) apply(li, true); });
  refresh();

  // Whole row is the tap target (≥44px) — not just the small box. Each tick
  // AUTO-SAVES to the plan (browser-only) so nothing you check is ever lost.
  items.forEach((li) => {
    li.addEventListener('click', (e) => {
      if (e.target.closest('a')) return;   // let inline links work
      const nowOn = !li.classList.contains('done');
      apply(li, nowOn);
      refresh();
      // Merge, don't replace: hidden items may hold ticks from an earlier setup,
      // and clobbering them would silently erase real progress.
      const savedPlan = saveChecklistSlice({ ...saved, ...checked, ...hiddenOff() });
      // saveChecklistSlice returns null when the browser blocked the write (private
      // mode, storage full) — the tick still shows for this visit, but claiming
      // "saved" over a write that never happened would be a lie.
      if (!savedPlan) {
        if (elAuto) elAuto.hidden = true;
        toast('Couldn’t save — your browser is blocking storage', 'err');
        return;
      }
      if (elAuto) elAuto.hidden = false;
      toast(nowOn ? '✓ Saved to your plan' : 'Updated your plan');
    });
  });

  // Un-ticked visible items must win over a stale `true` in the saved map.
  function hiddenOff() {
    const off = {};
    visible().forEach((li) => {
      const id = li.getAttribute('data-id');
      if (!checked[id]) off[id] = false;
    });
    return off;
  }

  if (Object.keys(saved).length && elAuto) elAuto.hidden = false; // already have saved ticks
</script>

<style>
  .gtag { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent-ink); background: var(--accent); border-radius: 999px; padding: 0.25rem 0.7rem;
    flex: 0 0 auto; }
  /* The phase heading doubles as the fold control. */
  .grouphead { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;
