---
import Base from '../../layouts/Base.astro';
import { ladder, shamirNote } from '../../data/ladder.js';

export function getStaticPaths() {
  // rung 1 (single-sig) has its own bespoke page; render rungs 2-4 + the
  // optional Shamir note from data
  const rungs = ladder.filter((r) => r.slug !== 'single-sig');
  return [...rungs, shamirNote].map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props;
const prev = r.optional ? null : ladder.find((x) => x.step === r.step - 1);
const next = r.optional ? null : ladder.find((x) => x.step === r.step + 1);
const eyebrow = r.optional ? 'Optional · Advanced backup' : `Rung ${r.step} · ${r.short}`;
const crumbLabel = r.optional ? 'Optional backup' : `Rung ${r.step}`;
const accentize = (title, phrase) => {
  if (!phrase) return title;
  const i = title.indexOf(phrase);
  if (i < 0) return title;
  return title.slice(0, i) + `<span class="accent">${phrase}</span>` + title.slice(i + phrase.length);
};
---
<Base
  title={`${r.optional ? '' : `Rung ${r.step} — `}${r.pageName ?? r.name} · BitcoinKeys.guide`}
  description={r.tagline}
  verified="2026-07-15"
>
  <nav class="crumb"><a href="/ladder">The ladder</a> <span aria-hidden="true">/</span> <span>{crumbLabel}</span></nav>

  <section class="prose">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={accentize(r.pageName ?? r.name, r.accent)}></h1>
    <p class="lead">{r.tagline}</p>

    <dl class="facts">
      <div><dt>Best for</dt><dd>{r.forWho}</dd></div>
      <div><dt>Rough cost</dt><dd>{r.cost}</dd></div>
      <div><dt>Typical tier</dt><dd>{r.tier}</dd></div>
    </dl>
  </section>

  <section class="prose">
    <h2>What this is</h2>
    <p set:html={r.whatItIs}></p>

    <h2>What it’s good at</h2>
    <ul>{r.gains.map((g) => <li set:html={g}></li>)}</ul>

    <h2>What it costs you</h2>
    <ul>{r.costs.map((c) => <li set:html={c}></li>)}</ul>

    {r.keyRisk && (
      <div class="callout warn">
        <span class="label">{r.keyRisk.label}</span>
        <p set:html={r.keyRisk.body}></p>
      </div>
    )}

    {r.keyNote && (
      <div class:list={['callout', r.keyNote.tone === 'safe' ? 'safe' : '']}>
        <span class="label">{r.keyNote.label}</span>
        <p set:html={r.keyNote.body}></p>
      </div>
    )}

    {r.also && (
      <div class="callout">
        <span class="label">{r.also.label}</span>
        <p set:html={r.also.body}></p>
      </div>
    )}

    <h2>Who should use it</h2>
    <p set:html={r.whoShould}></p>

    {r.providers && (
      <>
        <h3>Where the partners differ</h3>
        <div class="providers">
          {r.providers.map((p) => (
            <div class="provider">
              <span class="pname">{p.name}</span>
              <span class="pnote">{p.note}</span>
            </div>
          ))}
        </div>
        <p class="sub">None is “correct” — they serve different clients. Evaluate each on its sovereign-recovery story, multi-vendor hardware support, and exactly what happens to your setup if they disappear.</p>
      </>
    )}

    <h2>Planning for inheritance</h2>
    <p set:html={r.inheritance}></p>

    <h2>When to climb</h2>
    <p set:html={r.whenToClimb}></p>
  </section>

  <nav class="rung-nav">
    {prev && <a href={`/ladder/${prev.slug}`}>← Rung {prev.step}: {prev.short}</a>}
    {next && <a class="fwd" href={`/ladder/${next.slug}`}>Rung {next.step}: {next.short} →</a>}
  </nav>

  <div class="cta-row">
    <a href="/wallets" class="btn btn-primary">Compare devices <span class="arw">→</span></a>
    <a href="/ladder" class="btn btn-ghost">Back to the ladder</a>
  </div>
</Base>

<style>
  .crumb { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); margin-bottom: 1.2rem; display: flex; gap: 0.5rem; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }

  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 1.8rem 0 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--line); }
  .facts > div { background: var(--surface); padding: 1rem 1.1rem; }
  .facts dt { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); margin: 0 0 0.3rem; }
  .facts dd { margin: 0; font-weight: 600; font-size: 0.95rem; }
  @media (max-width: 640px) { .facts { grid-template-columns: 1fr; } }

  .providers { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin: 1rem 0; }
  @media (max-width: 640px) { .providers { grid-template-columns: 1fr; } }
  .provider { border: 1px solid var(--line); border-radius: 0.6rem; padding: 0.85rem 1rem; background: var(--surface); }
  .pname { display: block; font-weight: 700; color: var(--accent); margin-bottom: 0.2rem; }
  .pnote { display: block; font-size: 0.88rem; color: var(--muted); line-height: 1.45; }

  .rung-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.4rem; padding-top: 1.4rem; border-top: 1px solid var(--line-soft); flex-wrap: wrap; }
  .rung-nav a { font-size: 0.92rem; font-weight: 600; text-decoration: none; }
  .rung-nav .fwd { margin-left: auto; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.6rem; }
</style>
