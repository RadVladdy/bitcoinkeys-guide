  #plan .ps-muted a:hover, #plan .ps-road-gap a:hover, #plan .ps-slot-cta:hover { text-decoration: underline; }
  #plan .ps-sub { display: block; color: var(--faint); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.5rem; }
  #plan .ps-hint { text-transform: none; letter-spacing: 0; color: var(--faint); font-size: 0.72rem; }
  #plan .ps-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
