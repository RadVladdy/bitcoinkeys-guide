---
import Base from '../layouts/Base.astro';
import WhereAmI from '../components/WhereAmI.astro';
---
<Base
  title="Your plan — your data, held by you · BitcoinKeys.guide"
  description="Save your setup result, ladder rung, chosen device, and checklist progress — on infrastructure you own, never ours. By default this site keeps nothing; saving is always your explicit choice."
  verified="2026-07-28"
>
  <section class="prose">
    <p class="eyebrow">Your plan</p>
    <h1>Your plan — held by <span class="accent">you, not us</span></h1>
    <p class="lead">The setup finder, the ladder, and the checklist build one picture of your setup: <strong>where you are today, the hardware you own, the setup you're aiming for, and the roadmap between them</strong>. Save it if you want to pick up where you left off — but on your terms. This site is <strong>keyless and dataless</strong>: by default it keeps nothing.</p>

    <div class="promise">
      <span class="pn-label mono">🔒 How this works</span>
      <p>Nothing here is saved until <strong>you</strong> save it, and you choose where it goes: <strong>this browser</strong>, <strong>a file you download</strong>, or — only if you pick it — <strong>encrypted to your own Nostr key</strong>, on relays you choose. The first two never leave your device at all; the third leaves it already encrypted, readable by you alone. <strong>We never see your plan in any of them.</strong> There is no account and no server on our side. Clear it any time.</p>
    </div>
  </section>

  <div id="plan" aria-live="polite">
    <div id="plan-body"></div>
    <noscript><p class="ns">This page needs JavaScript to read your saved plan. Everything on this guide works fine without it — the plan feature is the one exception, because it runs entirely in your browser.</p></noscript>
  </div>

  <!-- The ladder self-locator. Lives here (not on /learn/ladder) since 2026-07-28: the
       quiz is the one door IN, and this is the RE-CHECK for someone whose
       situation has since changed. Auto-saves the rung it lands on. -->
  <WhereAmI />

  <section class="prose sovereign" id="nostr-sec">
    <h2 id="nostr-h2">Save to your Nostr — encrypted, only you can read it</h2>
    <div id="nostr-explain">
      <p><strong>New to all this? You can skip this whole section.</strong> A downloaded file (above) is all you need — Nostr is an advanced, optional way to sync your plan across devices, for people who already use it.</p>
      <p>Already have a Nostr key? Save your plan to your own relays. It's <strong>encrypted to your key before it leaves this page</strong> — we never see your key or your plan, and neither do your relays. Sign in with a browser extension, or with a bunker (Amber, nsec.app…) so your key never touches the browser.</p>
    </div>
    <div id="nostr-ui" aria-live="polite"></div>
    <p class="soon-foot" id="nostr-privacy">Privacy note: the plan's contents are encrypted, and we store it under a <em>scrambled tag derived from your key</em> — so no one can scan the relays to build a list of this guide's users. But the event is still signed by your key, so anyone who already has <em>your</em> public key could confirm you saved something here. Use a key you're comfortable associating with self-custody. <strong>Want to publish nothing at all? A downloaded file is the most private option.</strong></p>
  </section>

  <section class="prose sovereign2" id="pubky-sec">
    <h3>Also planned: Pubky</h3>
    <p><strong>Pubky</strong> <span class="tag mono">on hold</span> — a personal datastore addressed by your key. We're holding this one on purpose. Today a Pubky homeserver stores only <strong>public, unencrypted</strong> data (encrypted storage is on their roadmap), and Pubky Ring signs you in but doesn't offer apps a way to <em>encrypt to your key</em> the way a Nostr signer does — so a private plan would mean this site handling key material, which we won't do. We'll add Pubky the moment it can encrypt to your key. (Verify, don't trust — including us.)</p>
  </section>
</Base>

<script>
  const VERDICT = {
    cold:         { cls: 'v-ok',   label: '✓ clears our bar' },
    spending:     { cls: 'v-warn', label: '~ built for spending' },
    disqualified: { cls: 'v-bad',  label: '⚠ doesn’t clear our bar' },
    unrated:      { cls: 'v-un',   label: '· not rated by us' },
  };
  function verdictChip(slug) {
    const d = assessDevices([slug])[0];
    if (!d) return '';
    const v = VERDICT[d.verdict];
    return `<a class="ps-verdict ${v.cls}" href="/standard" title="${esc(d.why)}">${v.label}</a>`;
  }
  import { getPlannedDevices,
    loadLocal, hasLocal, clearLocal, clearPlanSelection, saveLocal, downloadPlan, parsePlanText,
    planHasContent, emptyPlan, PLAN_FILENAME, setOwnedAndPrivacy,
    assignToPlan, removeFromPlan, retireOwned, getRecommendedDevices,
    encryptPlanToEnvelope, decryptEnvelope, downloadEncryptedPlan, isEncryptedEnvelope,
  } from '../data/plan.js';
  import { getRung, rungAnchor } from '../data/ladder.js';
  import { keysForSetup, assessDevices, ownedName, deviceBySlug } from '../data/wallets.js';
  import { custodianName, custodianBySlug } from '../data/custodians.js';
  import { mountOwnedPicker } from '../data/owned-picker.js';
  import { checklistLabels, checklistCount, checklistItems, itemApplies } from '../data/checklist.js';
  import { questionCountWord } from '../data/quiz.js';
  import { getSession, setSession, clearSession } from '../data/nostr-session.js';
  import { confirmDialog, promptPassword, downloadDialog } from '../data/ui-dialog.js';

  const el = document.getElementById('plan-body');
  function esc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }

  // The top "Save to Nostr" action reflects login state: signed in → your avatar +
  // a direct save; signed out → the ↓ that drops you to the connect panel.
  function paintNostrActionBtn() {
    const b = document.getElementById('p-nostr');
    if (!b) return;
    const s = getSession();
    if (s) {
      const initial = (s.name || (s.npub || 'N').replace(/^npub1/, '') || 'N').slice(0, 1).toUpperCase();
      b.classList.add('signed-in');
      b.title = 'Save your plan to Nostr' + (s.name ? ' as ' + s.name : '');
      b.innerHTML = `<span class="pn-av">${esc(initial)}</span><span>Save to Nostr (encrypted)</span>`;
      if (s.picture) {
        const img = document.createElement('img');
        img.className = 'pn-av'; img.alt = ''; img.referrerPolicy = 'no-referrer';
        img.addEventListener('load', () => { const fb = b.querySelector('.pn-av'); if (fb) fb.replaceWith(img); });
        img.src = s.picture;
      }
    } else {
      b.classList.remove('signed-in');
      b.title = 'Sign in to save your plan to Nostr';
      b.textContent = '☁ Save to Nostr (encrypted) ↓';
    }
  }

  // Slim the page to the current status: once you're signed in to Nostr, the long
  // "what is Nostr / how to connect" explainer + the Pubky note are just noise, so
  // collapse them and keep only the control. (the owner: keep the site slim per state.)
  function slimNostr() {
    const signedIn = !!getSession();
    const hide = (id) => { const e = document.getElementById(id); if (e) e.style.display = signedIn ? 'none' : ''; };
    hide('nostr-explain'); hide('pubky-sec'); hide('nostr-privacy');
    const h2 = document.getElementById('nostr-h2');
    if (h2) h2.textContent = signedIn ? 'Your Nostr' : 'Save to your Nostr — encrypted, only you can read it';
  }

  function fmtDate(iso) {
    if (!iso) return '';
    try {
      return new Date(iso).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
    } catch (e) { return iso; }
  }

  function rungName(slug) {
    if (slug === 'pre') return 'Not on the ladder yet (exchange or software wallet)';
    const r = getRung(slug);
    return r ? r.name : slug;
  }

  // ── Status → roadmap → plan ────────────────────────────────────────────────
  const CURRENT_LABELS = {
    pre: 'On an exchange or a software wallet',
    'single-sig': 'One hardware wallet (single-sig)',
    passphrase: 'Hardware wallet + a passphrase',
    multisig: 'Self-run multisig',
    collaborative: 'Collaborative multisig',
  };
  function currentSetupLabel(plan) {
    const cur = plan.quiz && plan.quiz.answers && plan.quiz.answers.current;
    return cur ? (CURRENT_LABELS[cur] || cur) : null;
  }

  // STATUS: where you are now — current setup + the wallets you own (make→model
  // picker, mounted after render into #ps-own-mount; supports multiple wallets).
  function statusHtml(plan) {
    const cur = currentSetupLabel(plan);
    const ladder = plan.ladder && plan.ladder.rung
      ? `<p class="ps-cur">On the ladder: <strong>${esc(rungName(plan.ladder.rung))}</strong> <a class="ps-mini-link" href="#whereami">re-check →</a></p>` : '';
    const owned = plan.owned || [];
    // Owned wallets are DISPLAY-ONLY here (they're gathered from the quiz + /wallets).
    // The full make→model picker is tucked behind an "add or edit" toggle; if none are
    // recorded yet, a gentle optional prompt to add one.
    let ownBlock;
    if (owned.length) {
      ownBlock = `<div id="ps-owned-display" class="ps-owned-display">
          <span class="ps-sub mono">Hardware wallets you own</span>
          <div class="ps-owned-chips">${owned.map((s) => {
            const a = assessDevices([s])[0];
            const v = a ? VERDICT[a.verdict] : null;
            return `<span class="ps-owned-chip">${esc(ownedName(s))}${v ? `<a class="ps-verdict ${v.cls}" href="/standard" title="${esc(a.why)}">${v.label}</a>` : ''}</span>`;
          }).join('')}</div>
          <button class="ps-edit-own" id="ps-edit-own" type="button">✎ add or edit</button>
        </div>`;
    } else if (plan.ownPrivate) {
      ownBlock = `<div id="ps-owned-display" class="ps-owned-display">
          <p class="ps-muted">You preferred not to list your hardware wallets. <button class="ps-edit-own" id="ps-edit-own" type="button">change</button></p>
        </div>`;
    } else {
      ownBlock = `<div id="ps-owned-display" class="ps-owned-display">
          <p class="ps-muted">${cur ? `You're on <strong>${esc(cur)}</strong> but haven't noted the hardware wallet${cur.toLowerCase().includes('multisig') ? 's' : ''} you use.` : `No hardware wallets noted yet.`} <button class="ps-edit-own" id="ps-edit-own" type="button">＋ add a wallet</button></p>
        </div>`;
    }
    return `
      <div class="ps-card ps-status">
        <h2 class="ps-h2">Where you are — your current status</h2>
        ${cur
          ? `<p class="ps-cur">Your current setup: <strong>${esc(cur)}</strong></p>`
          : `<p class="ps-cur ps-muted">No current setup recorded yet — <a href="/find-your-setup">find your setup</a> to set your starting point.</p>`}
        ${ladder}
        <div class="ps-own">
          ${ownBlock}
          <div id="ps-own-mount" hidden></div>
        </div>
      </div>`;
  }

  // ROADMAP: the bridge from status to plan — key slots the owned/chosen wallets
  // fill, and the gap that becomes a short shopping list.

  // A verdict chip on each filled key slot. /my-plan showed the device you own and
  // said nothing about whether it meets the standard the rest of the site judges
  // hardware by — so someone could plan around a Ledger and never be told. The
  // reasoning is pulled from assessDevices(), never restated here. (the owner, 7/30.)

  // Is the saved plan actually finished? A plan with an unchosen hardware wallet, or
  // a collaborative plan with no custodian, is a plan in progress — and the page
  // should say what is missing rather than hand over a checklist built on a blank.
  function planGaps() {
    const plan = loadLocal() || emptyPlan();
    const need = keysForSetup({ rungSlug: plan.quiz?.rung, label: plan.quiz?.primaryLabel, tier: plan.quiz?.primaryTier });
    const assigned = getPlannedDevices().filter(Boolean);
    const missing = Math.max(0, need - assigned.length);
    const isCollab = plan.quiz?.rung === 'collaborative';
    if (missing > 0) {
      return {
        label: missing === 1
          ? 'Choose your hardware wallet'
          : `Choose ${missing} more hardware wallet${missing > 1 ? 's' : ''}`,
        note: missing === 1
          ? 'Your plan needs one hardware wallet. Pick it and your checklist is built around that exact device — which model, which steps, named throughout.'
          : `Your plan needs ${missing} more. Best practice for multisig is different makers, so one firmware problem can never reach more than one of them.`,
        href: '/wallets', cta: 'Compare wallets',
      };
    }
    if (isCollab && !plan.custodian) {
      return {
        label: 'Choose who holds the service key',
        note: 'Your own hardware wallets are set. The last piece is which Bitcoin service holds the third key.',
        href: '/collaborative', cta: 'Compare custodians',
      };
    }
    return null;
  }
  const planIncomplete = () => planGaps() !== null;
  function roadmapHtml(plan) {
    if (!plan.quiz || !(plan.quiz.primaryLabel || plan.quiz.rung)) return '';
    const need = typeof plan.quiz.keysNeeded === 'number' ? plan.quiz.keysNeeded : null;
    if (need === null) return ''; // plan saved before roadmap existed — skip gracefully
    const planLabel = plan.quiz.primaryLabel || rungName(plan.quiz.rung);
    if (need === 0) {
      return `
        <div class="ps-road-in">
          <p class="ps-cur ps-plan-lead">Plan: <strong>${esc(planLabel)}</strong></p>
          <p class="ps-road-note">This setup starts on a <strong>non-custodial phone wallet</strong> — no hardware to buy yet. When your stack grows, you’ll graduate to a single hardware wallet. No shopping list for now; just learn the moves.</p>
        </div>`;
    }
    // Collaborative custody: the user holds `need` keys (wallets) + a service holds one
    // (the custodian slot). DIY / single-sig plans have no custodian slot.
    const isCollab = plan.quiz.rung === 'collaborative';
    const owned = plan.owned || [];
    const assigned = (plan.quiz.plannedDevices || []).slice(0, need); // the plan's wallet key slots
    const sidelined = owned.filter((s) => !assigned.includes(s));     // owned but not in this plan
    const hasSpace = assigned.length < need;
    let slots = '';
    for (let i = 0; i < need; i++) {
      const slug = assigned[i];
      if (slug) {
        const isOwned = owned.includes(slug);
        const tag = isOwned ? 'you own' : 'to buy';
        slots += `<div class="ps-slot filled"><span class="ps-slot-n mono">Wallet ${i + 1}</span><span class="ps-slot-dev">${esc(ownedName(slug))}</span>${verdictChip(slug)}<span class="ps-slot-tag ${isOwned ? 'own' : 'plan'}">${tag}</span><button class="ps-slot-x" data-act="unassign" data-slug="${esc(slug)}" title="Take out of this plan" type="button">×</button></div>`;
      } else {
        slots += `<div class="ps-slot empty"><span class="ps-slot-n mono">Wallet ${i + 1}</span><span class="ps-slot-dev ps-muted">Not chosen yet</span><a class="ps-slot-cta" href="/wallets">Choose →</a></div>`;
      }
    }
    if (isCollab) {
      const cust = plan.custodian;
      slots += cust
        ? `<div class="ps-slot filled ps-slot-cust"><span class="ps-slot-n mono">Service key</span><span class="ps-slot-dev">${esc(custodianName(cust))}</span><span class="ps-slot-tag plan">custodian</span><a class="ps-slot-cta" href="/collaborative">Change →</a></div>`
        : `<div class="ps-slot empty ps-slot-cust"><span class="ps-slot-n mono">Service key</span><span class="ps-slot-dev ps-muted">Collaborative custodian — not yet chosen</span><a class="ps-slot-cta" href="/collaborative">Choose one →</a></div>`;
    }
    // Sidelined wallets: owned but not in this plan (retired-in-place, or spare beyond need).
    let sidelineHtml = '';
    if (sidelined.length) {
      sidelineHtml = `<div class="ps-sideline">
        <span class="ps-sub mono">Owned, not in this plan <span class="ps-hint">${hasSpace ? 'add to a slot, or set aside' : 'spare — this plan is full'}</span></span>
        ${sidelined.map((s) => `<div class="ps-side-row"><span class="ps-side-dev">${esc(ownedName(s))}</span><span class="ps-side-acts">${hasSpace ? `<button class="ps-side-add" data-act="assign" data-slug="${esc(s)}" type="button">＋ Add to plan</button>` : ''}<button class="ps-side-retire" data-act="retire" data-slug="${esc(s)}" type="button">Retire</button></span></div>`).join('')}
      </div>`;
    }
    const gaps = Math.max(0, need - assigned.length);
    const custGap = isCollab && !plan.custodian; // collaborative plan missing its custodian
    const multi = need >= 3;
    // "needs 1 key" meant "you need to buy one hardware wallet" and did not say so.
    const needLabel = isCollab
      ? `${need} hardware wallet${need > 1 ? 's' : ''} you hold + a service key`
      : `${need} hardware wallet${need > 1 ? 's' : ''}`;
    let footer;
    if (plan.ownPrivate && !owned.length) {
      footer = `<p class="ps-road-gap">You’d rather not say which wallets you own — so we’ve laid out the full setup. <strong>You may already have some of these.</strong>${multi ? ' Best practice: use a <em>different maker</em> for each, so one firmware problem can never reach more than one key.' : ''}</p>`;
    } else if (gaps === 0 && !custGap) {
      footer = `<p class="ps-road-done">✓ Every slot is filled. What’s left is configuring and testing the setup.</p>`;
    } else {
      // Nothing. The slots show the state and the "Your next step" row gives the
      // one instruction — including the different-makers reason for multisig. This
      // footer was saying it a second time, word for word. (the owner: "look through
      // this for redundancy... make it more simple, less confusing.")
      footer = '';
    }
    // Recommended devices for this setup (from the quiz) — suggest them to fill gaps.
    const recSlugs = (plan.quiz.recommendedDevices || []).filter((s) => !assigned.includes(s));
    const recHtml = (gaps > 0 && recSlugs.length)
      ? `<p class="ps-recs"><span class="ps-recs-k mono">★ Recommended for your plan</span>
          ${recSlugs.map((s) => `<a class="ps-rec-chip" href="/wallets">${esc(ownedName(s))}</a>`).join('')}
          <span class="ps-recs-note">— pick these on the <a href="/wallets">wallet comparison</a>.</span></p>`
      : '';
    // Custodian-specific device advice for a collaborative plan's user-held keys.
    let custAdviceHtml = '';
    if (isCollab && plan.custodian) {
      const cust = custodianBySlug[plan.custodian];
      if (cust) {
        const supports = cust.supports || [];
        const recNames = (cust.recommends || []).map((s) => ownedName(s));
        if (!supports.length) {
          custAdviceHtml = `<p class="ps-recs"><span class="ps-recs-k mono">★ With ${esc(cust.name)}</span>
            <span class="ps-recs-note">${esc(cust.name)} includes its own device — there's no separate hardware wallet to choose for these keys. <a href="/collaborative">custodian details →</a></span></p>`;
        } else {
          // List cleared devices plainly; flag any supported device that doesn't
          // clear our standard rather than presenting it as an equal option.
          const cleared = supports.filter((s) => (deviceBySlug[s]?.tier ?? 'cold') !== 'disqualified');
          const dq = supports.filter((s) => deviceBySlug[s]?.tier === 'disqualified');
          const supNames = cleared.map((s) => ownedName(s));
          const supList = supNames.slice(0, 6).join(', ') + (supNames.length > 6 ? ', and more' : '');
          const dqNote = dq.length
            ? ` (it also supports ${dq.map((s) => esc(ownedName(s))).join(', ')}, which doesn't clear <a href="/standard">our standard</a>)`
            : '';
          custAdviceHtml = `<p class="ps-recs"><span class="ps-recs-k mono">★ Devices for your ${esc(cust.name)} keys</span>
            <span class="ps-recs-note">${esc(cust.name)} works with ${esc(supList)}${dqNote}.</span>
            ${recNames.length ? `<span class="ps-recs-note">Of those, we'd recommend ${recNames.map((n) => `<a class="ps-rec-chip" href="/wallets">${esc(n)}</a>`).join(' ')} for your keys${recNames.length > 1 ? ' — different brands, so one vendor’s bug can’t affect both' : ''}.</span>` : ''}
            <span class="ps-recs-note"><a href="/collaborative">See ${esc(cust.name)}’s device support →</a></span></p>`;
        }
      }
    }
    return `
      <div class="ps-road-in">
        <p class="ps-cur ps-plan-lead">Plan: <strong>${esc(planLabel)}</strong> <span class="ps-need mono">· ${needLabel}</span></p>
        <span class="ps-sub mono">The hardware wallets in this plan</span>
        <div class="ps-slots">${slots}</div>
        ${sidelineHtml}
        ${footer}
        ${recHtml}
        ${custAdviceHtml}
        ${assigned.length || sidelined.length
          ? `<a class="ps-rework" href="/wallets">✎ Rework your devices — compare &amp; swap from the wallets page →</a>`
          : ''}
      </div>`;
  }

  // The saved-plan card now leads with the roadmap (the setup + its wallet slots) and
  // the status card carries the ladder position — so rowsHtml is just the checklist.
  function rowsHtml(plan) {
    const rows = [];
    // Count only ids that still exist in the checklist data — an imported or
    // old plan may carry renamed/retired ids, and the count must match the
    // visible list below (which filters the same way).
    const doneIds = plan.checklist ? Object.keys(plan.checklist).filter((id) => checklistLabels[id]) : [];
    const done = doneIds.length;

    // How many steps this plan's checklist actually contains — the same filter the
    // checklist page applies, so the two numbers can never disagree.
    const rung = (plan.quiz && plan.quiz.rung) || (plan.ladder && plan.ladder.rung) || null;
    const recovery = (plan.quiz && plan.quiz.answers && plan.quiz.answers.recovery) || null;
    const ctx = rung && rung !== 'pre'
      ? { rung, heirs: recovery === 'partner' || recovery === 'heirs', custodian: Boolean(plan.custodian) || rung === 'collaborative' }
      : null;
    const total = ctx ? checklistItems.filter((it) => itemApplies(it, ctx)).length : checklistCount;

    if (done > 0) {
      const items = doneIds
        .map((id) => checklistLabels[id])
        .map((t) => `<li>${esc(t)}</li>`)
        .join('');
      rows.push([
        `Checklist progress`,
        `<span class="p-count">${done} of ${total} done</span>${items ? `<ul class="p-mini">${items}</ul>` : ''}`,
        '/checklist', 'Open the checklist',
      ]);
    } else if (ctx && planIncomplete()) {
      // THE PLAN ISN'T FINISHED, so the next step is finishing it — not a checklist.
      // This block used to announce "Your checklist is ready — 16 steps" while a
      // wallet slot sat empty, which is the opposite of a next step: the first
      // thing the checklist would tell you is to go and choose the device you have
      // not chosen. (the owner, 2026-07-30: "the output here should all be contextual.")
      const g = planGaps();
      rows.push([
        `Your next step`,
        `<span class="p-count">${esc(g.label)}</span><p class="p-mini-note">${esc(g.note)}</p>`,
        g.href, g.cta,
      ]);
    } else if (ctx) {
      // Plan complete — NOW the checklist is genuinely the next thing.
      rows.push([
        `Your next step`,
        `<span class="p-count">Your checklist is ready — ${total} steps</span><p class="p-mini-note">Trimmed to just what your setup needs, in the order to do them. One clear next action at a time.</p>`,
        '/checklist', 'Start the checklist',
      ]);
    }
    if (!rows.length) return '';
    return `<div class="p-rows">${rows.map(([k, v, href, cta]) => `
      <div class="p-row">
        <span class="p-k mono">${k}</span>
        <div class="p-v">${v}</div>
        <a class="p-cta" href="${href}">${cta} →</a>
      </div>`).join('')}</div>`;
  }

  function toast(msg, kind) {
    const t = document.createElement('div');
    t.className = `p-toast ${kind || ''}`;
    t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 2600);
  }

  function render() {
    const plan = loadLocal();
    const has = hasLocal() && plan && planHasContent(plan);

    if (!has) {
      el.innerHTML = `
        <div class="p-empty">
          <p class="p-empty-h">Nothing saved yet — and that's the default.</p>
          <p>The quiz builds your plan: it places you on the ladder, names the setup that fits, and turns it into a checklist. Two minutes, ${questionCountWord} questions, and it never asks how much you hold.</p>
          <div class="p-empty-links">
            <a class="btn-primary" href="/find-your-setup">Find your setup →</a>
            <a class="btn-ghost" href="/start">I'd rather learn it first</a>
          </div>
          <div class="p-import">
            <span class="p-k mono">Already have a plan file?</span>
            <label class="btn-ghost file-btn">Import a plan (.json)<input type="file" id="p-import-empty" accept="application/json,.json" hidden /></label>
          </div>
        </div>`;
      wireImport('p-import-empty');
      return;
    }

    el.innerHTML = `
      ${statusHtml(plan)}
      <div class="p-card">
        <div class="p-head">
          <h2>Your saved plan</h2>
          ${plan.updated ? `<span class="p-updated mono">Saved ${esc(fmtDate(plan.updated))}</span>` : ''}
        </div>
        <div id="ps-road-mount">${roadmapHtml(plan)}</div>
        ${rowsHtml(plan)}

        <div class="p-notes">
          <label class="p-k mono" for="p-notes-in">Your notes (optional)</label>
          <textarea id="p-notes-in" rows="2" placeholder="Anything you want to remember — never your seed words.">${esc(plan.notes || '')}</textarea>
        </div>

        <div class="p-actions">
          <button class="btn-primary" id="p-download">↓ Download my plan <span class="p-btn-note">(encryption optional)</span></button>
          <button class="btn-ghost" id="p-nostr">☁ Save to Nostr (encrypted) ↓</button>
          <label class="btn-ghost file-btn">Import a plan<input type="file" id="p-import" accept="application/json,.json" hidden /></label>
          <button class="btn-ghost" id="p-clear">Clear my plan</button>
          <button class="btn-danger" id="p-forget">Forget everything</button>
        </div>
        <p class="p-nostr-hint mono">Ways to keep it: a <strong>plain or password-encrypted file</strong> (most private — nothing leaves your browser), or <strong>your own Nostr</strong>, encrypted so only you can read it (syncs across devices). <a href="#nostr-sec">What's Nostr save? →</a></p>
        <p class="p-foot mono">This plan is stored only in this browser. A downloaded file is yours to keep — no seed words are ever in it. Never put your recovery words in the notes.</p>
      </div>`;

    document.getElementById('p-download').addEventListener('click', async () => {
      const p = loadLocal();
      if (!p) return;
      const choice = await downloadDialog();
      if (!choice) return;
      if (choice.mode === 'encrypted') {
        try {
          const env = await encryptPlanToEnvelope(p, choice.password);
          downloadEncryptedPlan(env);
          toast('Downloaded encrypted plan', 'ok');
        } catch (e) { toast('Encryption failed.', 'err'); }
      } else {
        downloadPlan(p);
        toast(`Downloaded ${PLAN_FILENAME}`, 'ok');
      }
    });

    // "Save to Nostr" — context-aware. Signed in → save straight away (no scroll).
    // Not signed in → drop down to the Nostr panel and focus the connect entry.
    document.getElementById('p-nostr').addEventListener('click', async () => {
      if (getSession()) {
        toast('Saving to Nostr…', 'ok');
        const ok = await doNostrSave((m, err) => { if (err) toast(m, 'err'); nzStatus(m, err); });
        if (ok) toast('✓ Saved to Nostr', 'ok');
      } else {
        document.getElementById('nostr-sec').scrollIntoView({ behavior: 'smooth', block: 'start' });
        setTimeout(() => {
          const focusEl = document.getElementById('nz-bunker-in') || document.getElementById('nz-ext');
          if (focusEl) focusEl.focus({ preventScroll: true });
        }, 500);
      }
    });
    paintNostrActionBtn();
    slimNostr();

    // save notes on blur (explicit-ish — typing then leaving the field)
    const notes = document.getElementById('p-notes-in');
    notes.addEventListener('blur', () => {
      const p = loadLocal();
      if (!p) return;
      if ((p.notes || '') !== notes.value) {
        p.notes = notes.value;
        saveLocal(p);
        toast('Notes saved', 'ok');
      }
    });

    // Two actions, because there are two layers. Clearing your PLAN keeps the things
    // that are not downstream of it — your answers and the hardware you own. Forgetting
    // EVERYTHING is the nuke, and now says so instead of hiding behind "clear my plan".
    document.getElementById('p-clear').addEventListener('click', async () => {
      const ok = await confirmDialog({
        title: 'Clear your plan?',
        message: 'This clears the setup you chose and your checklist progress. It keeps your quiz answers and the hardware you own, so you can pick a different setup without starting over.',
        confirmText: 'Clear plan', cancelText: 'Keep it',
      });
      if (ok) { clearPlanSelection(); toast('Plan cleared — your answers and hardware are still here', ''); render(); }
    });
    document.getElementById('p-forget').addEventListener('click', async () => {
      const ok = await confirmDialog({
        title: 'Forget everything?',
        message: 'This removes all of it from this browser — your answers, your setup, your checklist progress, and the hardware you told us you own. It can’t be undone. Download it first if you want to keep a copy.',
        confirmText: 'Forget everything', cancelText: 'Keep it', danger: true,
      });
      if (ok) { clearLocal(); toast('Everything cleared', ''); render(); }
    });

    // Update ONLY the roadmap block (so the picker mid-edit isn't torn down).
    function refreshRoadmap() {
      const mount = document.getElementById('ps-road-mount');
      if (!mount) return;
      mount.innerHTML = roadmapHtml(loadLocal() || emptyPlan());
      mount.querySelectorAll('[data-act]').forEach((b) => b.addEventListener('click', async () => {
        const slug = b.dataset.slug;
        if (b.dataset.act === 'assign') {
          const r = assignToPlan(slug);
          if (!r.ok && r.reason === 'full') { toast('This plan’s key slots are full — remove one first', 'err'); return; }
          refreshRoadmap();
        } else if (b.dataset.act === 'unassign') {
          removeFromPlan(slug); refreshRoadmap();
        } else if (b.dataset.act === 'retire') {
          const ok = await confirmDialog({ title: 'Retire this wallet?', message: `Remove “${ownedName(slug)}” from the wallets you own and from this plan? You can always add it back later.`, confirmText: 'Retire', cancelText: 'Keep it', danger: true });
          if (!ok) return;
          retireOwned(slug);
          render(); // rebuild status (picker) + roadmap together
        }
      }));
    }
    // Status: owned wallets are display-only; the make→model picker opens on demand.
    const editBtn = document.getElementById('ps-edit-own');
    if (editBtn) editBtn.addEventListener('click', () => {
      const mount = document.getElementById('ps-own-mount');
      const display = document.getElementById('ps-owned-display');
      if (display) display.hidden = true;
      mount.hidden = false;
      if (!mount.dataset.mounted) {
        mount.dataset.mounted = '1';
        mountOwnedPicker(mount, {
          initial: (loadLocal() || emptyPlan()).owned || [],
          privateInit: !!(loadLocal() || emptyPlan()).ownPrivate,
          onChange: (slugs, isPrivate) => { setOwnedAndPrivacy(slugs, isPrivate); refreshRoadmap(); },
        });
      }
    });
    refreshRoadmap();

    wireImport('p-import');
  }

  function wireImport(id) {
    const input = document.getElementById(id);
    if (!input) return;
    input.addEventListener('change', () => {
      const file = input.files && input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async () => {
        let raw;
        try { raw = JSON.parse(String(reader.result)); }
        catch (e) { toast('That doesn\'t look like a valid plan file.', 'err'); return; }
        let plan;
        if (isEncryptedEnvelope(raw)) {
          const pw = await promptPassword({
            title: 'Encrypted plan',
            message: 'This plan file is password-protected. Enter its password to import it.',
            confirmText: 'Decrypt & import', placeholder: 'Password',
          });
          if (pw == null) return;
          try { plan = await decryptEnvelope(raw, pw); }
          catch (e) { toast('Wrong password — couldn’t decrypt that file.', 'err'); return; }
        } else {
          try { plan = parsePlanText(String(reader.result)); }
          catch (e) { toast('That doesn\'t look like a valid plan file.', 'err'); return; }
        }
        if (!planHasContent(plan)) { toast('That file has no plan data.', 'err'); return; }
        saveLocal(plan);
        toast('Plan imported', 'ok');
        render();
        document.getElementById('plan').scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      reader.readAsText(file);
      input.value = '';
    });
  }

  render();

  // ── Nostr sovereign backend (lazy — nostr-tools loads only on first use) ──
  const nostrUi = document.getElementById('nostr-ui');
  let nostrMod = null;   // the adapter module, imported on demand
  let session = null;    // the connected signer (extension or bunker)

  async function loadNostr() {
    if (!nostrMod) nostrMod = await import('../data/nostr-adapter.js');
    return nostrMod;
  }
  const shortNpub = (npub) => `${npub.slice(0, 12)}…${npub.slice(-6)}`;

  function nzStatus(m, err) {
    const s = document.getElementById('nz-status');
    if (!s) return;
    s.hidden = false;
    s.textContent = m;
    s.classList.toggle('err', !!err);
    s.classList.toggle('ok', !err);
  }

  // Re-establish a LIVE signer from the remembered session when an action needs one.
  // Extension reconnects silently; a bunker re-uses its stored connection string (the
  // signer app still approves each request — the nsec never touches the browser).
  async function ensureSigner() {
    if (session) return session;
    const remembered = getSession();
    if (!remembered) throw new Error('Not signed in.');
    const mod = await loadNostr();
    if (remembered.kind === 'bunker') {
      // Resume as the SAME client the bunker already approved (see nostr-adapter).
      // If we can't (a pre-fix session with no stored channel key, or the bunker's
      // relay session has since expired), SELF-HEAL: clear the dead session and drop
      // the user to the reconnect box — no dead-end error, no hunting for "sign out".
      if (remembered.bunkerInput && remembered.clientKey) {
        try {
          nzStatus('Reconnecting to your signer…');
          session = await mod.reconnectBunker(remembered.bunkerInput, remembered.clientKey);
          return session;
        } catch (e) { /* fall through to the reconnect prompt */ }
      }
      needsReconnect();
      throw new Error('Your Nostr connection needs a refresh — paste your bunker link below and connect again, then save.');
    }
    nzStatus('Reconnecting your extension…');
    session = await mod.connectExtension();
    return session;
  }

  // Self-heal a stale/expired bunker session: forget it, show the connect box, focus it.
  function needsReconnect() {
    try { if (session && session.close) session.close(); } catch (e) {}
    session = null;
    clearSession();
    renderNostrDisconnected();
    const sec = document.getElementById('nostr-sec');
    if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
    setTimeout(() => { const f = document.getElementById('nz-bunker-in') || document.getElementById('nz-ext'); if (f) f.focus({ preventScroll: true }); }, 400);
  }

  // Save the current plan to Nostr (used by both the panel's Save button AND the top
  // "Save to Nostr" action once you're signed in). statusFn gets progress/result lines.
  async function doNostrSave(statusFn) {
    const say = statusFn || (() => {});
    const plan = loadLocal() || emptyPlan();
    if (!planHasContent(plan)) { say('Nothing to save yet — build a plan first (find your setup, tick the checklist).', true); return false; }
    try {
      const signer = await ensureSigner();
      say('Encrypting and publishing to your relays…');
      const mod = await loadNostr();
      const r = await mod.saveToNostr(plan, signer);
      say(`✓ Saved to Nostr — encrypted, accepted by ${r.ok} of ${r.total} relays.`);
      return true;
    } catch (e) { say(e && e.message ? e.message : 'Save failed.', true); return false; }
  }

  function renderNostrDisconnected() {
    const ext = typeof window !== 'undefined' && !!window.nostr;
    nostrUi.innerHTML = `
      <div class="nz-box">
        ${ext
          ? `<button class="btn-primary" id="nz-ext">Sign in with extension</button>`
          : `<p class="nz-hint mono">No Nostr browser extension detected — connect a bunker below.</p>`}
        <div class="nz-bunker">
          <input type="text" id="nz-bunker-in" placeholder="bunker://…  or  nostrconnect://…" autocomplete="off" spellcheck="false" />
          <button class="btn-ghost" id="nz-bunker-go">Connect bunker</button>
        </div>
        <p class="nz-status mono" id="nz-status" hidden></p>
      </div>`;
    const extBtn = document.getElementById('nz-ext');
    if (extBtn) extBtn.addEventListener('click', () => connectNostr('extension'));
    document.getElementById('nz-bunker-go').addEventListener('click', () => {
      const v = document.getElementById('nz-bunker-in').value.trim();
      if (!v) { nzStatus('Paste a bunker:// connection string first.', true); return; }
      connectNostr('bunker', v);
    });
  }

  async function connectNostr(kind, input) {
    nzStatus(kind === 'bunker' ? 'Connecting to your bunker — approve the request in your signer app…' : 'Waiting for your extension…');
    try {
      const mod = await loadNostr();
      session = kind === 'extension' ? await mod.connectExtension() : await mod.connectBunker(input);
      const { npubEncode } = await import('nostr-tools/nip19');
      const npub = npubEncode(session.pubkey);
      nzStatus('Signed in — fetching your profile…');
      const profile = await mod.fetchProfile(session.pubkey).catch(() => ({}));
      // Remember the login (browser-only, public data + our own channel key). The
      // bunker string AND the client channel key are kept so a return visit resumes
      // as the same already-approved client (the bunker secret is single-use — a
      // fresh client can't re-spend it); cleared on sign-out.
      setSession({ kind: session.kind, pubkey: session.pubkey, npub,
        name: profile.name || '', picture: profile.picture || '',
        bunkerInput: kind === 'bunker' ? input : undefined,
        clientKey: kind === 'bunker' ? session.clientKey : undefined });
      renderNostrConnected(npub, profile);
    } catch (e) {
      nzStatus(e && e.message ? e.message : 'Could not connect.', true);
    }
  }

  function renderNostrConnected(npub, profile) {
    profile = profile || {};
    const remembered = getSession() || {};
    const kindLabel = (session && session.kind) || remembered.kind || 'saved key';
    const name = profile.name || remembered.name || '';
    const pic = profile.picture || remembered.picture || '';
    const initial = (name || npub.replace(/^npub1/, '') || 'N').slice(0, 1).toUpperCase();
    nostrUi.innerHTML = `
      <div class="nz-box on">
        <div class="nz-id"><span class="nz-av nz-av-fb">${esc(initial)}</span><span class="nz-idtext"><span class="nz-name">${esc(name || 'Signed in')}</span> <span class="nz-npub mono">${esc(shortNpub(npub))}</span> <span class="nz-kind mono">via ${esc(kindLabel)}</span></span></div>
        <div class="nz-actions">
          <button class="btn-primary" id="nz-save">↑ Save my plan to Nostr</button>
          <button class="btn-ghost" id="nz-load">↓ Restore from Nostr</button>
          <button class="nz-off" id="nz-off">Sign out</button>
        </div>
        <p class="nz-status mono" id="nz-status" hidden></p>
      </div>`;
    // Upgrade the fallback initial to the real photo (src via property → injection-safe).
    if (pic) {
      const fb = nostrUi.querySelector('.nz-av-fb');
      const img = document.createElement('img');
      img.className = 'nz-av'; img.alt = ''; img.referrerPolicy = 'no-referrer';
      img.addEventListener('load', () => { if (fb) fb.replaceWith(img); });
      img.src = pic;
    }

    document.getElementById('nz-save').addEventListener('click', () => doNostrSave(nzStatus));

    document.getElementById('nz-load').addEventListener('click', async () => {
      try {
        const signer = await ensureSigner();
        nzStatus('Fetching from your relays and decrypting…');
        const mod = await loadNostr();
        const plan = await mod.loadFromNostr(signer);
        if (!plan || !planHasContent(plan)) { nzStatus('No saved plan found on your relays for this key.', true); return; }
        saveLocal(plan);
        nzStatus('✓ Restored from Nostr into this browser.');
        render();
        document.getElementById('plan').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (e) { nzStatus(e && e.message ? e.message : 'Restore failed.', true); }
    });

    document.getElementById('nz-off').addEventListener('click', () => {
      if (session && session.close) session.close();
      session = null;
      clearSession();
      renderNostrDisconnected();
    });
  }

  // On load: if this browser remembers a Nostr login, show the signed-in panel right
  // away (the live signer re-establishes only when they actually save/restore).
  const rememberedNostr = getSession();
  if (rememberedNostr && rememberedNostr.npub) renderNostrConnected(rememberedNostr.npub, rememberedNostr);
  else renderNostrDisconnected();
  paintNostrActionBtn();
  slimNostr();

  // Keep the top action button + panel in sync with sign-in/out from anywhere (the nav
  // menu, another tab). A sign-out elsewhere resets this page's panel too.
  window.addEventListener('bkeys-nostr-change', () => {
    paintNostrActionBtn();
    slimNostr();
    if (!getSession()) { if (session && session.close) session.close(); session = null; renderNostrDisconnected(); }
  });

  // Arriving from the nav's "Sign in with Nostr" (/my-plan#connect-nostr) → drop to the connect box.
  if (location.hash === '#connect-nostr' && !getSession()) {
    setTimeout(() => {
      document.getElementById('nostr-sec').scrollIntoView({ behavior: 'smooth', block: 'start' });
      const f = document.getElementById('nz-bunker-in') || document.getElementById('nz-ext');
      if (f) f.focus({ preventScroll: true });
    }, 300);
  }
</script>

