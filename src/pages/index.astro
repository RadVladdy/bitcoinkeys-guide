---
import Base from '../layouts/Base.astro';
import Ladder from '../components/Ladder.astro';
import { lessons } from '../data/lessons.js';
import { lessonCount, levels } from '../data/curriculum.js';
import { questionCountWord, questionCountWordCap } from '../data/quiz.js';
import { ruleByKey, ruleCountWord } from '../data/rules.js';

// The governing rule is PULLED, never restated — same contract as /about.
const simplest = ruleByKey('simplest-setup');
---
<Base
  title="BitcoinKeys.guide — hold your own Bitcoin, and understand every step"
  description="An independent, Bitcoin-only, plain-English guide to self-custody: choose a wallet, back up your keys, move to cold storage, and upgrade safely. We hold no keys and sell no device."
  ogTitle="BitcoinKeys.guide — hold your own Bitcoin"
>
  <section class="hero prose">
    <p class="eyebrow">Independent · Bitcoin-only · nothing to sell you</p>
    <h1>Hold your own Bitcoin —<br><span class="accent">and understand every step.</span></h1>
    <p class="lead">Your Bitcoin isn’t really yours until you hold the <a href="/glossary#private-key">keys</a> — the secret that actually controls the coins. This is the plain-English guide to doing that safely, from your first wallet to storage solid enough to pass on to your family.</p>
    <!-- Education-forward since 2026-07-28: learning is the primary action, the
         setup finder the secondary. The band directly below still carries it. -->
    <div class="cta-row">
      <a href="/start" class="btn btn-primary">Start with the basics <span class="arw">→</span></a>
      <a href="/find-your-setup" class="btn btn-ghost">Or find your setup — 2 minutes</a>
    </div>
  </section>

  <section class="quiz-band">
    <div class="qb-inner">
      <div>
        <p class="qb-kicker mono">The 2-minute setup finder</p>
        <h2 class="qb-h">Not sure where you belong? Answer {questionCountWord} questions.</h2>
        <p class="qb-sub">Get a setup matched to what you're actually protecting against, a <strong>roadmap from where you are today</strong>, and a checklist — built around any hardware wallets you already own. <strong>We never ask how much Bitcoin you hold</strong>, and it all runs in your browser.</p>
      </div>
      <a href="/find-your-setup" class="btn btn-primary qb-cta">Find your setup <span class="arw">→</span></a>
    </div>
  </section>

  <section class="pledge-band">
    <div class="pledge-grid">
      <div>
        <span class="k mono">no device to sell</span>
        <p>We don’t make or sell hardware, so we can compare every wallet honestly.</p>
      </div>
      <div>
        <span class="k mono">no keys held</span>
        <p>We never touch your coins or your keys. This is a guide, not a service.</p>
      </div>
      <div>
        <span class="k mono">Bitcoin only</span>
        <p>No altcoins, no “yield,” no distractions. Just holding Bitcoin well.</p>
      </div>
    </div>
  </section>

  <!-- This section used to be headed "The one idea the whole guide is built on"
       and RESTATED rule 03 in its own words ("adequately covers your threat model"
       — jargon the rules deliberately avoid). Two problems, both fixed 2026-07-30:
       the rule is now PULLED from rules.js like /about does, so a reworded rule
       can't leave the front door arguing for the old one; and "the one idea" is
       the umbrella's slot ("Verify. Don't trust.", deliberately unnumbered), which
       /standard already honours. Three surfaces were each claiming to be the one
       idea, and none of them was the one rules.js designates. -->
  <section>
    <h2>The rule the whole guide rests on</h2>
    <div class="prose">
      <div class="callout">
        <span class="label">Rule {String(simplest.n).padStart(2, '0')} of {ruleCountWord}</span>
        <p class="rule-line">{simplest.rule}</p>
        <p set:html={simplest.body}></p>
      </div>
      <p class="sub">It’s one of <a href="/learn/rules">{ruleCountWord} rules</a> that hold up everything here — the first lesson of the course, and two minutes to read. Every lesson after it is one rule in full.</p>
      <p class="sub">Not sure what those risks even are? Start with the honest map: <a href="/learn/how-bitcoin-is-lost">how people actually lose Bitcoin →</a></p>
    </div>
  </section>

  <section>
    <h2>The ladder</h2>
    <p class="sub prose" style="margin-bottom:1.4rem;">Every setup fits on one ladder of rising complexity. <strong>Almost everyone belongs on the first rung or two</strong> — the names get technical as you climb, but you only move up if a real risk pushes you there. Find the lowest rung that covers you — and move up later only if your situation outgrows it.</p>
    <Ladder />
    <!-- The rungs stopped being pages on 2026-07-30 — they are sections of the one
         ladder lesson, and the build walkthroughs moved to /checklist. This line
         promised "a full walkthrough" behind each rung for both of those reasons. -->
    <p class="sub" style="margin-top:1.2rem; font-size:0.9rem;">Each rung opens out below — what it solves, what it costs you, and who it’s for. <a href="/learn/ladder">Read the full ladder →</a></p>
  </section>

  <section>
    <h2>Two doors in</h2>
    <div class="grid cols-2">
      <a href="/start" class="card">
        <h3>I want to understand it first →</h3>
        <p class="sub">The whole guide in teaching order — {lessonCount} lessons across {levels.length} levels, from what a key actually is to the ladder of real setups. Read it and you’ll understand your own setup better than most people who already have one.</p>
      </a>
      <a href="/find-your-setup" class="card">
        <h3>Just tell me what to do →</h3>
        <p class="sub">{questionCountWordCap} plain questions, and we name the setup that fits what you’re actually protecting against — then turn it into a step-by-step checklist. We never ask how much Bitcoin you hold.</p>
      </a>
    </div>
  </section>

  <section>
    <h2>The skills, in plain English</h2>
    <p class="sub prose" style="margin-bottom:1.4rem;">Whatever setup you land on, these are the hands-on skills of holding your own Bitcoin. Each is a short, jargon-free lesson.</p>
    <div class="grid cols-2">
      {lessons.map((h) => (
        <a href={`/learn/${h.slug}`} class="card">
          <h3>{h.title.split('—')[0].trim()} →</h3>
          <p class="sub">{h.lead}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="prose">
    <h2>Why trust this one?</h2>
    <p>Almost every self-custody guide is written by someone with something to sell — a hardware brand, a custody service, an exchange, an affiliate link. That doesn’t make them wrong, but it bends the advice. We hold no keys and sell no device, so the only thing we’re steering you toward is the setup that actually fits you.</p>
    <p>Every page carries the date it was last checked against reality, and the whole thing is built in the open. <a href="/about">More about how this works →</a></p>
  </section>
</Base>

<style>
  .hero { padding: 1.5rem 0 2.4rem; }
  .hero h1 { margin-bottom: 1rem; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.8rem; }

  .quiz-band { margin: 0 0 2.5rem; border: 1px solid var(--accent); border-radius: var(--radius); background: var(--accent-soft); padding: 1.6rem 1.8rem; }
  .qb-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .qb-kicker { color: var(--accent); font-size: 0.74rem; letter-spacing: 0.08em; margin: 0 0 0.4rem; }
  .qb-h { font-size: 1.3rem; margin: 0 0 0.5rem; line-height: 1.2; }
  .qb-sub { margin: 0; color: var(--muted); font-size: 0.95rem; max-width: 54ch; }
  .qb-cta { white-space: nowrap; }
  @media (max-width: 640px) { .qb-inner { flex-direction: column; align-items: flex-start; } }

  .pledge-band { margin: 1rem 0 2.5rem; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); padding: 1.8rem 0; }
  .pledge-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  .pledge-grid .k { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 0.4rem; }
  .pledge-grid p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  /* The rule states itself at the same size it does in the band and on the rules
     page — one sentence, one size, everywhere the guide states a rule. */
  .rule-line { font-size: 1.18rem; font-weight: 650; line-height: 1.38; color: var(--text); margin-bottom: 0.6rem; }
  @media (max-width: 640px) { .rule-line { font-size: 1.08rem; } }
  @media (max-width: 720px) { .pledge-grid { grid-template-columns: 1fr; gap: 1.1rem; } }
</style>
