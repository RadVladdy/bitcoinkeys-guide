---
// Security advisory — the Coldcard seed-generation flaw exploited 2026-07-30.
//
// This page exists because the guide RATES the affected device in its top tier
// and, until 2026-08-06, recommended it in the setup finder. A guide that sends
// readers to a device and then goes quiet when that device's seeds turn out to
// be guessable is not worth reading. Everything factual here derives from
// advisories.js so the banner, the device cards and this page cannot drift.
//
// TONE: calm and specific. The vendor's own guidance is that panicked migration
// causes its own losses, and that matches everything this guide teaches. The
// page answers two DIFFERENT questions in two different places — "is my seed at
// risk" and "is this device still worth buying" — because a worried reader will
// otherwise collapse them into one and get both wrong.
//
// THREE SECTIONS NOW ANSWER THE SECOND QUESTION AND THEY ARE NOT INTERCHANGEABLE:
// the rating review (does it still clear the published standard — yes, unchanged)
// then the withdrawn recommendation (would we tell you to buy one — no, since
// 08-06) then the owner guidance inside it. A reader scrolling past the first and
// stopping at the second gets a coherent answer; one who stops at the first gets
// a stale one, which is why the review carries a forward note and the withdrawal
// carries a backward one. Both directions, deliberately.
import Base from '../../layouts/Base.astro';
import { advisories } from '../../data/advisories.js';
import { walkthroughHref } from '../../data/walkthrough.js';
const a = advisories.find((x) => x.id === 'coldcard-seed-entropy-2026');
const fmt = (iso) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base
  title={`${a.title} · BitcoinKeys.guide`}
  description="A firmware flaw made some Coldcard seed phrases guessable, and wallets were drained on 30 July 2026. Which devices and firmware are affected, what protected people, and exactly what to do — in plain English."
  verified={a.lastUpdated}
>
  <section class="prose">
    <p class="eyebrow">Security advisory</p>
    <h1>Coldcard seed-generation flaw — <span class="accent">check whether your seed is affected</span></h1>

    <div class="adv-status">
      <span class="adv-pill mono">Active</span>
      <span class="adv-meta mono">Published {fmt(a.published)} · affects {a.affectsDevices.join(' · ')}</span>
    </div>

    <p class="lead">{a.summary}</p>

    {a.notRecommended && (
      <p class="adv-split">
        <strong>Two questions, two answers, and they are further apart than you would expect.</strong>
        If you <strong>own</strong> one of these devices, the section below is the one to read: your exposure
        depends on your seed, not on the news. If you are <strong>deciding whether to buy</strong> one,
        skip to <a href="#not-recommended">why we no longer recommend it</a> — a decision we took on
        {' '}{fmt(a.notRecommended.since)}, and which did not change the device's rating.
      </p>
    )}

    <div class="adv-box adv-urgent">
      <p class="adv-k mono">The thing most people get wrong</p>
      <p class="adv-claim">“{a.keyMisunderstanding.claim}”</p>
      <p>{a.keyMisunderstanding.truth}</p>
    </div>

    <h2 id="is-your-seed-affected">Is your seed affected?</h2>
    <p>
      This depends on <strong>which device you generated the seed on</strong> and <strong>roughly when</strong> —
      not on the firmware you are running today.
    </p>
    {a.exposure.map((e) => (
      <div class={'adv-band' + (e.band === 'Not affected by this flaw' ? ' is-ok' : e.band === 'Highest risk' ? ' is-bad' : '')}>
        <p class="adv-k mono">{e.band}</p>
        <p class="adv-who">{e.who}</p>
        <p class="adv-detail">{e.detail}</p>
      </div>
    ))}

    <h2>What to do</h2>
    <ol class="adv-steps">
      {a.whatToDo.map((step) => <li>{step}</li>)}
    </ol>

    <div class="callout">
      <span class="label">If you are generating a fresh seed this week</span>
      <p style="margin:0">
        Dice are why some people were never in scope, and the migration is the one moment the extra hour costs
        you nothing you were not already spending. <a href="/roll-your-own-seed">Roll your own seed with dice</a>
        walks the procedure, with the current menu path for each device we rate — and, as everywhere on this
        site, it never asks what you rolled.
      </p>
    </div>

    <h2>The fixed firmware</h2>
    <ul class="adv-fw">
      {a.fixedFirmware.map((f) => <li><strong>{f.model}</strong> — {f.version}</li>)}
    </ul>
    <p class="adv-detail">
      Update before you generate anything new, so the device you are about to trust is generating properly.
      Updating does not repair an existing seed — see above.
    </p>

    <h2>Where we stand</h2>
    <p>{a.ourTake}</p>

    {a.ratingReview && (
      <div class="adv-review">
        <h2 id="rating-review">The rating review we promised</h2>
        <p class="adv-detail">Published {a.ratingReview.published} — the conclusion, not a quiet edit.</p>
        <p><strong>{a.ratingReview.verdict}</strong></p>
        <p>{a.ratingReview.intro}</p>
        <ul class="adv-gates">
          {a.ratingReview.gates.map((g) => (
            <li>
              <span class="adv-gate-k">{g.holds ? 'Holds' : 'Fails'}</span>
              <strong>{g.gate}</strong>
              <span class="adv-gate-n">{g.note}</span>
            </li>
          ))}
        </ul>
        <p>{a.ratingReview.reckoning}</p>
        <p>{a.ratingReview.whyNoNewGate}</p>
        <p>{a.ratingReview.instead}</p>
        <p><a href={a.ratingReview.insteadHref}>{a.ratingReview.insteadLabel} →</a></p>
        {a.ratingReview.supersededNote && (
          <p class="adv-super"><strong>Since this was published:</strong> {a.ratingReview.supersededNote} <a href="#not-recommended">Read it →</a></p>
        )}
      </div>
    )}

    {a.notRecommended && (
      <div class="adv-nr">
        <h2 id="not-recommended">{a.notRecommended.headline}</h2>
        <p class="adv-detail">Our recommendation, decided {fmt(a.notRecommended.since)} — and it is a different thing from the rating above, which has not moved.</p>

        <div class="adv-box adv-urgent">
          <p class="adv-k mono">The position, in one paragraph</p>
          <p>{a.notRecommended.short}</p>
        </div>

        <h3>Why</h3>
        {a.notRecommended.why.map((p) => <p>{p}</p>)}

        <h3>What is documented, and by whom</h3>
        <p class="adv-detail">{a.notRecommended.documented.intro}</p>
        {a.notRecommended.documented.items.map((d) => (
          <div class="adv-band">
            <p class="adv-k mono">{d.label}</p>
            <p class="adv-detail">{d.body}</p>
          </div>
        ))}
        <ul class="adv-fw">
          {a.notRecommended.sources.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.label} ↗</a></li>
          ))}
        </ul>

        <div class="adv-box is-owner">
          <p class="adv-k mono">{a.notRecommended.ifYouOwnOne.headline}</p>
          {a.notRecommended.ifYouOwnOne.body.map((p) => <p>{p}</p>)}
          <p style="margin-bottom:0"><a href="#is-your-seed-affected">Check whether your seed is in scope ↑</a> · <a href={walkthroughHref}>Setup walkthroughs, including both Coldcards →</a></p>
        </div>

        <h3>When we would change our minds</h3>
        <p>{a.notRecommended.revisit}</p>
      </div>
    )}

    <div class="adv-box">
      <p class="adv-k mono">The lesson worth keeping</p>
      <p>{a.lesson}</p>
    </div>

    <h2>Sources</h2>
    <p class="adv-detail">This is not our research. The technical findings are:</p>
    <ul class="adv-fw">
      {a.sources.map((s) => (
        <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.label} ↗</a></li>
      ))}
    </ul>
    <p class="adv-detail">
      Figures were still being revised as researchers mapped the on-chain activity, so treat any single total as provisional.
      What is not provisional is the flaw, the affected firmware ranges, and what mitigated it.
    </p>
  </section>
</Base>

<style>
  .adv-status { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin: -.4rem 0 1.4rem; }
  .adv-pill { background: var(--danger); color: var(--accent-ink); border-radius: 999px; padding: .15rem .7rem; font-size: .78rem; letter-spacing: .04em; text-transform: uppercase; }
  .adv-meta { color: var(--muted); font-size: .85rem; }
  .adv-box { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.3rem; margin: 1.6rem 0; background: var(--accent-soft); }
  .adv-urgent { border: 1px solid var(--danger); background: var(--danger-dim); }
  .adv-k { font-size: .78rem; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); margin: 0 0 .4rem; }
  .adv-claim { font-style: italic; font-size: 1.05rem; margin: 0 0 .6rem; }
  .adv-band { border-left: 3px solid var(--line); padding: .2rem 0 .2rem 1rem; margin: 1.1rem 0; }
  .adv-band.is-bad { border-left-color: var(--danger); }
  .adv-band.is-ok { border-left-color: var(--safe); }
  .adv-who { font-weight: 600; margin: 0 0 .3rem; }
  .adv-detail { color: var(--muted); }
  .adv-steps li { margin-bottom: .7rem; }
  .adv-fw { list-style: none; padding-left: 0; }
  .adv-fw li { margin-bottom: .4rem; }
  .adv-review { border-top: 1px solid var(--line); margin-top: 2rem; padding-top: .4rem; }
  .adv-gates { list-style: none; padding-left: 0; margin: 1.2rem 0; }
  .adv-gates li { border-left: 3px solid var(--safe); padding: .2rem 0 .2rem 1rem; margin: 1rem 0; }
  .adv-gate-k { display: block; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--safe); margin-bottom: .15rem; }
  .adv-gate-n { display: block; color: var(--muted); margin-top: .25rem; }

  /* The two-audiences signpost, directly under the lead. It is the first thing a
     reader meets who arrived from a device card, and it exists because the same
     page has to send a buyer and an owner to different places. */
  .adv-split { border: 1px dashed var(--line); border-radius: var(--radius); padding: .9rem 1.1rem; background: var(--accent-soft); }

  /* Forward pointer FROM the rating review TO the withdrawal. The review is
     unamended by design, so without this a reader who stops there leaves with a
     conclusion we have since qualified. */
  .adv-super { border-left: 3px solid var(--danger); padding: .2rem 0 .2rem 1rem; color: var(--muted); margin-top: 1.4rem; }

  .adv-nr { border-top: 1px solid var(--line); margin-top: 2.4rem; padding-top: .4rem; }
  /* The owner box is the one deliberately CALM block in a red section — a reader
     who owns the device has just read three paragraphs about why we would not
     buy it, and the next thing they see should not look like another alarm. */
  .adv-box.is-owner { border: 1px solid var(--safe); background: var(--safe-dim); }
</style>
