---
import Base from '../layouts/Base.astro';
import { resources } from '../data/resources.js';
const levelClass = { Introductory: 'lv-intro', Foundational: 'lv-found', Advanced: 'lv-adv' };
---
<Base
  title="Further reading & resources · BitcoinKeys.guide"
  description="A short, hand-picked list of the best independent Bitcoin self-custody resources — practitioners, tools, videos, and books. Bitcoin-only, no affiliate links."
  verified="2026-07-31"
>
  <section class="prose">
    <p class="eyebrow">Resources</p>
    <h1>Further reading — <span class="accent">the good stuff</span>, none of the noise</h1>
    <p class="lead">A short, honest list of where to go deeper. Every pick is independent and Bitcoin-focused. No affiliate links, no padding — just resources we’d actually send a friend to.</p>
    <p class="sub">Each is tagged by depth: <span class="lv lv-intro">Introductory</span> <span class="lv lv-found">Foundational</span> <span class="lv lv-adv">Advanced</span>.</p>
  </section>

  {resources.map((cat) => (
    <section>
      <h2 set:html={cat.name}></h2>
      <div class="rlist">
        {cat.items.map((it) => {
          const Tag = it.url ? 'a' : 'div';
          return (
            <Tag {...(it.url ? { href: it.url, target: '_blank', rel: 'noopener' } : {})} class="rcard">
              <div class="rhead">
                <span class="rtitle" set:html={it.title}></span>
                <span class:list={['lv', levelClass[it.level] ?? '']}>{it.level}</span>
              </div>
              <p class="rwhat" set:html={it.what}></p>
              {it.url && <span class="rurl">{it.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗</span>}
            </Tag>
          );
        })}
      </div>
    </section>
  ))}

  <section class="prose">
    <div class="callout">
      <span class="label">A note on trust</span>
      <p>We list these because they’re useful, not because anyone paid us — we take no affiliate money. As always, think for yourself, and never enter your seed phrase anywhere just because a resource is reputable.</p>
    </div>
  </section>
</Base>

<style>
  .rlist { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.2rem; }
  @media (max-width: 720px) { .rlist { grid-template-columns: 1fr; } }
  .rcard { display: block; text-decoration: none; color: var(--text); background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius); padding: 1.2rem 1.3rem; transition: border-color .14s ease, transform .14s ease; }
  a.rcard:hover { border-color: var(--accent); transform: translateY(-2px); }
  .rhead { display: flex; align-items: start; justify-content: space-between; gap: 0.7rem; margin-bottom: 0.4rem; }
  .rtitle { font-weight: 650; letter-spacing: -0.01em; line-height: 1.3; }
  .rwhat { margin: 0; color: var(--muted); font-size: 0.92rem; line-height: 1.5; }
  .rurl { display: inline-block; margin-top: 0.6rem; font-family: var(--mono); font-size: 0.76rem; color: var(--accent); }
  .lv { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700;
    padding: 0.15rem 0.45rem; border-radius: 999px; white-space: nowrap; flex: 0 0 auto; }
  .lv-intro { color: var(--safe); background: var(--safe-dim); }
  .lv-found { color: var(--accent); background: var(--accent-dim); }
  .lv-adv { color: var(--warn); background: var(--warn-dim); }
</style>
