---
import Base from '../layouts/Base.astro';
import { questionCountWordCap } from '../data/finder-questions.js';
// The ranked-worries question was replaced by the risk assessment (2026-07-31)
// and is asked nowhere, so the shared count is the count this page asks.
const fitCountCap = questionCountWordCap;
---
<Base
  title="Find your setup — which self-custody setup fits you · BitcoinKeys.guide"
  description={`${fitCountCap} plain questions plus a short risk assessment → a self-custody setup that fits you, a personal roadmap from where you are now (built around any wallets you already own), and an ordered checklist. Runs entirely in your browser — we never ask how much Bitcoin you hold.`}
  verified="2026-07-31"
>
  <section class="prose">
    <p class="eyebrow">Find your setup</p>
    <h1>Which self-custody setup <span class="accent">fits you</span>?</h1>
    <p class="lead">{fitCountCap} plain questions and a short risk assessment — we show you the standard picture of <strong>how Bitcoin is actually lost</strong>, then find out whether yours differs. Out the other side: a setup that fits you, a <strong>roadmap from where you are today</strong> (built around any wallets you already own), and a checklist to get there. No accounts, no jargon, no "best device" hand-waving.</p>
    <p class="risks-hint">The assessment shows you the standard risk picture as you go. If you'd rather read the full story first, it's the same base rates as <a href="/learn/how-bitcoin-is-lost">how people actually lose Bitcoin</a>.</p>

    {/* THE PRIVACY PROMISE IS STATED IN THREE PLACES with per-page framing:
        index.astro's "Nothing logged" pledge item, this note, and my-plan's
        .promise block. The CLAIMS must stay identical (browser-only, no server,
        file download, Nostr copy encrypted before it leaves) even though the
        framing differs — if you change a claim here, change all three. */}
    <div class="privacy-note">
      <span class="pn-label mono">🔒 Notice what we don't ask</span>
      <p>We never ask <strong>how much Bitcoin you hold</strong> — no website should, and telling one is bad practice. This asks about the <em>consequences</em>, not amounts. If you already own hardware wallets it'll ask which ones — purely to tailor your roadmap; that step is <strong>optional</strong>, you can choose "rather not say," and it never leaves your browser. Everything here runs <strong>entirely in your browser</strong>: nothing is sent, stored, logged, or put in the web address. Close the tab and it's gone — unless you deliberately <a href="/my-plan">save your plan</a>, which is a separate choice. You pick where: this browser, a file you download, or — only if you choose it — <strong>encrypted to your own Nostr key</strong> on your own relays. <strong>We never see any of them</strong>, and there is no account and no server on our side.</p>
    </div>
  </section>

  <div id="finder" class="finder" aria-live="polite">
    <div id="q-resume" hidden></div>
    <div class="f-progress mono" id="q-progress"></div>
    <div id="q-card"></div>
    <div id="q-result" hidden></div>
    <noscript><p class="ns">This needs JavaScript. You can reach the same answer by hand: read <a href="/start">Start here</a> for the whole guide in order, then <a href="/learn/ladder">the configuration ladder</a> to place yourself, then work <a href="/checklist">the checklist</a>.</p></noscript>
  </div>
</Base>

<script>
  import { questions } from '../data/finder-questions.js';
  import {
    CONCERNS, CONCERN_KEYS, SECTION_ORDER, defaultsFor, scoreWord, HALF_BAND,
    prompts, promptsFor, promptById, scoreFromPrompts, shimScores, recommendV2, FAMILY,
    WORRY_CONCERNS,
  } from '../data/finder.js';
  import { numberWord } from '../data/numbers.js';
  import { wallets, keysForSetup, slugForName, assessDevices, ownableDevices } from '../data/wallets.js';
  import { rungAnchor } from '../data/ladder.js';
  import { savePlannedSetup, plannedSetupRung, plannedSetupLabel, plannedKeysNeeded, loadLocal, clearPlanSelection, plannedSetupSource } from '../data/plan.js';
  import { mountOwnedPicker } from '../data/owned-picker.js';
  import { confirmDialog } from '../data/ui-dialog.js';

  // The five plain questions — the ranked-worries question is retired; the
  // assessment (finder.js prompts → scores)
  // sits in its place, between stakes and recovery, because the stakes answer
  // sets the assessment's defaults.
  const fitQuestions = questions;
  const questionById = Object.fromEntries(fitQuestions.map((q) => [q.id, q]));
  const CONCERN_BY_KEY = Object.fromEntries(CONCERNS.map((c) => [c.key, c]));
  // The four WALKED risks — shares of expected loss, each with its own section
  // and prompt bank. Distinct from the two concerns marked `preference: true`
  // (stakes and exposure), which are scored the same way but come straight from
  // a question the reader already answered rather than from prompts.
  //
  // These must not be mixed: the intro says "here's what actually goes wrong"
  // and presents the bars as base rates, which is true of the four and false of
  // the other two. Rendering all six there also produced two broken bars, since
  // their defaults need the sovereignty and stakes answers to exist at all.
  const RISK_CONCERNS = SECTION_ORDER.map((k) => CONCERN_BY_KEY[k]);
  const ANSWER_CONCERNS = CONCERNS.filter((c) => c.preference);

  // ── state ──
  // Answers ride in memory only, exactly as before — nothing persists unless the
  // user explicitly saves. The assessment adds three pieces alongside `answers`:
  //   checked    — prompt ids tapped true ("true of me")
  //   skipped    — concerns where the user kept the standard estimate
  //   overrides  — per-concern scores set by hand on the review screen (these
  //                take precedence in the engine: scores > prompts > shim)
  const answers = {};
  const checked = new Set();
  const skipped = new Set();
  const overrides = {};
  // Concerns whose level is an ESTIMATE from a saved plan's old ranked-worries
  // answer (via shimScores) rather than anything walked here. Walking a section
  // or adjusting its bar replaces the estimate with the real thing.
  const estimatedConcerns = new Set();
  let assessDone = false;      // reached the review screen, or prefilled from a save
  let assessEstimated = false; // any part of the picture came from a legacy shim
  let pos = 0;

  const elProgress = document.getElementById('q-progress');
  const elCard = document.getElementById('q-card');
  const elResult = document.getElementById('q-result');

  function esc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
  // The finder recommends devices by NAME; map a recommendation's wallet list → slugs
  // (saved as recommendedDevices → suggested in empty slots + annotated on /wallets).
  function recSlugsFrom(list) { return (list || []).map((d) => slugForName(d.name)).filter(Boolean); }

  // ── WHAT YOU ALREADY OWN, read against the setup we just recommended ────────
  //
  // The finder has always ASKED which hardware the reader owns and then made
  // device suggestions as though it had not. This closes that: it names what
  // they own, says which of it works for this setup and which does not, counts
  // how many keys short they are, and suggests only devices they do not already
  // have.
  //
  // READ-ONLY, DELIBERATELY. No "I own this" control, no picker, no add or
  // remove. Choosing and editing hardware is /my-plan's job — the three-phase
  // split (SELECT → BUILD THE PLAN → EXECUTE) exists to stop this page becoming
  // the place you do it. Surfacing a verdict is fine; offering an action on it
  // is what would break the split.
  const brandOf = (slug) => (ownableDevices.find((d) => d.slug === slug) || {}).brand || null;
  const listNames = (arr) => {
    const n = arr.map((d) => esc(d.name));
    if (n.length <= 1) return n[0] || '';
    return `${n.slice(0, -1).join(', ')} and ${n[n.length - 1]}`;
  };

  function ownedContext(primary) {
    const owned = Array.isArray(answers.ownedDevices) ? answers.ownedDevices : [];
    // Nothing to say: they skipped the step, or chose not to tell us. "Rather
    // not say" is an answer we asked for and it gets respected in silence.
    if (answers.ownPrivate || !owned.length) return '';

    const assessed = assessDevices(owned);
    if (!assessed.length) return '';
    const clears = assessed.filter((d) => d.verdict === 'cold');
    const spending = assessed.filter((d) => d.verdict === 'spending');
    const below = assessed.filter((d) => d.verdict === 'disqualified');
    const unrated = assessed.filter((d) => d.verdict === 'unrated');

    // Keys YOU hold. For collaborative custody that is two of the three — the
    // service holds the other one, and it is not something you go and buy.
    const need = keysForSetup({ rungSlug: primary.rungSlug, label: primary.rungLabel, tier: primary.tier }) || 1;
    const short = Math.max(0, need - clears.length);

    const parts = [];
    parts.push(`<p><strong>You told us you own ${listNames(assessed)}.</strong> Here is how that lands against this setup — nothing to change here, this is just what we can already see.</p>`);

    if (clears.length) {
      parts.push(`<p><span class="ro-k ok mono">Works here</span> ${listNames(clears)} — ${clears.length === 1 ? 'it clears' : 'they clear'} our bar, so ${clears.length === 1 ? 'it can be' : 'they can be'} ${need > 1 ? 'one of your keys' : 'the key'} for this setup. No need to buy ${clears.length === 1 ? 'another' : 'more'} on ${clears.length === 1 ? 'its' : 'their'} account.</p>`);
      // A CLEARED DEVICE WE HAVE STOPPED RECOMMENDING. Phrased as context and
      // explicitly not as an action, for two reasons that both matter here.
      // This is the SELECT page — deciding which setup and nothing else — and a
      // verdict a reader cannot act on yet is a defect on it even when correct;
      // the device decisions live one page along, on /my-plan. And the honest
      // message to an owner is that their kit still works, which is what the
      // line above already told them and what this must not contradict.
      const flaggedClears = clears.filter((d) => d.notRecommended);
      if (flaggedClears.length) {
        parts.push(`<p><span class="ro-k warn mono">Worth knowing</span> ${listNames(flaggedClears)} — ${flaggedClears.length === 1 ? 'this one still clears our bar and we have stopped recommending it for NEW purchases' : 'these still clear our bar and we have stopped recommending them for NEW purchases'}. That is a call about the maker rather than your hardware, it changes nothing you need to do today, and it is worth reading before you buy your next device. <a href="/advisory/coldcard-seed-entropy#not-recommended">Why →</a></p>`);
      }
    }
    if (spending.length) {
      parts.push(`<p><span class="ro-k warn mono">Not for this</span> ${listNames(spending)} — we rate ${spending.length === 1 ? 'it' : 'them'} <a href="/standard#built-for-spending">built for spending</a> rather than a long-term vault. Genuinely useful for money you are moving; not what we would put savings behind.</p>`);
    }
    if (below.length) {
      parts.push(`<p><span class="ro-k bad mono">Doesn’t clear our bar</span> ${listNames(below)} — <a href="/standard">why we say so</a>. You are not obliged to replace ${below.length === 1 ? 'it' : 'them'}, and nothing here says throw ${below.length === 1 ? 'it' : 'them'} away; we would not build this setup on ${below.length === 1 ? 'it' : 'them'}.</p>`);
    }
    if (unrated.length) {
      parts.push(`<p><span class="ro-k mono">Not rated by us</span> ${listNames(unrated)} — we have not reviewed ${unrated.length === 1 ? 'this model' : 'these models'}, which is not the same as failing. Most models never have been, and inventing a verdict would be worse than saying so.</p>`);
    }

    // THE COUNT. This is the sentence the reader came for.
    if (short === 0) {
      parts.push(`<p class="ro-count"><strong>You already have the hardware for this.</strong> ${need > 1 ? `This setup needs ${numberWord(need)} keys of your own, and ${clears.length === need ? 'that is exactly what you hold' : `you hold ${numberWord(clears.length)} that clear the bar`}.` : 'This setup needs one key, and you have one that clears the bar.'}</p>`);
    } else {
      parts.push(`<p class="ro-count"><strong>You are ${numberWord(short)} short.</strong> This setup needs ${need > 1 ? `${numberWord(need)} keys of your own` : 'one key'}${primary.rungSlug === 'collaborative' ? ' — the service holds the third, so that one is not yours to buy' : ''}, and ${clears.length ? `you hold ${numberWord(clears.length)} that ${clears.length === 1 ? 'clears' : 'clear'} our bar` : 'nothing you own clears our bar yet'}.</p>`);
    }

    // ONE BRAND, ONE KEY — only worth saying where it changes what to buy.
    if (need > 2 && clears.length > 1) {
      const brands = new Set(clears.map((d) => brandOf(d.slug)).filter(Boolean));
      if (brands.size < clears.length) {
        parts.push(`<p class="ro-note">One thing worth knowing: <strong>use a different maker for each key.</strong> Some of what you own is from the same maker, and with one maker covering two of three keys, a single vendor’s flaw reaches enough of them to spend your coins.</p>`);
      }
    }

    const cls = below.length ? 'warn' : (short === 0 ? 'ok' : '');
    return `<div class="r-owned ${cls}"><span class="r-k mono">What you already own</span>${parts.join('')}</div>`;
  }

  // The devices we suggest, minus anything the reader already owns — suggesting
  // someone buy a device sitting in their drawer is the whole reason this block
  // exists.
  function unownedWallets(list) {
    const owned = new Set(Array.isArray(answers.ownedDevices) ? answers.ownedDevices : []);
    if (!owned.size) return list || [];
    const left = (list || []).filter((d) => !owned.has(slugForName(d.name)));
    // If they own BOTH suggestions, keep the list rather than render an empty
    // block — the owned panel above has already told them they are covered.
    return left.length ? left : (list || []);
  }

  // ── the step machine ──
  // The flow: current → (owned interstitial) → stakes → assessment intro → four
  // concern sections → review → recovery → tech → sovereignty → result.
  // The list is recomputed every render because the owned step is conditional on
  // Q1; it sits immediately after Q1, so a plain index stays coherent.
  function steps() {
    const s = [{ k: 'q', id: 'current' }];
    if (answers.current && answers.current !== 'pre') s.push({ k: 'owned' });
    s.push({ k: 'q', id: 'stakes' });
    s.push({ k: 'intro' });
    for (const c of SECTION_ORDER) s.push({ k: 'sect', c });
    s.push({ k: 'review' });
    s.push({ k: 'q', id: 'recovery' }, { k: 'q', id: 'tech' }, { k: 'q', id: 'sovereignty' });
    return s;
  }

  function render() {
    const list = steps();
    if (pos >= list.length) { renderResult(); return; }
    const st = list[pos];
    renderProgress(st);
    elResult.hidden = true;
    elCard.hidden = false;
    if (st.k === 'q') renderSingle(questionById[st.id]);
    else if (st.k === 'owned') renderOwnedStep();
    else if (st.k === 'intro') renderAssessIntro();
    else if (st.k === 'sect') renderSection(st.c);
    else renderReview();
  }
  function go(delta) {
    pos += delta;
    render();
    elCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── progress — honest at every screen ──
  // Four stages: where you are → what's at stake → your risk picture → the fit.
  const FIT_IDS = ['recovery', 'tech', 'sovereignty'];
  function renderProgress(st) {
    let stage, text;
    if (!st) { stage = 4; text = 'Your setup'; }
    else if (st.k === 'owned') { stage = 0; text = 'The wallets you own — optional'; }
    else if (st.k === 'q' && st.id === 'current') { stage = 0; text = 'Where you are today'; }
    else if (st.k === 'q' && st.id === 'stakes') { stage = 1; text = 'What’s at stake'; }
    else if (st.k === 'intro') { stage = 2; text = 'Your risk picture — the standard view'; }
    else if (st.k === 'sect') { stage = 2; text = `Your risk picture — ${SECTION_ORDER.indexOf(st.c) + 1} of ${SECTION_ORDER.length}`; }
    else if (st.k === 'review') { stage = 2; text = 'Your risk picture — review'; }
    else { stage = 3; text = `The fit — question ${FIT_IDS.indexOf(st.id) + 1} of ${FIT_IDS.length}`; }
    let dots = '';
    for (let i = 0; i < 4; i++) dots += `<span class="dot ${i < stage ? 'done' : i === stage ? 'now' : ''}"></span>`;
    elProgress.innerHTML = `<span class="dots">${dots}</span> ${text}`;
  }

  // The interstitial owned-wallets step — between Q1 and stakes, shown only when
  // the current setup implies hardware. Answers ride in memory; saved only if the
  // user later saves their plan (the finder's "nothing stored unless you save" holds).
  function renderOwnedStep() {
    elCard.innerHTML = `<div class="q-card">
      <h2 class="q-title">Which hardware wallet(s) do you own?</h2>
      <p class="q-help">Optional — this lets us build your roadmap around what you already have, so we only suggest what you still need. Add as many as you own.</p>
      <div id="q-own-mount"></div>
      <div class="rank-actions">
        <button class="q-back" id="q-back">← Back</button>
        <button class="btn-primary q-continue" id="q-continue" type="button">Continue →</button>
      </div>
    </div>`;
    mountOwnedPicker(document.getElementById('q-own-mount'), {
      initial: Array.isArray(answers.ownedDevices) ? answers.ownedDevices : [],
      privateInit: !!answers.ownPrivate,
      onChange: (sel, priv) => { answers.ownedDevices = sel; answers.ownPrivate = priv; },
    });
    document.getElementById('q-continue').addEventListener('click', () => go(1));
    document.getElementById('q-back').addEventListener('click', () => go(-1));
  }

  function shell(q, inner) {
    return `<div class="q-card"><h2 class="q-title">${esc(q.q)}</h2>${q.help ? `<p class="q-help">${esc(q.help)}</p>` : ''}${inner}</div>`;
  }

  function renderSingle(q) {
    const prior = answers[q.id]; // prefilled from a saved plan → highlight it
    const opts = q.options.map((o) => `<button class="q-opt ${o.value === prior ? 'sel' : ''}" data-value="${esc(o.value)}"><span>${esc(o.label)}</span>${o.value === prior ? '<span class="q-prior mono">your answer</span>' : ''}</button>`).join('');
    elCard.innerHTML = shell(q, `<div class="q-opts">${opts}</div>${pos > 0 ? `<button class="q-back" id="q-back">← Back</button>` : ''}`);
    elCard.querySelectorAll('.q-opt').forEach((b) => {
      b.addEventListener('click', () => {
        answers[q.id] = b.getAttribute('data-value');
        go(1);
      });
    });
    const back = document.getElementById('q-back');
    if (back) back.addEventListener('click', () => go(-1));
  }

  // ── the assessment ──────────────────────────────────────────────────────────

  const stakesNow = () => answers.stakes || 'meaningful';
  // The sovereignty answer seeds the `exposure` concern's default, so anything
  // asking for defaults or a word for that concern has to pass it — omit it and
  // the default comes back undefined and the bar renders empty.
  const sovNow = () => answers.sovereignty || 'lean-self';
  function promptDerived() { return scoreFromPrompts([...checked], stakesNow(), [...skipped]); }
  function scoresNow() {
    const s = promptDerived();
    // scoreFromPrompts KNOWS ONLY THE FOUR WALKED RISKS. `stakes` and `exposure`
    // come from questions, so it returns them undefined — and undefined is not
    // harmless here: every comparison inside scoreWord is false against it, so
    // both rows report 'high' for every reader. finder.js already records this
    // exact failure and fills the gap inside normalizedScores; that fix covers
    // the ENGINE, and this function is the second entry point to the same hole.
    // It went unnoticed while nothing on this screen rendered those two rows —
    // the moment the review screen did, a reader who chose "still learning" was
    // shown "how much is riding on this: HIGH", disagreeing with the result page
    // two clicks later, which fills them correctly.
    const d = defaultsFor(stakesNow(), sovNow());
    for (const c of CONCERN_KEYS) {
      if (typeof s[c] !== 'number') s[c] = d[c];
      if (!skipped.has(c) && typeof overrides[c] === 'number') s[c] = overrides[c];
    }
    return s;
  }
  function assessAnswers() {
    return { scores: scoresNow(), checkedPrompts: [...checked], skippedSections: [...skipped] };
  }
  function gateOk(p) { return !p.gatedBy || p.gatedBy.some((g) => checked.has(g)); }
  function touchesConcern(p, c) { return p.concern === c || (p.also || []).some((x) => x.concern === c); }
  function checkedCountFor(c) { return prompts.filter((p) => checked.has(p.id) && gateOk(p) && touchesConcern(p, c)).length; }

  // Bars are decorative (aria-hidden); the WORD is the scale, and it's the only
  // scale — never a number. Tiny floor width so "low"/near-zero still draws.
  const barW = (n) => Math.max(n, 1.5);
  // THE TYPICAL HOLDER IS A TICK, NOT A BAR BEHIND (2026-08-01).
  //
  // It used to be a dim bar starting at the same left edge as the fill, with
  // the fill absolutely positioned on top — so the moment your score reached
  // the default, the fill covered the ghost completely and it was NEVER VISIBLE.
  // Which is most of the time: on the shipped engine an untouched section scores
  // exactly the default, so the reference the legend promised was hidden by
  // construction on the first screen every reader sees.
  //
  // A tick also says the thing more precisely. A bar behind a bar asks the
  // reader to compare two lengths that share an origin; a mark says "typical is
  // HERE" and lets the fill land short of it or past it — which matters more
  // under the expected-bundle baseline than it did on the shipped engine,
  // because here a CLEARED section lands BELOW the tick, and that gap is the
  // signal the reader is owed back.
  const tickAt = (n) => Math.min(98.5, Math.max(1.5, n));
  // `ans` — where the reader's OWN ANSWERS put this bar, drawn only on the review
  // screen and only once they have nudged it by hand. Without it, "Set by hand —
  // your call stands" is a sentence with nothing to point at: the reader can see
  // where the bar IS but not how far they moved it, and the Reset button offers
  // to undo something invisible. With it, the override is spatial.
  //
  // Deliberately NOT drawn when the reader has not overridden anything: it would
  // sit exactly under the fill edge and add a mark that means nothing.
  function barHtml(c, s, d, w, ans) {
    const answered = typeof ans === 'number' && Math.round(ans) !== Math.round(s);
    return `<div class="as-bar" aria-hidden="true" data-bar="${c}">
      <span class="as-fill w-${w}" style="width:${barW(s)}%"></span>
      <span class="as-typ" style="left:${tickAt(d)}%"></span>
      ${answered ? `<span class="as-ans" style="left:${tickAt(ans)}%"></span>` : ''}
    </div>`;
  }
  // The value to point at: what the prompts produced, but only where that is a
  // real answer. A SKIPPED section has none, and a legacy plan's ESTIMATED bar
  // is an override seeded from old answers rather than a walked result — in both
  // cases the prompt-derived number is the standard estimate, and marking it
  // would claim the reader said something they never said.
  function answerMarkFor(c) {
    if (skipped.has(c) || estimatedConcerns.has(c)) return null;
    if (typeof overrides[c] !== 'number') return null;
    return promptDerived()[c];
  }
  function wordTag(c, w) { return `<span class="as-word w-${w}" data-word="${c}">${w}</span>`; }

  // THE TWO ANSWER ROWS GET THEIR ANSWER BACK, NOT A BAND WORD.
  //
  // `stakes` and `exposure` are scored AT their own default by construction —
  // d.stakes is STAKES_SCORE[the answer], and the score is that same number — so
  // scoreWord could only ever return 'typical' for them, for every reader, on
  // every screen. A tag that cannot say anything else is not a measurement; it
  // reads as a verdict on the reader ("your stakes are typical") while carrying
  // no information at all, and it shipped on the result's risk picture from the
  // day that strip was built.
  //
  // The reader's own answer is the honest thing to show, it is derived from the
  // same state, and it can distinguish four readers where the word could not
  // distinguish any. Short forms live on the question in finder-questions.js — one source,
  // so a reworded option cannot leave a stale echo here.
  const ANSWER_ROW_Q = { stakes: 'stakes', exposure: 'sovereignty' };
  function answerTag(key) {
    const q = questionById[ANSWER_ROW_Q[key]];
    const opt = q && (q.options || []).find((o) => o.value === answers[q.id]);
    // NOT ASKED YET IS A REAL STATE, not an empty one. The review screen sits
    // between the stakes question and the sovereignty question, so `exposure`
    // reaches it unanswered every time — and the bar is drawn from the
    // lean-self default nobody chose. A blank tag beside a full bar reads as a
    // measurement; this says what it actually is.
    if (!opt) return `<span class="as-word as-unasked" data-word="${key}">not asked yet</span>`;
    return `<span class="as-word as-answered" data-word="${key}">${esc(opt.short || opt.label)}</span>`;
  }

  // Two-sentence mechanism recaps, in the site's voice — the receipt for why
  // each concern is its own section.
  // These are a SECOND rendering of the concern blurbs in finder.js — the intro
  // screen shows those, and this shows these, so the two have to say the same
  // thing about the same subject. When the custodial wording was narrowed to a
  // MEANINGFUL SHARE, this copy still described any account at all and had to be
  // narrowed with it.
  const SECTION_RECAP = {
    custodial: 'A meaningful share of your Bitcoin sitting with an exchange or app that goes under, freezes your account, or loses your coins — the Mt. Gox to FTX class of loss. Small change on an app is not what this is about; while a company holds the keys to a real part of your stack, its problems are your problems.',
    'self-loss': 'The quiet one: a backup that was never tested, a passphrase that lived only in your head, nobody else who could recover it. More Bitcoin has been lost this way than has ever been stolen in exchange hacks.',
    remote: 'Phishing, fake support, fake apps, malware, long-con investment scams — theft that never touches your door. It’s the largest measured flow of loss, and it works by fooling you, not by breaking the cryptography.',
    physical: 'Someone coming after you specifically — coercion, burglary for devices and backups, theft by people who know you. It’s by far the rarest of the four, and it almost never starts at random: it starts with someone knowing.',
  };

  function renderAssessIntro() {
    const d = defaultsFor(stakesNow(), sovNow());
    const rows = RISK_CONCERNS.map((c) => `<div class="as-prow">
      <span class="as-plabel">${esc(c.label)}</span>
      ${wordTag(c.key, 'typical')}
      <div class="as-bar" aria-hidden="true"><span class="as-ghost lit" style="width:${barW(d[c.key])}%"></span></div>
    </div>`).join('');
    const estNote = assessEstimated
      ? `<p class="as-estnote">Your bars ahead are <strong>estimated from your earlier answers</strong> — walk the sections anytime to replace the estimate with the real thing.</p>`
      : '';
    elCard.innerHTML = `<div class="q-card as-card">
      <h2 class="q-title">Here’s what actually goes wrong</h2>
      <p class="q-help">For a typical holder, most loss is self-inflicted or a scam that talks you into handing it over — not hackers breaking the cryptography, and almost never someone at your door. That’s not a judgment about you; it’s the base rate for <em>everyone</em>. The bars below are that standard picture, the same one our <a href="/learn/how-bitcoin-is-lost">how Bitcoin is lost</a> lesson teaches. Next we walk it, one risk at a time, and find out where yours differs.</p>
      <div class="as-meter">${rows}</div>
      ${estNote}
      <p class="as-method">The defaults behind these bars are published, sourced, and dated — <a href="/how-we-weigh-risk">how we weigh risk →</a></p>
      <div class="as-acts">
        <button class="q-back" id="q-back">← Back</button>
        <button class="btn-primary" id="q-continue" type="button">Let’s see if your situation is different →</button>
      </div>
    </div>`;
    document.getElementById('q-continue').addEventListener('click', () => go(1));
    document.getElementById('q-back').addEventListener('click', () => go(-1));
  }

  function promptBtnHtml(p) {
    const on = checked.has(p.id);
    return `<button type="button" class="as-prompt${on ? ' on' : ''}" aria-pressed="${on}" data-p="${p.id}">
      <span class="as-tick" aria-hidden="true">${on ? '✓' : ''}</span>
      <span class="as-ptxt"><span class="as-stmt">${esc(p.statement)}</span><span class="as-why">${esc(p.why)}</span></span>
    </button>`;
  }

  function renderSection(c) {
    // Entering a section means engaging with it: a skip is undone by returning,
    // and any by-hand or estimated level is replaced by what you tap here.
    skipped.delete(c);
    delete overrides[c];
    estimatedConcerns.delete(c);

    const info = CONCERN_BY_KEY[c];
    const list = promptsFor(c);
    const items = list.map((p) => {
      if (!p.gatedBy) return promptBtnHtml(p);
      return `<div class="as-gated" data-gate-for="${p.id}" ${gateOk(p) ? '' : 'hidden'}>
        <span class="as-gate-tag mono">Asked because of what you just said</span>
        ${promptBtnHtml(p)}
      </div>`;
    }).join('');

    const s = scoresNow()[c];
    const d = defaultsFor(stakesNow())[c];
    const w = scoreWord(s, c, stakesNow(), sovNow());
    elCard.innerHTML = `<div class="q-card as-card">
      <h2 class="q-title">${esc(info.label)}</h2>
      <p class="q-help">${esc(SECTION_RECAP[c])}</p>
      ${info.settled ? `<p class="as-settled">${esc(info.settled)} <em>These questions shape your picture, not the recommendation.</em></p>` : ''}
      <div class="as-meter as-live">
        <div class="as-meter-head"><span class="as-k mono">Your level</span>${wordTag(c, w)}</div>
        ${barHtml(c, s, d, w)}
        <p class="as-legend">The mark shows the typical holder — you start there.</p>
        <span class="vh" aria-live="polite" data-live="${c}">${esc(info.label)}: ${w}</span>
      </div>
      <p class="as-instr mono">Tap everything that’s true of you</p>
      <div class="as-prompts">${items}</div>
      <p class="as-skiprow"><button type="button" class="as-skip" id="q-skip">Use the standard estimate for this one →</button></p>
      <div class="as-acts">
        <button class="q-back" id="q-back">← Back</button>
        <button class="btn-primary" id="q-continue" type="button">Continue →</button>
      </div>
    </div>`;

    function updateBar() {
      const sc = scoresNow()[c];
      const wd = scoreWord(sc, c, stakesNow(), sovNow());
      const fill = elCard.querySelector(`[data-bar="${c}"] .as-fill`);
      fill.style.width = `${barW(sc)}%`;
      fill.className = `as-fill w-${wd}`;
      const tag = elCard.querySelector(`[data-word="${c}"]`);
      tag.textContent = wd;
      tag.className = `as-word w-${wd}`;
      elCard.querySelector(`[data-live="${c}"]`).textContent = `${info.label}: ${wd}`;
    }
    function syncGates() {
      list.filter((p) => p.gatedBy).forEach((p) => {
        const wrap = elCard.querySelector(`[data-gate-for="${p.id}"]`);
        const open = gateOk(p);
        wrap.hidden = !open;
        if (!open && checked.has(p.id)) {
          // The gate closed — the family prompt no longer applies, so untick it.
          checked.delete(p.id);
          const btn = wrap.querySelector('.as-prompt');
          btn.classList.remove('on');
          btn.setAttribute('aria-pressed', 'false');
          btn.querySelector('.as-tick').textContent = '';
        }
      });
    }
    elCard.querySelectorAll('.as-prompt').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-p');
        const on = !checked.has(id);
        if (on) checked.add(id); else checked.delete(id);
        btn.classList.toggle('on', on);
        btn.setAttribute('aria-pressed', String(on));
        btn.querySelector('.as-tick').textContent = on ? '✓' : '';
        syncGates();
        updateBar();
      });
    });
    document.getElementById('q-skip').addEventListener('click', () => { skipped.add(c); go(1); });
    document.getElementById('q-continue').addEventListener('click', () => go(1));
    document.getElementById('q-back').addEventListener('click', () => go(-1));
  }

  // ── review screen — all four bars, hand-adjustable by word detents ──
  // Free-drag is out (design § 3): each bar moves between the four words via
  // −/+ steppers, snapping to a representative score inside each word's band.
  const WORD_ORDER = ['low', 'typical', 'elevated', 'high'];
  function detentsFor(c) {
    const d = defaultsFor(stakesNow())[c];
    const h = HALF_BAND[c];
    return [
      Math.max(Math.round(d - 1.5 * h), 0),   // low
      d,                                       // typical
      Math.round(d + 1.75 * h),                // elevated
      Math.min(Math.round(d + 3 * h), 96),     // high — never certainty theater
    ];
  }
  function recapLine(c) {
    if (skipped.has(c)) return `Standard estimate — you skipped this one. <button type="button" class="as-walk" data-walk="${c}">Walk it →</button>`;
    if (estimatedConcerns.has(c)) return `Estimated from your earlier answers. <button type="button" class="as-walk" data-walk="${c}">Walk it →</button>`;
    if (typeof overrides[c] === 'number') return `Set by hand — your call stands. <button type="button" class="as-reset" data-reset="${c}">Reset to my answers</button>`;
    const n = checkedCountFor(c);
    // WALKED AND CLEARED — which is no longer the same as sitting on the
    // default. The expected-bundle baseline means a reader who says none of a
    // section is true of them scores BELOW the typical holder, and the bar and
    // the word both say so. This line still said "you match the typical
    // holder", directly contradicting the 'low' tag beside it and a fill sitting
    // well under its own ghost. Same screen, opposite claims.
    if (!n) return 'None of these are true of you — that puts you below the typical holder.';
    return `Moved by the ${n === 1 ? 'one thing' : `${numberWord(n)} things`} you said ${n === 1 ? 'is' : 'are'} true of you.`;
  }

  // ── the two ANSWER rows, adjustable here too (2026-08-04) ─────────────────
  //
  // `stakes` and `exposure` are the two heaviest-weighted concerns and were the
  // only bars on this screen the reader could not touch — read-only rows on a
  // page whose whole promise is "your hand beats our arithmetic".
  //
  // THEY ARE ADJUSTED BY RE-ANSWERING, NOT BY NUDGING, and that is the whole
  // design. The other four bars are scores derived from prompts, so a −/+ step
  // is a coherent thing to do to them. These two are not: their value IS an
  // answer to a question, and `stakes` in particular is not only a row — the
  // stakes ANSWER sets the default band for every other concern on this screen
  // and decides whether C11's floor applies at all. Nudging the stakes SCORE
  // while leaving the answer alone would let a reader say "a great deal is
  // riding on this" here and still be measured against the learning-stakes
  // baseline everywhere else, and still be exempt from the no-single-point-of-
  // failure floor. Two states for one fact, disagreeing — on the screen built to
  // let them correct us.
  //
  // So the control is the question's own options, brought to where the reader is
  // reviewing. Picking one changes the answer, and the screen re-renders whole,
  // because every other bar's baseline may have just moved and they need to see
  // that happen.
  function answerRow(c, d) {
    const qid = ANSWER_ROW_Q[c.key];
    const q = questionById[qid];
    const s = scoresNow()[c.key];
    const w = scoreWord(s, c.key, stakesNow(), sovNow());
    const cur = answers[qid];
    const opts = (q ? q.options || [] : []).map((o) => `
      <button type="button" class="as-opt${o.value === cur ? ' sel' : ''}" data-answer="${esc(qid)}"
        data-value="${esc(o.value)}" aria-pressed="${o.value === cur ? 'true' : 'false'}">${esc(o.label)}</button>`).join('');
    return `<div class="as-row as-row-answer" data-row="${c.key}">
      <div class="as-row-head"><span class="as-row-label">${esc(c.label)}</span>${answerTag(c.key)}</div>
      <div class="as-row-mid">
        <div class="as-bar"><span class="as-fill lit w-${w}" style="width:${barW(s)}%"></span></div>
      </div>
      <p class="as-recap">${cur
        ? 'This one comes straight from your answer, not from the assessment — so change the answer and it moves.'
        : 'We have not asked you this one yet — it is coming up. The bar is the standard estimate until you answer, and you can answer it here instead.'}</p>
      <div class="as-opts">${opts}</div>
      <span class="vh" aria-live="polite">${esc(c.label)}: ${w}</span>
    </div>`;
  }

  function renderReview() {
    assessDone = true;
    const d = defaultsFor(stakesNow(), sovNow());
    const rows = RISK_CONCERNS.map((c) => {
      const s = scoresNow()[c.key];
      const w = scoreWord(s, c.key, stakesNow(), sovNow());
      return `<div class="as-row" data-row="${c.key}">
        <div class="as-row-head"><span class="as-row-label">${esc(c.label)}</span>${wordTag(c.key, w)}</div>
        <div class="as-row-mid">
          <button type="button" class="as-step" data-dir="-1" data-c="${c.key}" aria-label="Lower ${esc(c.label)}">−</button>
          ${barHtml(c.key, s, d[c.key], w, answerMarkFor(c.key))}
          <button type="button" class="as-step" data-dir="1" data-c="${c.key}" aria-label="Raise ${esc(c.label)}">＋</button>
        </div>
        <p class="as-recap" data-recap="${c.key}">${recapLine(c.key)}</p>
        <span class="vh" aria-live="polite" data-live="${c.key}">${esc(c.label)}: ${w}</span>
      </div>`;
    }).join('');
    // Rendered under their own heading, because they are a different KIND of
    // thing and the intro above promises base rates — true of the four, false of
    // these two. Same separation the result's profile strip already makes.
    const answerRows = ANSWER_CONCERNS.map((c) => answerRow(c, d)).join('');
    elCard.innerHTML = `<div class="q-card as-card">
      <h2 class="q-title">Your risk picture</h2>
      <p class="q-help">Here’s where you landed against the typical holder — the mark on each bar. The words are the whole scale — low, typical, elevated, high. If a bar doesn’t match how you honestly see it, nudge it with − and ＋: your hand beats our arithmetic, and the recommendation will follow it.</p>
      <div class="as-review">${rows}</div>
      <span class="as-sub-k mono">And the two that came from your answers</span>
      <p class="as-sub-help">These two carry the most weight of anything here, so they are the two most worth getting right. They are not scored from the assessment — each is an answer you gave, and you can change it without starting over.</p>
      <div class="as-review">${answerRows}</div>
      <p class="as-method"><a href="/how-we-weigh-risk">How we weigh risk →</a></p>
      <div class="as-acts">
        <button class="q-back" id="q-back">← Back</button>
        <button class="btn-primary" id="q-continue" type="button">Looks right — on to the fit →</button>
      </div>
    </div>`;

    function repaintRow(c) {
      const row = elCard.querySelector(`[data-row="${c}"]`);
      const s = scoresNow()[c];
      const w = scoreWord(s, c, stakesNow(), sovNow());
      const fill = row.querySelector('.as-fill');
      fill.style.width = `${barW(s)}%`;
      fill.className = `as-fill w-${w}`;
      // The answer mark is DERIVED from the same state the buttons change, so it
      // repaints with them. Leaving it stale is the partial-repaint bug this
      // project already has a standing note about.
      const bar = row.querySelector('.as-bar');
      const old = bar.querySelector('.as-ans');
      if (old) old.remove();
      const ans = answerMarkFor(c);
      if (typeof ans === 'number' && Math.round(ans) !== Math.round(s)) {
        const mark = document.createElement('span');
        mark.className = 'as-ans';
        mark.style.left = `${tickAt(ans)}%`;
        bar.appendChild(mark);
      }
      const tag = row.querySelector(`[data-word="${c}"]`);
      tag.textContent = w;
      tag.className = `as-word w-${w}`;
      row.querySelector(`[data-recap="${c}"]`).innerHTML = recapLine(c);
      row.querySelector(`[data-live="${c}"]`).textContent = `${CONCERN_BY_KEY[c].label}: ${w}`;
      row.querySelectorAll('.as-step').forEach((b) => {
        const dir = parseInt(b.getAttribute('data-dir'), 10);
        const i = WORD_ORDER.indexOf(w);
        b.disabled = (dir < 0 && i === 0) || (dir > 0 && i === WORD_ORDER.length - 1);
      });
      wireRecap(row);
    }
    function wireRecap(row) {
      const walk = row.querySelector('.as-walk');
      if (walk) walk.addEventListener('click', () => {
        const c = walk.getAttribute('data-walk');
        pos = steps().findIndex((st) => st.k === 'sect' && st.c === c);
        render();
        elCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      const reset = row.querySelector('.as-reset');
      if (reset) reset.addEventListener('click', () => {
        delete overrides[reset.getAttribute('data-reset')];
        repaintRow(reset.getAttribute('data-reset'));
      });
    }
    elCard.querySelectorAll('.as-step').forEach((b) => {
      b.addEventListener('click', () => {
        const c = b.getAttribute('data-c');
        const dir = parseInt(b.getAttribute('data-dir'), 10);
        const w = scoreWord(scoresNow()[c], c, stakesNow(), sovNow());
        const ni = Math.min(WORD_ORDER.length - 1, Math.max(0, WORD_ORDER.indexOf(w) + dir));
        overrides[c] = detentsFor(c)[ni];
        skipped.delete(c);
        estimatedConcerns.delete(c);
        repaintRow(c);
      });
      const i = WORD_ORDER.indexOf(scoreWord(scoresNow()[b.getAttribute('data-c')], b.getAttribute('data-c'), stakesNow(), sovNow()));
      const dir = parseInt(b.getAttribute('data-dir'), 10);
      b.disabled = (dir < 0 && i === 0) || (dir > 0 && i === WORD_ORDER.length - 1);
    });
    elCard.querySelectorAll('.as-row').forEach(wireRecap);
    // Re-answering rebuilds the WHOLE screen, never just its own row. Changing
    // the stakes answer moves every other concern's default band with it, so a
    // targeted repaint would leave five bars measured against a baseline that no
    // longer exists — visibly correct, silently stale. The list every partial
    // repaint has to consult, this time, is "all of them".
    elCard.querySelectorAll('.as-opt').forEach((b) => {
      b.addEventListener('click', () => {
        answers[b.getAttribute('data-answer')] = b.getAttribute('data-value');
        renderReview();
        const back = elCard.querySelector('.as-row-answer');
        if (back) back.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
    document.getElementById('q-continue').addEventListener('click', () => go(1));
    document.getElementById('q-back').addEventListener('click', () => go(-1));
  }

  // ── result rendering ────────────────────────────────────────────────────────

  function walletCard(rec, adaptive, sel) {
    if (rec.wallets && rec.wallets.length) {
      // ONLY WHAT THEY DO NOT ALREADY OWN. Telling a reader to buy the device
      // sitting in their drawer is the defect this whole block exists to fix.
      const items = unownedWallets(rec.wallets).map((d, i) => {
        const w = wallets.find((x) => x.name === d.name);
        const price = w ? ` <span class="r-price">${esc(w.price)}</span>` : '';
        const body = `<strong>${esc(d.name)}</strong>${price} — ${esc(d.why)}`;
        return adaptive
          ? `<button class="r-dev ${i === sel ? 'sel' : ''}" data-idx="${i}">${body}</button>`
          : `<li>${body}</li>`;
      }).join('');
      const container = adaptive ? `<div class="r-devs adaptive">${items}</div>` : `<ul class="r-devs">${items}</ul>`;
      const label = adaptive ? 'Two devices that fit — tap the one you’re leaning toward and we’ll put it first in your plan' : 'Two devices that fit — either works, pick by feel';
      return `<div class="r-wallet">
        <span class="r-k mono">${label}</span>
        ${container}
        ${rec.walletNote ? `<p class="r-devnote">${esc(rec.walletNote)}</p>` : ''}
      </div>`;
      // NO "compare all N devices" LINK HERE (removed 2026-08-01). This page is
      // the SELECT phase — which setup, and nothing else. Sending the reader to
      // the full comparison at the moment they have just been given an answer
      // invites them to re-open the decision before they can act on it, which is
      // the failure the three-phase split exists to prevent. Choosing hardware
      // belongs to /my-plan, and that page carries the link.
    }
    // category-only (learning / collaborative — walletNote may hold intentional HTML)
    return rec.walletNote ? `<div class="r-wallet"><span class="r-k mono">Where to start</span><p>${rec.walletNote}</p></div>` : '';
  }

  // One page produces the checklist, and it is the one called /checklist —
  // the result hands off instead of duplicating.
  function checklistHandoff() {
    return `<div class="r-handoff"><span class="r-k mono">Next</span>
      <p>Save this and it becomes your plan. On your plan you pick the hardware that fills it — and we'll tell you whether anything you already own clears our bar. Your checklist is built from that: only the steps your setup needs, in order, with your own devices named.</p></div>`;
  }

  function vendorsBlock(vendors) {
    if (!vendors || !vendors.length) return '';
    const rows = vendors.map((v) => `<li>
      <div class="v-head"><a href="${esc(v.url)}" target="_blank" rel="noopener noreferrer">${esc(v.name)} ↗</a> <span class="v-meta mono">${esc(v.kyc)} · ${esc(v.price)}</span></div>
      <div class="v-model mono">${esc(v.model)}</div>
      <p>${esc(v.note)}</p>
      ${v.hw ? `<div class="v-hw"><span class="mono">Hardware:</span> ${esc(v.hw)}</div>` : ''}
    </li>`).join('');
    return `<div class="r-vendors">
      <span class="r-k mono">Bitcoin-only collaborative-custody services</span>
      <p class="v-intro"><strong>What this means:</strong> "collaborative custody" is where a company holds one backup key for you, so losing one of your own keys can't lock you out — a "2-of-3" means any two of the three keys together can recover your coins. ("KYC" is the ID check some services require.) This is a neutral list — <strong>not affiliate links, not ranked "best."</strong> We include only Bitcoin-only services; compare their models and pick the fit. <em>(Casa is left off — it now supports other coins too.)</em></p>
      <ul class="v-list">${rows}</ul>
      <a class="r-how2" href="/collaborative">Compare all ${vendors.length} side by side — KYC, recovery, insurance, fees →</a>
    </div>`;
  }


  // "Your journey" — frames the recommendation from where they are now (Q1).
  function journeyPath(j) {
    if (j.kind === 'sideways') {
      return `<span class="rj-node rj-now"><span class="rj-k mono">You’re here</span><span class="rj-lbl">${esc(j.curLabel)}</span></span>
        <span class="rj-arrow" aria-hidden="true">↔</span>
        <span class="rj-node rj-dest"><span class="rj-k mono">Where your answers lean</span><span class="rj-lbl">${esc(j.targetLabel)}</span></span>`;
    }
    if (j.gap > 0) {
      return `<span class="rj-node rj-now"><span class="rj-k mono">You’re here</span><span class="rj-lbl">${esc(j.curLabel)}</span></span>
        <span class="rj-arrow" aria-hidden="true">→</span>
        <span class="rj-node rj-dest"><span class="rj-k mono">The setup that fits you</span><span class="rj-lbl">${esc(j.targetLabel)}</span></span>`;
    }
    const tag = j.gap === 0 ? 'You’re here — and it fits' : 'You’re here';
    return `<span class="rj-node rj-now ${j.gap === 0 ? 'ok' : 'ahead'}"><span class="rj-k mono">${tag}</span><span class="rj-lbl">${esc(j.curLabel)}</span></span>`;
  }
  function journeyHtml(j) {
    if (!j) return '';
    return `<div class="r-journey j-${esc(j.kind)}">
      <div class="rj-path">${journeyPath(j)}</div>
      <h2 class="rj-headline">${esc(j.headline)}</h2>
      <p class="rj-msg">${esc(j.message)}</p>
    </div>`;
  }

  // The profile strip — the result leads with the whole picture that produced
  // it, words only, never numbers. TWO groups, because they are two different
  // kinds of thing and one heading cannot honestly cover both:
  //
  //   the four RISKS   — shares of expected loss, shown against the typical
  //                      holder, because there IS a base rate to compare to
  //   the two ANSWERS  — what you told us matters to you. There is no "typical"
  //                      amount at stake and no typical appetite for a third
  //                      party, so showing a ghost bar behind them would be
  //                      inventing a norm nobody measured.
  //
  // Both groups feed the recommendation identically. They are separated here
  // for honesty about where each number came from, not to rank them.
  function profileStrip(profile) {
    const row = (c, ghost) => {
      const s = profile.scores[c.key];
      const w = profile.words[c.key];
      return `<div class="as-prow">
        <span class="as-plabel">${esc(c.label)}</span>
        ${ghost ? wordTag(c.key, w) : answerTag(c.key)}
        ${ghost ? barHtml(c.key, s, profile.defaults[c.key], w)
                : `<div class="as-bar"><span class="as-fill lit" style="width:${barW(s)}%"></span></div>`}
      </div>`;
    };
    const risks = RISK_CONCERNS.map((c) => row(c, true)).join('');
    const answered = ANSWER_CONCERNS.map((c) => row(c, false)).join('');
    // The spoken line has to say what the SEEN line says, or a screen-reader
    // user hears "typical" where a sighted reader sees their own answer.
    const spokenFor = (c) => (c.preference
      ? ((questionById[ANSWER_ROW_Q[c.key]].options.find((o) => o.value === answers[ANSWER_ROW_Q[c.key]]) || {}).short || 'not answered')
      : profile.words[c.key]);
    const spoken = CONCERNS.map((c) => `${c.label}: ${spokenFor(c)}`).join('. ');
    return `<div class="r-profile">
      <span class="r-k mono">Your risk picture — you against the typical holder</span>
      ${risks}
      ${answered ? `<span class="r-k mono r-k-sub">And what you told us matters to you</span>${answered}` : ''}
      <span class="vh">${esc(spoken)}</span>
    </div>`;
  }

  // ── THE WORRY REFILL ──────────────────────────────────────────────────────
  //
  // The result names the one risk the reader's answers say they are most exposed
  // to, SAYS WHERE THAT CAME FROM, and lets them change it. Whatever it is left
  // on is what the engine used — the block re-renders the whole result, so the
  // bars, the reasons and the caveats underneath always describe the same
  // picture as the sentence above them.
  //
  // The label doubles as a claim about provenance, which is why "from your
  // answers" and "you told us" are different sentences rather than one neutral
  // one. A reader who has changed it should never wonder whether we quietly kept
  // our own version.
  //
  // A FLAT PICTURE IS SAID OUT LOUD. When nothing clears the noise the copy
  // admits it and names the one that catches most people instead of dressing a
  // rounding difference up as a finding — the same honesty the engine's own
  // "nothing stands out" reason line already uses.
  const worryLabel = (k) => (CONCERNS.find((c) => c.key === k) || {}).label || k;

  function worryHtml(worry) {
    const opts = WORRY_CONCERNS.map((k) => `
      <button class="w-opt${k === worry.active ? ' sel' : ''}" data-worry="${esc(k)}"
        aria-pressed="${k === worry.active ? 'true' : 'false'}">${esc(worryLabel(k))}</button>`).join('');
    const lead = worry.stated
      ? `<p class="w-lead">You told us this is the one that worries you: <strong>${esc(worryLabel(worry.stated))}</strong>. Everything below takes you at your word.</p>`
      : worry.stood
        ? `<p class="w-lead">From your answers, the one you are most exposed to is <strong>${esc(worryLabel(worry.derived))}</strong>.</p>`
        : `<p class="w-lead">Nothing in your answers stood out, so we have gone with <strong>${esc(worryLabel(worry.derived))}</strong> — the one that catches most people.</p>`;
    const revert = worry.stated
      ? `<button class="w-revert" data-worry="">↺ Go back to what my answers said (${esc(worryLabel(worry.derived))})</button>`
      : '';
    return `<div class="r-worry">
      <span class="r-k mono">The one that worries you</span>
      ${lead}
      <p class="w-ask">Not how it feels to you? Pick the one that does — we will redo the fit.</p>
      <div class="w-opts">${opts}</div>
      ${revert}
    </div>`;
  }

  // Readable names for the tie treatment — the engine's setup keys, in English.
  const SETUP_TIE_LABEL = {
    'single-sig': 'single-sig cold storage',
    passphrase: 'single-sig + a passphrase',
    multisig: 'do-it-yourself 2-of-3 multisig',
    collaborative: 'collaborative 2-of-3 multisig',
    'three-of-five': '3-of-5 multisig',
  };
  // NAME THE SETUP THAT WON (2026-08-01). This used to collapse both multi-key
  // rungs to "2-of-3 multisig", because the fork card presented both paths and
  // picked which LED from the sovereignty answer — so naming the raw winner could
  // contradict the card beneath it. There is no fork now: the winner gets its own
  // card, so the tie can and should name it exactly.
  const tieLabel = (setup) => SETUP_TIE_LABEL[setup] || setup;

  // Ladder position of a rendered card. Needed because the second choice is now
  // derived from the SCORES rather than a rule, so it can legitimately be a
  // LOWER rung than the first — "you could also just do less, and here is what
  // that costs you". The old label ("where you'd go next") was written when a
  // step-down was structurally impossible, and would be a plain lie on those.
  const LADDER_POS = { 'single-sig': 1, passphrase: 2, multisig: 3, collaborative: 4, 'three-of-five': 3 };
  const cardRung = (c) => (c ? (LADDER_POS[c.rungSlug] || null) : null);

  // HOW MUCH A SETUP ASKS OF YOU, which is NOT the same as its ladder position —
  // and separating the two multi-key rungs into their own cards is what exposed
  // that. Collaborative custody sits ABOVE do-it-yourself multisig on the ladder
  // (a service backstop is more protective) while asking LESS of you (two devices
  // instead of three, and no descriptor to guard). So the old label, which read
  // the rung, told a reader that three devices they run themselves were "the
  // simpler alternative" to a service that does half the work for them.
  const BURDEN = { 'single-sig': 1, passphrase: 2, collaborative: 3, multisig: 4 };
  const burden = (c) => (c ? (BURDEN[c.rungSlug] ?? null) : null);
  const bothMultiKey = (a2, b2) =>
    ['multisig', 'collaborative'].includes(a2?.rungSlug) &&
    ['multisig', 'collaborative'].includes(b2?.rungSlug);

  function renderResult() {
    renderProgress(null);
    const rb = document.getElementById('q-resume');
    if (rb) rb.hidden = true; // the result speaks for itself
    elCard.hidden = true;
    elResult.hidden = false;
    const rec = recommendV2({ ...answers, ...assessAnswers() });
    const { primary, secondary, journey, profile, reasons, holdbacks, tie, worry } = rec;
    const devs = primary.wallets || [];
    const adaptive = devs.some((d) => d.adaptive);   // e.g. Bitkey has its own flow
    let sel = 0;
    const primaryHasVendors = primary.vendors && primary.vendors.length;
    const saveControl = (rung, label, tier, source, recSlugs) =>
      `<div class="r-save" data-rung="${esc(rung)}" data-label="${esc(label)}" data-tier="${esc(tier || '')}" data-source="${source}" data-recs="${esc((recSlugs || []).join(','))}"></div>`;

    // "Because of your answers" — the profile explains the pick, in its own words.
    // One honesty guard on the engine's fallback line: it says "nothing stands
    // out", but the engine only names concerns the winning setup actively
    // defends — and single-sig's targeted-physical weight is zero, so a lone
    // elevated/high PHYSICAL reaches the fallback with a high bar right above
    // it. Say the true thing instead (this is the only combination that can
    // reach the fallback with an elevated word — every other concern gets
    // named by the engine).
    //
    // THE SAME GUARD IS NOW NEEDED FOR A STATED WORRY, and it is not a variation
    // on the physical one — it is the identical failure reached by a second
    // route. The refill raises the stated concern into `elevated`, which puts it
    // among the CAVEATED concerns for a setup that is weak on it — and caveated
    // concerns are deliberately excluded from the reasons, so the fallback fires.
    // Result, on one screen, in three places: a bar reading ELEVATED, a line
    // saying "nothing stands out", and a caveat saying "you rated that elevated".
    //
    // The fallback is not wrong about the SETUP — the simplest thing that covers
    // the picture still wins, and the caveat below states the trade. It is wrong
    // about the READER, who has just told us in as many words that something
    // stands out. So the guard replaces the claim, not the conclusion.
    let reasonList = reasons || [];
    const up = (c) => profile.words[c] === 'elevated' || profile.words[c] === 'high';
    const fellBack = reasonList.length === 1 && reasonList[0].concern === null;
    if (fellBack && up('physical')) {
      reasonList = [{
        concern: 'physical',
        text: `Your targeted-theft concern is ${profile.words.physical} — and at this level the setup itself stays simple. The win is a low profile: nothing at home needs to reveal what you hold, the privacy steps in your checklist carry most of the weight, and the step-up in the second card is the hardware answer when you want it.`,
      }];
    } else if (fellBack && worry.stated && up(worry.stated)) {
      reasonList = [{
        concern: worry.stated,
        text: `You told us ${worryLabel(worry.stated).toLowerCase()} is what worries you, so we scored it above the typical holder’s picture and left the rest where your answers put it. Nothing else stands out — and against a picture with one raised concern, the simplest setup that covers it still wins, because every step up the ladder buys protection with complexity you would then have to operate. What this setup gives up on the one you named is below, in its own words, so you can weigh it rather than take ours.`,
      }];
    }
    const reasonsHtml = reasonList.length
      ? `<div class="r-because"><span class="r-k mono">Because of your answers</span><ul>${reasonList.map((r) => `<li>${esc(r.text)}</li>`).join('')}</ul></div>`
      : '';
    // Computed holdbacks — the anti-add-on honesty, generated from the user's own
    // scores. Replaces the legacy card's single hand-written holdback line.
    const holdbacksHtml = (holdbacks || []).map((h) =>
      `<div class="r-holdback"><span class="r-k mono">${esc(h.label || 'Why not more?')}</span><p>${esc(h.text)}</p></div>`).join('');
    // A genuine either/or (C5): say so out loud, above the cards it's about.
    // Two choices, and either is right — that is the whole spirit of a tie, so
    // the copy says it in those words rather than implying a winner. The two
    // are named in the order they appear below (first choice first), and the
    // reader is told plainly that the pick is theirs.
    const tieHtml = tie
      ? `<div class="r-tie"><span class="r-k mono">Two choices — either one is right</span>
          <p>${esc(tie.note)}</p>
          <p class="r-tie-pair"><strong>First choice:</strong> ${esc(tieLabel(tie.a))} — laid out below.<br>
          <strong>Second choice:</strong> ${esc(tieLabel(tie.b))} — the trade it offers is in the card under it.</p>
        </div>`
      : '';
    // When the second card IS the other half of the tie, its label should say so
    // instead of framing it as a later step-up.
    const secondaryIsRival = Boolean(tie && secondary && FAMILY[secondary.rungSlug] === FAMILY[tie.b]);

    elResult.innerHTML = `
      ${journeyHtml(journey)}
      ${profileStrip(profile)}
      ${worryHtml(worry)}
      ${tieHtml}
      <div class="r-card">
        <p class="r-tier mono">${journey && journey.gap > 0 && journey.kind !== 'sideways' ? 'Your destination · ' : ''}${tie ? '1st choice · either fits' : '1st choice'}</p>
        <h2 class="r-headline">Your setup: ${esc(primary.headline)}</h2>
        <p class="r-why">${primary.why}</p>
        ${reasonsHtml}
        ${primary.tradeoff ? `<div class="r-tradeoff"><span class="r-k mono">The trade you are making</span><p>${primary.tradeoff}</p></div>` : ''}
        ${primary.inheritanceNote ? `<div class="r-inherit"><span class="r-k mono">Self-custodied inheritance</span><p>${esc(primary.inheritanceNote)}</p></div>` : ''}
        ${holdbacksHtml}
        ${/* What the reader already owns, judged against the setup just
             recommended. It sits ABOVE the wallet card and outside every
             per-card branch, because it is one verdict about the reader's
             drawer rather than a property of any one recommendation — the
             version that shipped inside a single branch was invisible to
             exactly the readers most likely to own hardware. READ-ONLY here by
             design: no picker, no add or remove. Choosing hardware is
             /my-plan's job, and that separation is what lets this name
             devices at all. */''}
        ${ownedContext(primary)}
        ${walletCard(primary, adaptive, sel)}
        ${checklistHandoff()}
        ${primaryHasVendors ? vendorsBlock(primary.vendors) : ''}
        ${saveControl(primary.rungSlug, primary.rungLabel || primary.headline, primary.tier, 'quiz-primary', recSlugsFrom(primary.wallets))}
      </div>
      ${secondary ? `<div class="r-card secondary">
        <p class="r-tier mono muted">${secondaryIsRival
          ? '2nd choice · equally valid — here’s the trade'
          : bothMultiKey(primary, secondary)
            ? '2nd choice · the other way to hold three keys'
            : (burden(secondary) !== null && burden(primary) !== null && burden(secondary) < burden(primary)
                ? '2nd choice · the simpler alternative'
                : '2nd choice · where you’d go next')}</p>
        <h2 class="r-headline sm">${esc(secondary.rungLabel)}</h2>
        <p class="r-step-act mono">${esc(secondary.headline)}</p>
        <p class="r-why">${esc(secondary.when)}</p>
        ${(!primaryHasVendors && secondary.vendors) ? vendorsBlock(secondary.vendors) : ''}
        <a class="r-how2" href="${rungAnchor(secondary.rungSlug)}">How ${esc(secondary.rungLabel)} works →</a>
        ${saveControl(secondary.rungSlug, secondary.rungLabel, secondary.rungLabel, 'quiz-secondary')}
      </div>` : ''}
      <div class="r-links">
        <span id="r-next"></span>
        <a class="btn-ghost" href="${rungAnchor(primary.rungSlug)}">Read how ${esc(primary.rungLabel)} works</a>
        <button class="btn-ghost" id="q-edit">← Change my answers</button>
        <button class="btn-ghost" id="q-restart">Start over</button>
      </div>
      <p class="r-foot mono">This is guidance, not financial or legal advice — never act on a step you don't understand. When in doubt, choose the simpler setup.</p>`;

    // Per-setup save with replace-confirm. Only ONE planned setup at a time — saving one
    // reverts the other card's control back to a button (paintSaveStates re-marks all bands).
    // NOTE: the stored source values keep their historical 'quiz-*' names — they live in
    // saved plans, and renaming them would orphan every existing save.
    const saveBands = Array.from(elResult.querySelectorAll('.r-save')).map((el) => ({
      el, rung: el.dataset.rung, label: el.dataset.label, tier: el.dataset.tier, source: el.dataset.source,
      recs: (el.dataset.recs || '').split(',').filter(Boolean),
    }));
    function paintSaveStates() {
      // Match on the BAND, not the rung. Two different recommendations can land on
      // the same rung — `source` is the only thing unique per band.
      const savedSource = plannedSetupSource();
      const savedRung = plannedSetupRung();
      let anySaved = false;
      saveBands.forEach((b) => {
        const isSaved = savedSource ? b.source === savedSource : Boolean(savedRung && b.rung === savedRung);
        if (isSaved) anySaved = true;
        if (isSaved) {
          // SAVING IS NOT THE END OF THE JOURNEY, and the confirmation used to
          // read like it was: a tick, a sentence, and no way forward. The next
          // thing the reader has to do — choose the hardware that fills the plan
          // — lives on /my-plan, and this is the moment they are ready for it.
          // The CTA goes here rather than at the foot of the page because it is
          // the reward for the action they just took, and it appears only once
          // there is a plan to open.
          b.el.innerHTML = `<span class="r-saved">✓ This is your saved plan.</span>
            <a class="btn-save r-open" href="/my-plan">Open your plan <span class="arw">→</span></a>
            <span class="r-save-note">Next: pick the hardware that fills it — and we'll say whether anything you already own clears our bar.</span>`;
        } else {
          b.el.innerHTML = `<button class="btn-save js-save" type="button">＋ Save this setup to my plan</button>
            <span class="r-save-note">One setup at a time — kept only in your browser until you save it. <a href="/my-plan">Your data, not ours</a>.</span>`;
          b.el.querySelector('.js-save').addEventListener('click', async () => {
            const curRung = plannedSetupRung();
            const curLabel = plannedSetupLabel();
            const newKeys = keysForSetup({ rungSlug: b.rung, label: b.label, tier: b.tier });
            // Confirm on ANY change of setup, not just a change of rung — a fork's
            // DIY 2-of-3 and a 3-of-5 step-up share the rung slug 'multisig'.
            const differs = curRung !== b.rung || curLabel !== b.label ||
              (plannedKeysNeeded() != null && plannedKeysNeeded() !== newKeys);
            if (curLabel && curRung && differs) {
              const ok = await confirmDialog({
                title: 'Replace your planned setup?',
                message: `You already have “${curLabel}” saved. Replace it with “${b.label}”?`,
                emphasis: [curLabel, b.label],
                confirmText: 'Replace', cancelText: 'Keep current',
              });
              if (!ok) return;
            }
            const fromFinder = b.source.indexOf('quiz') === 0;
            const ownedSlugs = Array.isArray(answers.ownedDevices) ? answers.ownedDevices : [];
            // The chosen device (the tapped card) leads the saved recommendations,
            // so /my-plan suggests it first — the tap's whole promise.
            let recs = b.recs;
            if (adaptive && b.source === 'quiz-primary' && devs[sel]) {
              const chosen = slugForName(devs[sel].name);
              if (chosen) recs = [chosen, ...recs.filter((s) => s !== chosen)];
            }
            const saved = savePlannedSetup({
              rung: b.rung, label: b.label, tier: b.tier, source: b.source,
              // The saved answers carry the assessment with them — scores,
              // checked prompts, skipped sections — so a resumed visit (and
              // Phase C's checklist emphasis) can rebuild the whole picture.
              answers: fromFinder ? { ...answers, ...assessAnswers() } : null,
              keysNeeded: newKeys,
              owned: fromFinder ? ownedSlugs : undefined,
              ownPrivate: fromFinder ? !!answers.ownPrivate : undefined,
              recommendedDevices: recs,
            });
            if (!saved) {
              b.el.innerHTML = `<span class="r-save-err">Couldn’t save — your browser is blocking storage (private mode, or storage is full).</span>`;
              return;
            }
            paintSaveStates();
          });
        }
      });
      paintNextRow(anySaved);
    }
    // The one loud action on this page, and it depends on whether anything is saved.
    function paintNextRow(saved) {
      const row = document.getElementById('r-next');
      if (!row) return;
      row.innerHTML = saved
        ? `<a class="btn-primary" href="/my-plan">Open your plan →</a>
           <a class="btn-ghost" href="/checklist">Your checklist</a>`
        : '';
      // Deliberately NOT toggling [hidden]: #r-next is display:contents, so an empty
      // one generates no box and no flex gap on its own.
    }
    paintSaveStates();
    if (adaptive) {
      elResult.querySelectorAll('.r-dev').forEach((btn) => {
        btn.addEventListener('click', () => {
          sel = parseInt(btn.getAttribute('data-idx'), 10);
          elResult.querySelectorAll('.r-dev').forEach((b, i) => b.classList.toggle('sel', i === sel));
        });
      });
    }
    // The refill. Re-renders the WHOLE result rather than repainting this block,
    // because everything under it — the bars, the reasons, the caveats, both
    // cards — is derived from the score this changes. A targeted repaint here
    // would leave a card standing above a picture that no longer produced it,
    // which is the partial-repaint failure /my-plan already shipped once.
    elResult.querySelectorAll('[data-worry]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = btn.getAttribute('data-worry');
        if (v) answers.statedWorry = v; else delete answers.statedWorry;
        renderResult();
        // Land them on the block they just used, not at the top of a page that
        // silently rebuilt itself underneath them.
        const back = elResult.querySelector('.r-worry');
        if (back) back.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
    document.getElementById('q-restart').addEventListener('click', () => {
      for (const k in answers) delete answers[k];
      checked.clear(); skipped.clear();
      for (const k in overrides) delete overrides[k];
      estimatedConcerns.clear();
      assessDone = false; assessEstimated = false;
      pos = 0;
      render();
      document.getElementById('finder').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    // Non-destructive path back — answers and the assessment stay put, so each
    // screen renders with your state marked and Continue re-reaches the result.
    document.getElementById('q-edit').addEventListener('click', () => {
      pos = steps().length - 1;
      render();
      document.getElementById('finder').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // ── Cross-site continuity: prefill from anything already saved elsewhere.
  // Reads ONLY explicitly-saved plan data, so "nothing saved unless you save"
  // still holds — and a "welcome back" banner makes the tracking visible.
  //
  // TWO SAVED SHAPES are accepted:
  //  • new (2026-07-31+): answers carry scores / checkedPrompts / skippedSections
  //    → the assessment state rebuilds exactly; by-hand review adjustments are
  //    recovered by diffing the saved scores against the prompt-derived ones.
  //  • old: answers carry a ranked worries[] only → the picture is ESTIMATED via
  //    shimScores and marked as such — walk any section to replace the estimate.
  const CURRENT_VALUES = ['pre', 'single-sig', 'passphrase', 'multisig', 'collaborative'];
  function prefillFromPlan() {
    const saved = loadLocal();
    if (!saved) return { any: false, got: [] };
    const got = [];
    if (Array.isArray(saved.owned) && saved.owned.length) { answers.ownedDevices = saved.owned.slice(); got.push('owned'); }
    if (saved.ownPrivate) answers.ownPrivate = true;
    if (saved.quiz && saved.quiz.answers && typeof saved.quiz.answers === 'object') {
      const a = saved.quiz.answers;
      for (const [k, v] of Object.entries(a)) {
        if (v == null || k === 'scores' || k === 'checkedPrompts' || k === 'skippedSections') continue;
        answers[k] = Array.isArray(v) ? v.slice() : v;
      }
      got.push('answers');
      if (Array.isArray(a.checkedPrompts) || (a.scores && typeof a.scores === 'object')) {
        (Array.isArray(a.checkedPrompts) ? a.checkedPrompts : []).forEach((id) => { if (promptById[id]) checked.add(id); });
        (Array.isArray(a.skippedSections) ? a.skippedSections : []).forEach((c) => { if (CONCERN_KEYS.includes(c)) skipped.add(c); });
        if (a.scores && typeof a.scores === 'object') {
          const base = promptDerived();
          for (const c of CONCERN_KEYS) {
            const v = a.scores[c];
            if (typeof v === 'number' && !skipped.has(c) && Math.abs(v - base[c]) > 1) {
              overrides[c] = Math.min(100, Math.max(0, Math.round(v)));
            }
          }
        }
        assessDone = true;
      } else if (Array.isArray(a.worry) && a.worry.length) {
        const est = shimScores({ ...answers });
        const d = defaultsFor(stakesNow());
        for (const c of CONCERN_KEYS) {
          if (est[c] !== d[c]) { overrides[c] = est[c]; estimatedConcerns.add(c); }
        }
        assessDone = true;
        assessEstimated = true;
      }
    }
    if (answers.current == null && saved.ladder && CURRENT_VALUES.includes(saved.ladder.rung)) {
      answers.current = saved.ladder.rung; got.push('ladder');
    }
    if (saved.custodian) got.push('custodian');
    return { any: got.length > 0, got };
  }
  function allAnswered() {
    return fitQuestions.every((q) => answers[q.id] != null) && assessDone;
  }
  function renderResume(pf) {
    const box = document.getElementById('q-resume');
    if (!pf.any) { box.hidden = true; return; }
    const bits = [];
    if (pf.got.includes('owned')) bits.push('the wallets you own');
    if (pf.got.includes('answers')) bits.push('your earlier answers');
    else if (pf.got.includes('ladder')) bits.push('where you are on the ladder');
    if (pf.got.includes('custodian')) bits.push('your chosen custodian');
    const list = bits.length ? bits.join(' · ') : 'your earlier choices';
    const estLine = assessEstimated
      ? ' Your risk picture is <strong>estimated from your earlier answers</strong> — walk the assessment anytime to sharpen it.'
      : '';
    const heavy = Boolean(plannedSetupRung());
    box.hidden = false;
    box.innerHTML = `
      <div class="q-resume-in">
        <span class="q-resume-k mono">👋 Welcome back — we kept track</span>
        <p>We've prefilled what you told us elsewhere (<strong>${esc(list)}</strong>).${estLine} Walk through and change anything${allAnswered() ? ', or jump straight to your result.' : ' — or just confirm as you go.'}</p>
        <div class="q-resume-acts">
          ${allAnswered() ? `<button class="btn-primary" id="q-jump" type="button">See your result →</button>` : ''}
          <button class="q-fresh" id="q-fresh" type="button">${heavy ? 'Clear my plan and start again' : 'Start fresh'}</button>
        </div>
      </div>`;
    const jump = document.getElementById('q-jump');
    // The jump lands on the result, so the progress line must agree.
    if (jump) jump.addEventListener('click', () => { pos = steps().length; renderResult(); document.getElementById('finder').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    document.getElementById('q-fresh').addEventListener('click', async () => {
      // Re-answering while a stale SETUP sits saved is incoherent — the selection
      // was derived from the answers you are throwing away. Owned hardware
      // survives, because it is a fact about you, not a plan choice.
      if (plannedSetupRung()) {
        const ok = await confirmDialog({
          title: 'Clear your plan and start again?',
          message: 'This clears your saved setup, your checklist progress, and your notes, along with your answers here — the plan was built from the answers you’re about to redo. The hardware you own is kept.',
          confirmText: 'Clear and start again', cancelText: 'Keep my plan', danger: true,
        });
        if (!ok) return;
        clearPlanSelection();
      }
      for (const k in answers) delete answers[k];
      checked.clear(); skipped.clear();
      for (const k in overrides) delete overrides[k];
      estimatedConcerns.clear();
      assessDone = false; assessEstimated = false;
      pos = 0; box.hidden = true;
      render();
    });
  }

  renderResume(prefillFromPlan());
  render();
</script>

