---
import Base from '../layouts/Base.astro';
import { questionCountWordCap } from '../data/quiz.js';
---
<Base
  title="Find your setup — which self-custody setup fits you · BitcoinKeys.guide"
  description={`${questionCountWordCap} plain questions → a self-custody setup that fits you, a personal roadmap from where you are now (built around any wallets you already own), and an ordered checklist. Runs entirely in your browser — we never ask how much Bitcoin you hold.`}
  verified="2026-07-22"
>
  <section class="prose">
    <p class="eyebrow">Find your setup</p>
    <h1>Which self-custody setup <span class="accent">fits you</span>?</h1>
    <p class="lead">{questionCountWordCap} plain questions — then a setup that fits you, a <strong>roadmap from where you are today</strong>, and a checklist to get there. Tell us which wallets you already own and we build the plan around them, so it only ever points you at what you still need. No accounts, no jargon, no "best device" hand-waving.</p>
    <p class="risks-hint">New to this? It helps to first skim <a href="/learn/how-bitcoin-is-lost">how people actually lose Bitcoin</a> — the questions below are really asking which of those risks matters most to you.</p>

    <div class="privacy-note">
      <span class="pn-label mono">🔒 Notice what we don't ask</span>
      <p>We never ask <strong>how much Bitcoin you hold</strong> — no website should, and telling one is bad practice. This asks about the <em>consequences</em>, not amounts. If you already own hardware wallets it'll ask which ones — purely to tailor your roadmap; that step is <strong>optional</strong>, you can choose "rather not say," and it never leaves your browser. Everything here runs <strong>entirely in your browser</strong>: nothing is sent, stored, logged, or put in the web address. Close the tab and it's gone — unless you deliberately <a href="/my-plan">save your plan</a>, which is a separate choice. You pick where: this browser, a file you download, or — only if you choose it — <strong>encrypted to your own Nostr key</strong> on your own relays. <strong>We never see any of them</strong>, and there is no account and no server on our side.</p>
    </div>
  </section>

  <div id="quiz" class="quiz" aria-live="polite">
    <div id="q-resume" hidden></div>
    <div class="quiz-progress mono" id="q-progress"></div>
    <div id="q-card"></div>
    <div id="q-result" hidden></div>
    <noscript><p class="ns">This needs JavaScript. You can reach the same answer by hand: read <a href="/start">Start here</a> for the whole guide in order, then <a href="/learn/ladder">the configuration ladder</a> to place yourself, then work <a href="/checklist">the checklist</a>.</p></noscript>
  </div>
</Base>

<script>
  import { questions, recommend } from '../data/quiz.js';
  import { assessDevices, wallets, keysForSetup, slugForName } from '../data/wallets.js';
  import { rungAnchor } from '../data/ladder.js';
  import { savePlannedSetup, plannedSetupRung, plannedSetupLabel, loadLocal, getOwned, clearPlanSelection, plannedSetupSource } from '../data/plan.js';
  import { mountOwnedPicker } from '../data/owned-picker.js';
  import { confirmDialog } from '../data/ui-dialog.js';

  const answers = {};
  let idx = 0;
  // The owned-wallets step is an interstitial between Q1 and Q2, shown only when the
  // user's current setup implies they hold hardware (Q1 ≠ 'pre'). Not one of the 6.
  let atOwned = false;

  const elProgress = document.getElementById('q-progress');
  const elCard = document.getElementById('q-card');
  const elResult = document.getElementById('q-result');

  function esc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
  // The quiz recommends devices by NAME; map a recommendation's wallet list → slugs
  // (saved as recommendedDevices → suggested in empty slots + annotated on /wallets).
  function recSlugsFrom(list) { return (list || []).map((d) => slugForName(d.name)).filter(Boolean); }

  function renderProgress() {
    const total = questions.length;
    let dots = '';
    for (let i = 0; i < total; i++) {
      const cls = i < idx ? 'done' : (i === idx && !atOwned) ? 'now' : '';
      dots += `<span class="dot ${cls}"></span>`;
    }
    if (atOwned) { elProgress.innerHTML = `<span class="dots">${dots}</span> The wallets you own — optional`; return; }
    elProgress.innerHTML = idx < total
      ? `<span class="dots">${dots}</span> Question ${idx + 1} of ${total}`
      : `<span class="dots">${dots}</span> Your setup`;
  }

  function renderQuestion() {
    if (atOwned) { renderOwnedStep(); return; }
    const q = questions[idx];
    renderProgress();
    elResult.hidden = true;
    elCard.hidden = false;
    if (q.type === 'rank') renderRank(q);
    else renderSingle(q);
  }

  // The interstitial owned-wallets step — its own card between Q1 and Q2, shown only
  // when the current setup implies hardware. Compact make→model picker; supports
  // multiple wallets + a privacy opt-out. Answers ride in memory; saved only if the
  // user later saves their plan (the quiz's "nothing stored unless you save" holds).
  function renderOwnedStep() {
    renderProgress();
    elResult.hidden = true;
    elCard.hidden = false;
    elCard.innerHTML = `<div class="q-card">
      <h2 class="q-title">Which hardware wallet(s) do you own?</h2>
      <p class="q-help">Optional — this lets us build your roadmap around what you already have, so we only suggest what you still need. Add as many as you own.</p>
      <div id="q-own-mount"></div>
      <div class="rank-actions">
        <button class="q-back" id="q-back">← Back</button>
        <button class="btn-primary q-continue" id="q-continue" type="button">Continue →</button>
      </div>
    </div>`;
    mountOwnedPicker(document.getElementById('q-own-mount'), {
      initial: Array.isArray(answers.ownedDevices) ? answers.ownedDevices : [],
      privateInit: !!answers.ownPrivate,
      onChange: (sel, priv) => { answers.ownedDevices = sel; answers.ownPrivate = priv; },
    });
    document.getElementById('q-continue').addEventListener('click', () => {
      atOwned = false; idx = 1;
      if (idx >= questions.length) renderResult(); else renderQuestion();
      elCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    document.getElementById('q-back').addEventListener('click', () => { atOwned = false; idx = 0; renderQuestion(); });
  }

  function shell(q, inner) {
    return `<div class="q-card"><h2 class="q-title">${esc(q.q)}</h2>${q.help ? `<p class="q-help">${esc(q.help)}</p>` : ''}${inner}</div>`;
  }

  function renderSingle(q) {
    const prior = answers[q.id]; // prefilled from a saved plan → highlight it
    const opts = q.options.map((o) => `<button class="q-opt ${o.value === prior ? 'sel' : ''}" data-value="${esc(o.value)}"><span>${esc(o.label)}</span>${o.value === prior ? '<span class="q-prior mono">your answer</span>' : ''}</button>`).join('');
    elCard.innerHTML = shell(q, `<div class="q-opts">${opts}</div>${idx > 0 ? `<button class="q-back" id="q-back">← Back</button>` : ''}`);
    elCard.querySelectorAll('.q-opt').forEach((b) => {
      b.addEventListener('click', () => {
        answers[q.id] = b.getAttribute('data-value');
        // Q1: a hardware setup routes to the owned-wallets step; "nothing yet" skips it.
        if (q.id === 'current' && answers.current !== 'pre') {
          atOwned = true; renderQuestion();
          elCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          return;
        }
        idx++;
        if (idx >= questions.length) renderResult(); else renderQuestion();
        elCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
    wireBack(q, false);
  }

  function renderRank(q) {
    const ranked = Array.isArray(answers[q.id]) ? answers[q.id].slice() : [];
    const draw = () => {
      const opts = q.options.map((o) => {
        const pos = ranked.indexOf(o.value);
        const badge = pos >= 0 ? `<span class="rank-badge">${pos + 1}</span>` : `<span class="rank-badge empty"></span>`;
        return `<button class="q-opt ${pos >= 0 ? 'ranked' : ''}" data-value="${esc(o.value)}">${badge}<span>${esc(o.label)}</span></button>`;
      }).join('');
      elCard.innerHTML = shell(q, `
        <div class="q-opts rank">${opts}</div>
        <div class="rank-actions">
          ${idx > 0 ? `<button class="q-back" id="q-back">← Back</button>` : `<span></span>`}
          <span class="rank-right">
            ${ranked.length ? `<button class="q-reset" id="q-reset">Clear</button>` : ``}
            <button class="btn-primary q-continue" id="q-continue" ${ranked.length ? '' : 'disabled'}>Continue →</button>
          </span>
        </div>`);
      elCard.querySelectorAll('.q-opt').forEach((b) => {
        b.addEventListener('click', () => {
          const v = b.getAttribute('data-value');
          const i = ranked.indexOf(v);
          if (i >= 0) ranked.splice(i, 1); else ranked.push(v);
          draw();
        });
      });
      const cont = document.getElementById('q-continue');
      cont.addEventListener('click', () => {
        if (!ranked.length) return;
        answers[q.id] = ranked.slice();
        idx++;
        if (idx >= questions.length) renderResult(); else renderQuestion();
        elCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      const reset = document.getElementById('q-reset');
      if (reset) reset.addEventListener('click', () => { ranked.length = 0; draw(); });
      wireBack(q, true, ranked);
    };
    draw();
  }

  function wireBack(q, isRank, ranked) {
    const back = document.getElementById('q-back');
    if (!back) return;
    back.addEventListener('click', () => {
      if (isRank) answers[q.id] = ranked.slice();
      // Going back from Q2 returns to the owned step when it was shown (Q1 ≠ 'pre').
      if (idx === 1 && answers.current && answers.current !== 'pre') { atOwned = true; renderQuestion(); return; }
      idx--;
      renderQuestion();
    });
  }

  function walletCard(rec, adaptive, sel) {
    if (rec.wallets && rec.wallets.length) {
      const items = rec.wallets.map((d, i) => {
        const w = wallets.find((x) => x.name === d.name);
        const price = w ? ` <span class="r-price">${esc(w.price)}</span>` : '';
        const body = `<strong>${esc(d.name)}</strong>${price} — ${esc(d.why)}`;
        return adaptive
          ? `<button class="r-dev ${i === sel ? 'sel' : ''}" data-idx="${i}">${body}</button>`
          : `<li>${body}</li>`;
      }).join('');
      const container = adaptive ? `<div class="r-devs adaptive">${items}</div>` : `<ul class="r-devs">${items}</ul>`;
      const label = adaptive ? 'Two devices that fit — tap the one you’ll use; the steps adapt' : 'Two devices that fit — either works, pick by feel';
      return `<div class="r-wallet">
        <span class="r-k mono">${label}</span>
        ${container}
        ${rec.walletNote ? `<p class="r-devnote">${esc(rec.walletNote)}</p>` : ''}
        <a class="r-compare" href="/wallets">Compare all ${wallets.length} devices →</a>
      </div>`;
    }
    // category-only (learning / collaborative — walletNote may hold intentional HTML)
    return rec.walletNote ? `<div class="r-wallet"><span class="r-k mono">Where to start</span><p>${rec.walletNote}</p></div>` : '';
  }

  // The checklist USED to be generated here as well as on /checklist — two
  // generators for one artefact, which is why /checklist read generic beside it.
  // The result page now hands off instead of duplicating: one page produces the
  // checklist, and it is the one called /checklist. (the owner, 2026-07-30.)
  function checklistHandoff() {
    // No link to /checklist here. Until they save, there IS no plan, so the
    // checklist would be the generic everything-list — offering it as "yours" before
    // it is anyone's was getting the sequence backwards. Say what saving gets you;
    // the saved state below then offers the plan first and the checklist after it.
    return `<div class="r-handoff"><span class="r-k mono">Next</span>
      <p>Save this and it becomes your plan. Your checklist is then built from it — only the steps your setup actually needs, in order, with your own hardware named.</p></div>`;
  }

  // ── What you already own, judged against the standard ──────────────────────
  // The result recommended two devices and never mentioned the Ledger the reader
  // had just told us about. Naming it, and saying plainly why we would move, is
  // the difference between advice and a catalogue. Reasoning comes from
  // assessDevices() so it can never disagree with /standard.
  function ownedVerdictHtml() {
    const owned = getOwned().filter(Boolean);
    if (!owned.length) return '';
    const judged = assessDevices(owned);
    const flagged = judged.filter((d) => d.verdict === 'spending' || d.verdict === 'disqualified');
    const clearing = judged.filter((d) => d.verdict === 'cold');
    if (clearing.length) {
      return `<div class="r-owned ok"><span class="r-k mono">You already have what you need</span>
        <p>You told us you have a <strong>${esc(clearing[0].name)}</strong>, and it clears our bar. There is nothing to buy — the steps below are about setting it up properly.</p></div>`;
    }
    if (!flagged.length) return '';
    const d = flagged[0];
    return `<div class="r-owned warn"><span class="r-k mono">About the hardware you have</span>
      <p>You told us you have a <strong>${esc(d.name)}</strong>. ${esc(d.why)}</p>
      <p>You are not obliged to replace it, and your coins are not in danger today. But for money you mean to leave alone for years, we would move to a device from our cold-storage tier — which is why the ones below are what we suggest. <a href="/standard">How we decide →</a></p></div>`;
  }

  function vendorsBlock(vendors) {
    if (!vendors || !vendors.length) return '';
    const rows = vendors.map((v) => `<li>
      <div class="v-head"><a href="${esc(v.url)}" target="_blank" rel="noopener noreferrer">${esc(v.name)} ↗</a> <span class="v-meta mono">${esc(v.kyc)} · ${esc(v.price)}</span></div>
      <div class="v-model mono">${esc(v.model)}</div>
      <p>${esc(v.note)}</p>
      ${v.hw ? `<div class="v-hw"><span class="mono">Hardware:</span> ${esc(v.hw)}</div>` : ''}
    </li>`).join('');
    return `<div class="r-vendors">
      <span class="r-k mono">Bitcoin-only collaborative-custody services</span>
      <p class="v-intro"><strong>What this means:</strong> "collaborative custody" is where a company holds one backup key for you, so losing one of your own keys can't lock you out — a "2-of-3" means any two of the three keys together can recover your coins. ("KYC" is the ID check some services require.) This is a neutral list — <strong>not affiliate links, not ranked "best."</strong> We include only Bitcoin-only services; compare their models and pick the fit. <em>(Casa is left off — it now supports other coins too.)</em></p>
      <ul class="v-list">${rows}</ul>
      <a class="r-how2" href="/collaborative">Compare all ${vendors.length} side by side — KYC, recovery, insurance, fees →</a>
    </div>`;
  }

  // The multisig FORK: two equal paths (DIY self-sovereign vs collaborative), side
  // by side, each with its honest trade-off. Never a funnel. saveControl is passed
  // in so each path gets its own "save to my plan" band.
  function forkHtml(fork, tier, saveControl) {
    const cards = fork.paths.map((p) => {
      const isLead = p.key === fork.lead;
      return `<div class="r-path${isLead ? ' lead' : ''}">
        ${isLead ? `<span class="r-path-tag mono">Leans to your answers</span>` : ''}
        <h3 class="r-path-label">${esc(p.label)}</h3>
        <p class="r-path-essence">${esc(p.essence)}</p>
        <div class="r-tradeoff"><span class="r-k mono">The trade-off</span><p>${esc(p.tradeoff)}</p></div>
        ${p.inheritanceNote ? `<div class="r-inherit"><span class="r-k mono">Self-custodied inheritance</span><p>${esc(p.inheritanceNote)}</p></div>` : ''}
        ${walletCard(p, false, 0)}
        ${checklistHandoff()}
        ${p.vendors ? vendorsBlock(p.vendors) : ''}
        <a class="r-how2" href="${rungAnchor(p.rungSlug)}">Read the ${esc(p.rungLabel)} walkthrough →</a>
        ${saveControl(p.rungSlug, p.label, tier, 'quiz-fork-' + p.key, recSlugsFrom(p.wallets))}
      </div>`;
    }).join('<div class="r-or mono">— or —</div>');
    return `<p class="r-leadnote">${esc(fork.leadNote)}</p><div class="r-paths">${cards}</div>`;
  }

  // "Your journey" — frames the recommendation from where they are now (Q1). Leads the
  // result: a from→to path when there's a climb, or a single "you're here" when they're
  // already at/beyond the fit. Encouraging by design; never implies a downgrade.
  function journeyPath(j) {
    if (j.gap > 0) {
      return `<span class="rj-node rj-now"><span class="rj-k mono">You’re here</span><span class="rj-lbl">${esc(j.curLabel)}</span></span>
        <span class="rj-arrow" aria-hidden="true">→</span>
        <span class="rj-node rj-dest"><span class="rj-k mono">The setup that fits you</span><span class="rj-lbl">${esc(j.targetLabel)}</span></span>`;
    }
    const tag = j.gap === 0 ? 'You’re here — and it fits' : 'You’re here';
    return `<span class="rj-node rj-now ${j.gap === 0 ? 'ok' : 'ahead'}"><span class="rj-k mono">${tag}</span><span class="rj-lbl">${esc(j.curLabel)}</span></span>`;
  }
  function journeyHtml(j) {
    if (!j) return '';
    return `<div class="r-journey j-${esc(j.kind)}">
      <div class="rj-path">${journeyPath(j)}</div>
      <h2 class="rj-headline">${esc(j.headline)}</h2>
      <p class="rj-msg">${esc(j.message)}</p>
    </div>`;
  }

  function renderResult() {
    renderProgress();
    const rb = document.getElementById('q-resume');
    if (rb) rb.hidden = true; // the result speaks for itself
    elCard.hidden = true;
    elResult.hidden = false;
    const { primary, secondary, journey } = recommend(answers);
    const devs = primary.wallets || [];
    const adaptive = devs.some((d) => d.checklist);   // e.g. Bitkey has its own flow
    let sel = 0;
    const primaryHasVendors = primary.vendors && primary.vendors.length;
    const saveControl = (rung, label, tier, source, recSlugs) =>
      `<div class="r-save" data-rung="${esc(rung)}" data-label="${esc(label)}" data-tier="${esc(tier || '')}" data-source="${source}" data-recs="${esc((recSlugs || []).join(','))}"></div>`;

    elResult.innerHTML = `
      ${journeyHtml(journey)}
      <div class="r-card${primary.fork ? ' is-fork' : ''}">
        <p class="r-tier mono">${journey && journey.gap > 0 ? 'Your destination · ' : ''}1st choice · ${esc(primary.tier)}</p>
        <h2 class="r-headline">Your setup: ${esc(primary.headline)}</h2>
        <p class="r-why">${primary.why}</p>
        ${primary.fork ? forkHtml(primary.fork, primary.tier, saveControl) : `
        ${primary.holdback ? `<div class="r-holdback"><span class="r-k mono">Why not more?</span><p>${primary.holdback}</p></div>` : ''}
        ${ownedVerdictHtml()}
        ${walletCard(primary, adaptive, sel)}
        ${checklistHandoff()}
        ${primaryHasVendors ? vendorsBlock(primary.vendors) : ''}
        ${saveControl(primary.rungSlug, primary.headline, primary.tier, 'quiz-primary', recSlugsFrom(primary.wallets))}`}
      </div>
      ${secondary ? `<div class="r-card secondary">
        <p class="r-tier mono muted">2nd choice · where you'd go next</p>
        <h2 class="r-headline sm">${esc(secondary.headline)}</h2>
        <p class="r-why">${esc(secondary.when)}</p>
        ${(!primaryHasVendors && secondary.vendors) ? vendorsBlock(secondary.vendors) : ''}
        <a class="r-how2" href="${rungAnchor(secondary.rungSlug)}">Read the ${esc(secondary.rungLabel)} walkthrough →</a>
        ${saveControl(secondary.rungSlug, secondary.headline, secondary.rungLabel, 'quiz-secondary')}
      </div>` : ''}
      <div class="r-links">
        <a class="btn-primary" href="/checklist">Build it — my step-by-step checklist →</a>
        <a class="btn-ghost" href="${rungAnchor(primary.rungSlug)}">Read the full ${esc(primary.rungLabel)} walkthrough</a>
        <button class="btn-ghost" id="q-restart">Start over</button>
      </div>
      <p class="r-foot mono">Save the setup above and your checklist trims itself to just the steps you need.</p>
      <p class="r-foot mono">This is guidance, not financial or legal advice — never act on a step you don't understand. When in doubt, choose the simpler setup.</p>`;

    // Per-setup save with replace-confirm. Only ONE planned setup at a time — saving one
    // reverts the other card's control back to a button (paintSaveStates re-marks all bands).
    const currentDevice = () => (adaptive && devs[sel]) ? devs[sel].name : (devs[0] && devs[0].name) || null;
    const saveBands = Array.from(elResult.querySelectorAll('.r-save')).map((el) => ({
      el, rung: el.dataset.rung, label: el.dataset.label, tier: el.dataset.tier, source: el.dataset.source,
      recs: (el.dataset.recs || '').split(',').filter(Boolean),
    }));
    function paintSaveStates() {
      // Match on the BAND, not the rung. Two different recommendations can land on
      // the same rung — a "start simple, then graduate" first choice and a
      // "graduate to cold storage" second choice are both single-sig — so rung
      // matching lit up every band that shared one. `source` is unique per band.
      const savedSource = plannedSetupSource();
      const savedRung = plannedSetupRung();
      saveBands.forEach((b) => {
        const isSaved = savedSource ? b.source === savedSource : Boolean(savedRung && b.rung === savedRung);
        if (isSaved) {
          // Plan first, checklist second: the plan is the thing they just made, and
          // the checklist is built FROM it. (the owner, 2026-07-30.)
          b.el.innerHTML = `<span class="r-saved">✓ This is your saved plan.</span> <a class="r-saved-link" href="/my-plan">Open your plan →</a> <a class="r-saved-link" href="/checklist">your checklist is ready too</a>`;
        } else {
          b.el.innerHTML = `<button class="btn-save js-save" type="button">＋ Save this setup to my plan</button>
            <span class="r-save-note">One setup at a time — kept only in your browser until you save it. <a href="/my-plan">your data, not ours</a>.</span>`;
          b.el.querySelector('.js-save').addEventListener('click', async () => {
            const curRung = plannedSetupRung();
            const curLabel = plannedSetupLabel();
            if (curLabel && curRung && curRung !== b.rung) {
              const ok = await confirmDialog({
                title: 'Replace your planned setup?',
                message: `You already have “${curLabel}” saved. Replace it with “${b.label}”?`,
                emphasis: [curLabel, b.label],
                confirmText: 'Replace', cancelText: 'Keep current',
              });
              if (!ok) return;
            }
            const fromQuiz = b.source.indexOf('quiz') === 0;
            const ownedSlugs = Array.isArray(answers.ownedDevices) ? answers.ownedDevices : [];
            savePlannedSetup({
              rung: b.rung, label: b.label, tier: b.tier, source: b.source,
              answers: fromQuiz ? answers : null,
              keysNeeded: keysForSetup({ rungSlug: b.rung, label: b.label, tier: b.tier }),
              owned: fromQuiz ? ownedSlugs : undefined,
              ownPrivate: fromQuiz ? !!answers.ownPrivate : undefined,
              recommendedDevices: b.recs,
            });
            paintSaveStates();
          });
        }
      });
    }
    paintSaveStates();
    // The device buttons used to re-render a per-device checklist in place. That
    // checklist is gone (one generator, on /checklist), so they now only mark the
    // selection — which is all the save band ever read from them.
    if (adaptive) {
      elResult.querySelectorAll('.r-dev').forEach((btn) => {
        btn.addEventListener('click', () => {
          sel = parseInt(btn.getAttribute('data-idx'), 10);
          elResult.querySelectorAll('.r-dev').forEach((b, i) => b.classList.toggle('sel', i === sel));
        });
      });
    }
    document.getElementById('q-restart').addEventListener('click', () => {
      for (const k in answers) delete answers[k];
      idx = 0;
      renderQuestion();
      document.getElementById('quiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // ── Cross-site continuity: prefill from anything already saved elsewhere (wallets
  // owned, a chosen custodian, a prior quiz, the ladder self-locator). Reads ONLY
  // explicitly-saved plan data, so "nothing saved unless you save" still holds — and
  // a "welcome back" banner makes the tracking visible.
  const CURRENT_VALUES = ['pre', 'single-sig', 'passphrase', 'multisig', 'collaborative'];
  function prefillFromPlan() {
    const saved = loadLocal();
    if (!saved) return { any: false, got: [] };
    const got = [];
    if (Array.isArray(saved.owned) && saved.owned.length) { answers.ownedDevices = saved.owned.slice(); got.push('owned'); }
    if (saved.ownPrivate) answers.ownPrivate = true;
    if (saved.quiz && saved.quiz.answers && typeof saved.quiz.answers === 'object') {
      for (const [k, v] of Object.entries(saved.quiz.answers)) { if (v != null) answers[k] = Array.isArray(v) ? v.slice() : v; }
      got.push('answers');
    }
    if (answers.current == null && saved.ladder && CURRENT_VALUES.includes(saved.ladder.rung)) {
      answers.current = saved.ladder.rung; got.push('ladder');
    }
    if (saved.custodian) got.push('custodian');
    return { any: got.length > 0, got };
  }
  function allAnswered() {
    return questions.every((q) => answers[q.id] != null && (q.type !== 'rank' || (Array.isArray(answers[q.id]) && answers[q.id].length)));
  }
  function renderResume(pf) {
    const box = document.getElementById('q-resume');
    if (!pf.any) { box.hidden = true; return; }
    const bits = [];
    if (pf.got.includes('owned')) bits.push('the wallets you own');
    if (pf.got.includes('answers')) bits.push('your earlier answers');
    else if (pf.got.includes('ladder')) bits.push('where you are on the ladder');
    if (pf.got.includes('custodian')) bits.push('your chosen custodian');
    const list = bits.length ? bits.join(' · ') : 'your earlier choices';
    box.hidden = false;
    box.innerHTML = `
      <div class="q-resume-in">
        <span class="q-resume-k mono">👋 Welcome back — we kept track</span>
        <p>We've prefilled what you told us elsewhere (<strong>${esc(list)}</strong>). Walk through and change anything${allAnswered() ? ', or jump straight to your result.' : ' — or just confirm as you go.'}</p>
        <div class="q-resume-acts">
          ${allAnswered() ? `<button class="btn-primary" id="q-jump" type="button">See your result →</button>` : ''}
          <button class="q-fresh" id="q-fresh" type="button">Start fresh</button>
        </div>
      </div>`;
    const jump = document.getElementById('q-jump');
    if (jump) jump.addEventListener('click', () => { renderResult(); document.getElementById('quiz').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    document.getElementById('q-fresh').addEventListener('click', () => {
      for (const k in answers) delete answers[k];
      // Re-answering the questions while a stale SETUP sits saved is incoherent —
      // the selection was derived from the answers you are throwing away. Owned
      // hardware survives, because it is a fact about you, not a plan choice.
      if (plannedSetupRung()) clearPlanSelection();
      idx = 0; atOwned = false; box.hidden = true;
      renderQuestion();
    });
  }

  renderResume(prefillFromPlan());
  renderQuestion();
</script>

